local function checkSecurity()
    -- 1. 检查黑名单（通过玩家名字精准拦截指定人员）
    local blacklistUrl = FIREBASE_URL .. "/Blacklist/" .. LocalPlayer.Name .. ".json"
    local bSuccess, bResponse = pcall(function() 
        return game:HttpGet(blacklistUrl) 
    end)
    
    if bSuccess and bResponse and bResponse ~= "null" and bResponse ~= "" then
        LocalPlayer:Kick("\n[验证失败] 你已被开发者单独列入黑名单，无法使用此脚本！")
        return false
    end

    -- 2. 检查通用卡密状态
    local keyUrl = FIREBASE_URL .. "/Keys/" .. USER_KEY .. "/Status.json"
    local kSuccess, kResponse = pcall(function() 
        return game:HttpGet(keyUrl) 
    end)

    local status = "null"
    if kSuccess and kResponse then
        status = kResponse:gsub('[^a-zA-Z]', '')
    end

    if string.lower(status) ~= "active" then
        LocalPlayer:Kick("\n[验证失败] 通用卡密已失效或被关闭！")
        return false
    end

    return true
end

-- 1. 启动时先安全检查
