-- 角色引用缓存
local cachedCharacter = nil
local cachedHumanoid = nil
local cachedHumanoidRootPart = nil
local cachedAssemblyRootPart = nil

local function refreshCharacterCache(char)
	cachedCharacter = char
	cachedHumanoid = char and char:FindFirstChildOfClass("Humanoid") or nil
	cachedHumanoidRootPart = char and char:FindFirstChild("HumanoidRootPart") or nil
	cachedAssemblyRootPart = cachedHumanoidRootPart and (cachedHumanoidRootPart.AssemblyRootPart or cachedHumanoidRootPart) or nil
end

local function getCachedRootPart()
	local hrp = cachedHumanoidRootPart
	if not hrp or not hrp.Parent then
		if cachedCharacter and cachedCharacter.Parent then
			refreshCharacterCache(cachedCharacter)
		else
			local char = player.Character
			if char then refreshCharacterCache(char) end
		end
	end
	if cachedHumanoidRootPart then
		cachedAssemblyRootPart = cachedHumanoidRootPart.AssemblyRootPart or cachedHumanoidRootPart
	end
	return cachedHumanoidRootPart, cachedAssemblyRootPart, cachedHumanoid
end

