-- ============ 屏障与摇杆防冲突 ============
local function withinAbs(guiObj, pos)
	local abs, size = guiObj.AbsolutePosition, guiObj.AbsoluteSize
	return pos.X >= abs.X and pos.X <= abs.X + size.X and pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y
end

local function isOverAnyButton(pos)
	if withinAbs(camIcon, pos) or withinAbs(gearIcon, pos) or withinAbs(pcIcon, pos) or withinAbs(tpIcon, pos) or withinAbs(magnetIcon, pos) then return true end
	if settingsPanel.Visible and withinAbs(settingsPanel, pos) then return true end
	
	if dpadContainer.Visible then
		for _, btn in pairs(dpadBtns) do
			if withinAbs(btn, pos) then return true end
		end
	end
	
	return false
end

local function findOriginalJoystick()
	local touchGui = playerGui:FindFirstChild("TouchGui"); if not touchGui then return nil end
	for _, name in ipairs({"ThumbstickFrame", "DynamicThumbstickFrame", "Thumbstick", "DynamicThumbstick"}) do
		for _, obj in ipairs(touchGui:GetDescendants()) do if obj:IsA("GuiObject") and obj.Visible and obj.Name == name then return obj end end
	end return nil
end

local function isInsideOriginalJoystick(pos)
	local js = findOriginalJoystick(); if not js then return false end
	local abs, size, pad = js.AbsolutePosition, js.AbsoluteSize, 15
	return pos.X >= abs.X - pad and pos.X <= abs.X + size.X + pad and pos.Y >= abs.Y - pad and pos.Y <= abs.Y + size.Y + pad
end

local function calculateJoystick(pos)
	if joystickReturnTween then joystickReturnTween:Cancel() end
	local center = joystickFrame.AbsolutePosition + joystickFrame.AbsoluteSize / 2
	local radius = joystickFrame.AbsoluteSize.X / 2
	local delta = Vector2.new(pos.X, pos.Y) - center
	if delta.Magnitude > radius then delta = delta.Unit * radius end
	joystickThumb.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
	joystickVector = Vector2.new(delta.X / radius, -delta.Y / radius)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if not freeCamActive then return end
	local inputType = input.UserInputType
	if inputType ~= Enum.UserInputType.Touch and inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.MouseButton2 then return end

	local pos = Vector2.new(input.Position.X, input.Position.Y)

	if joystickFrame.Visible and withinAbs(joystickFrame, pos) then
		joystickTouchId = (inputType == Enum.UserInputType.Touch) and input or "Mouse"
		calculateJoystick(pos)
		return
	end

	if inputType == Enum.UserInputType.Touch and isInsideOriginalJoystick(pos) then
		ignoredControlTouches[input] = true
		return
	end

	if isOverAnyButton(pos) then return end

	if not dragging then
		dragging = true
		dragInput = input
		lastInputPos = pos
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not freeCamActive then return end
	if joystickTouchId then
		if (input.UserInputType == Enum.UserInputType.Touch and input == joystickTouchId) or (input.UserInputType == Enum.UserInputType.MouseMovement and joystickTouchId == "Mouse") then
			calculateJoystick(input.Position); return
		end
	end
	if input.UserInputType == Enum.UserInputType.Touch and ignoredControlTouches[input] then return end
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	if input.UserInputType == Enum.UserInputType.Touch and input ~= dragInput then return end

	local pos = Vector2.new(input.Position.X, input.Position.Y)
	if lastInputPos then
		local delta = pos - lastInputPos
		yaw = yaw - delta.X * sensitivity; pitch = math.clamp(pitch - delta.Y * sensitivity, -maxPitch, maxPitch)
	end
	lastInputPos = pos
end)

UserInputService.InputEnded:Connect(function(input)
	if joystickTouchId then
