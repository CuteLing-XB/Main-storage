			joystickTouchId = nil; joystickVector = Vector2.zero
			joystickReturnTween = TweenService:Create(joystickThumb, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.5, 0)})
			joystickReturnTween:Play()
		end
	end
