pcall(function()
    local InstrumentTab = Window:CreateTab("乐器", "music")
    InstrumentTab:CreateSection("自动演奏")
    InstrumentTab:CreateToggle({
        Name = "自动演奏乐器",
        CurrentValue = false,
        Flag = "AutoRhythm",
        Callback = function(val)
            _G.AutoRhythm = val
            if val then
                task.spawn(function()
                    local keyBinds = {
                        {Enum.KeyCode.Q, Enum.KeyCode.A, Enum.KeyCode.One, Enum.KeyCode.Z, Enum.KeyCode.LeftShift, Enum.KeyCode.Space},
                        {Enum.KeyCode.W, Enum.KeyCode.S, Enum.KeyCode.Two, Enum.KeyCode.X},
                        {Enum.KeyCode.E, Enum.KeyCode.D, Enum.KeyCode.Three, Enum.KeyCode.C},
                        {Enum.KeyCode.R, Enum.KeyCode.F, Enum.KeyCode.Four, Enum.KeyCode.N},
                        {Enum.KeyCode.T, Enum.KeyCode.G, Enum.KeyCode.Five, Enum.KeyCode.M},
                    }
                    local pressed = {}
                    while _G.AutoRhythm do
                        local pg = LocalPlayer:FindFirstChild("PlayerGui")
                        if pg then
                            local gui = pg:FindFirstChild("RhythmServiceUI") or pg:FindFirstChild("RhythmServiceUIBillboard") or pg:FindFirstChild("PianoScreenGui")
                            if gui and gui.Enabled then
                                local lanes = {}
                                for _, v in ipairs(gui:GetDescendants()) do
                                    if v:IsA("GuiObject") and v.Visible and v.Name:lower():find("lane") then
                                        table.insert(lanes, v)
                                    end
                                end
                                table.sort(lanes, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
                                if #lanes >= 2 then
                                    for _, v in ipairs(gui:GetDescendants()) do
                                        if v:IsA("GuiObject") and v.Visible then
                                            local nn = v.Name:lower()
                                            if nn:find("note") or nn:find("circle") then
                                                local closest, minDist = nil, math.huge
                                                for i, lane in ipairs(lanes) do
                                                    local d = math.abs(v.AbsolutePosition.X - lane.AbsolutePosition.X)
                                                    if d < minDist then minDist = d; closest = i end
                                                end
                                                if closest and minDist < 40 then
                                                    local lane = lanes[closest]
                                                    local head = v:FindFirstChild("Head")
                                                    local noteY = head and head.AbsolutePosition.Y or v.AbsolutePosition.Y
                                                    local diff = noteY - lane.AbsolutePosition.Y
                                                    if diff >= -45 and diff <= 20 and not pressed[v] then
                                                        pressed[v] = true
                                                        local hint = lane:FindFirstChild("KeyHint")
                                                        local key = nil
                                                        if hint and hint:IsA("TextLabel") and #hint.Text == 1 then
                                                            pcall(function() key = Enum.KeyCode[hint.Text:upper()] end)
                                                        end
                                                        if not key then key = (keyBinds[closest] or keyBinds[1])[1] end
                                                        if key then
                                                            pcall(function()
                                                                VirtualInput:SendKeyEvent(true, key, false, game)
                                                                task.wait(0.03)
                                                                VirtualInput:SendKeyEvent(false, key, false, game)
                                                            end)
                                                        end
                                                        task.delay(0.1, function() pressed[v] = nil end)
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        task.wait(0.02)
                    end
                end)
            end
        end
    })
end)

local areaPositions = {}
pcall(function()
    local areaHitboxes = workspace:FindFirstChild("AreaHitboxes")
    if areaHitboxes then
        local seen = {}
        for _, v in ipairs(areaHitboxes:GetDescendants()) do
