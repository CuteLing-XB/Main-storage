local function PerformEvasive(target)
    local root = GetCharRoot()
    if not root then return end
    local dir = -root.CFrame.LookVector
    if target then
        local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if tr then
            local diff = root.Position - tr.Position
            if diff.Magnitude > 0.01 then dir = Vector3.new(diff.X, 0, diff.Z).Unit end
        end
    end
    if evasiveModule and evasiveModule.Evasive then
        pcall(function() evasiveModule.Evasive() end)
    else
        ExecuteCombatAction("Evasive")
        local a = root:FindFirstChild("EvasiveDashAttachment")
        if a then a:Destroy() end
        local lv = root:FindFirstChild("EvasiveDashLinearVelocity")
        if lv then lv:Destroy() end
        local att = Instance.new("Attachment", root)
        att.Name = "EvasiveDashAttachment"
        local vel = Instance.new("LinearVelocity", root)
        vel.Name = "EvasiveDashLinearVelocity"
        vel.MaxForce = 100000
        vel.VectorVelocity = dir * 65
        vel.Attachment0 = att
        vel.RelativeTo = Enum.ActuatorRelativeTo.World
        game:GetService("Debris"):AddItem(att, 0.22)
        game:GetService("Debris"):AddItem(vel, 0.22)
    end
end

local function HandleAutoEvasive(attacker, animation)
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local targetChar = attacker.Character
    if not targetChar then return end
    local animId = animation.Animation.AnimationId
    local id = animId:match("(%d+)") or animId
    local animName = mappedAnimations[id] or animation.Animation.Name or ""
    if not IsAttackAnimation(animName) and not knownAttackIds[id] then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end
    if (myRoot.Position - targetRoot.Position).Magnitude > 25 then return end
    local style = attacker:GetAttribute("CombatStyle") or "default"
    local config = GetStyleConfig(style)
    local isM2 = animName:lower():find("m2")
    local delay = isM2 and config.M2HitboxDelay or config.M1HitboxDelay
    task.spawn(function()
        task.wait(math.max(0, delay - 0.15))
        if not animation.IsPlaying then return end
        if not myChar.Parent or not targetChar.Parent then return end
        local r1 = myChar:FindFirstChild("HumanoidRootPart")
        local r2 = targetChar:FindFirstChild("HumanoidRootPart")
        if not r1 or not r2 then return end
        local shouldDodge = _G.AutoEvasive
        if _G.OweHubAutoDodgeRear then
            local dir = (r2.Position - r1.Position).Unit
            local angle = math.deg(math.acos(math.clamp(r1.CFrame.LookVector:Dot(dir), -1, 1)))
            if angle > (_G.OweHubDodgeAngle or 60) and (r1.Position - r2.Position).Magnitude <= (_G.OweHubMaxRangeDodge or 20) then
                shouldDodge = true
            end
        end
        if shouldDodge then PerformEvasive(targetRoot) end
    end)
end

local flyBodyVelocity, flyBodyGyro, flyConn

local function StopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function StartFly()
    StopFly()
    if not _G.FlyEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 9e9
    flyBodyVelocity.Velocity = Vector3.zero
    flyBodyVelocity.Parent = hrp

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 9e9
    flyBodyGyro.CFrame = hrp.CFrame
    flyBodyGyro.Parent = hrp

    hum.PlatformStand = true
    local camera = workspace.CurrentCamera

    flyConn = RunService.RenderStepped:Connect(function()
        local c = LocalPlayer.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h or not _G.FlyEnabled then StopFly() return end
        h.PlatformStand = true

        local dir = Vector3.zero

        if UserInputService.KeyboardEnabled then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
        end

        if UserInputService.TouchEnabled then
            local moveDir = h.MoveDirection
            if moveDir.Magnitude > 0.01 then
                local lookDir = camera.CFrame.LookVector
                local rightDir = camera.CFrame.RightVector
                local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
                local flatRight = Vector3.new(rightDir.X, 0, rightDir.Z)
                if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
                if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end
                dir += flatLook * -moveDir.Z + flatRight * moveDir.X
            end
        end

        if dir.Magnitude > 0 then dir = dir.Unit end
        flyBodyVelocity.Velocity = dir * _G.FlySpeed
        flyBodyGyro.CFrame = camera.CFrame
    end)
    AddConnection(flyConn)
end

local speedConn, oldWalkSpeed, speedHooked = nil, 16, false

local function StopSpeed()
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = oldWalkSpeed end
    end
end

local function HookWalkSpeed()
    if speedHooked then return end
    speedHooked = true
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNewIndex = mt.__newindex
        setreadonly(mt, false)
        mt.__newindex = newcclosure(function(self, key, value)
            if key == "WalkSpeed" and typeof(self) == "Instance" and self:IsA("Humanoid") and self.Parent == LocalPlayer.Character then
                if _G.NoSlowdown then
                    local isSprinting = self.Parent:GetAttribute("Sprinting") == true
                    local sprintSpeed = 22
                    if CombatUtils and CombatUtils.GetSprintSpeedForCharacter then
                        pcall(function() sprintSpeed = CombatUtils.GetSprintSpeedForCharacter(self.Parent) end)
                    end
                    local minSpeed = isSprinting and sprintSpeed or 12
                    if value < minSpeed then value = minSpeed end
                end
                if _G.SpeedEnabled then value = _G.SpeedValue end
            end
            return oldNewIndex(self, key, value)
        end)
        setreadonly(mt, true)
    end)
end

local function StartSpeed()
    StopSpeed()
    if not _G.SpeedEnabled then return end
    pcall(HookWalkSpeed)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = _G.SpeedValue end
    end
    speedConn = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then
            if _G.SpeedEnabled then h.WalkSpeed = _G.SpeedValue else h.WalkSpeed = oldWalkSpeed end
        end
    end)
    AddConnection(speedConn)
end

