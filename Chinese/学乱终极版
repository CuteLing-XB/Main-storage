local function GetCharRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
end

local function GetNearestPlayer(range)
    local root = GetCharRoot()
    if not root then return nil end
    local nearest, nearestDist = nil, range or math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (root.Position - hrp.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = player
                end
            end
        end
    end
    return nearest, nearestDist
end

local mappedAnimations = {}
local knownAttackIds = {}

local function IsAttackAnimation(animName)
    animName = animName:lower()
    local patterns = {"m1","m2","punch","kick","slash","strike","jab","hook","uppercut","slam","sweep","elbow","knee","tackle","throw","swing","attack","hit","dash","startup","ehit"}
    for _, p in ipairs(patterns) do
        if animName:find(p) then return true end
    end
    return false
end

local function TryMapAnimation(anim)
    if not anim or not anim:IsA("Animation") then return end
    if anim.AnimationId == "" then return end
    local id = anim.AnimationId:match("(%d+)") or anim.AnimationId
    if mappedAnimations[id] then return end
    if IsAttackAnimation(anim.Name) then
        mappedAnimations[id] = anim.Name
        knownAttackIds[id] = true
    end
end

local animQueue = {}
local animProcessing = false

local function ProcessAnimQueue()
    if animProcessing then return end
    animProcessing = true
    task.spawn(function()
        while #animQueue > 0 do
            local anim = table.remove(animQueue, 1)
            TryMapAnimation(anim)
            task.wait()
        end
        animProcessing = false
    end)
end

AddConnection(ReplicatedStorage.DescendantAdded:Connect(function(obj)
