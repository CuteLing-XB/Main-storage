local function setMagnetState(state)
	magnetActive = state
	setIconGlow(magnetIcon, magnetActive)
	local char = player.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and magnetActive then
			local rootPart = hrp and (hrp.AssemblyRootPart or hrp) or nil
			if rootPart == hrp then
				hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
				hum.AutoRotate = false
			else
				hum:ChangeState(Enum.HumanoidStateType.Landed)
			end
		end
		if not state and hum then hum.AutoRotate = true; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
		if not state and hrp then
			local rootPart = hrp.AssemblyRootPart or hrp
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end
end

