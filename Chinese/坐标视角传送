-- ============ 屏障区与防冲突判断 ============
local function withinAbs(guiObj, pos)
	local abs, size = guiObj.AbsolutePosition, guiObj.AbsoluteSize
	return pos.X >= abs.X and pos.X <= abs.X + size.X and pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y
end

local function isOverAnyButton(pos)
	-- 如果点到了右侧功能按钮或设置面板，不触发滑屏
	if withinAbs(camIcon, pos) then return true end
	if withinAbs(gearIcon, pos) then return true end
	if withinAbs(pcIcon, pos) then return true end
	if withinAbs(tpIcon, pos) then return true end
	if withinAbs(magnetIcon, pos) then return true end
	if settingsPanel.Visible and withinAbs(settingsPanel, pos) then return true end
	return false
end

-- ============ 摇杆计算与滑屏旋转逻辑 ============
local function calculateJoystick(pos)
	if joystickReturnTween then joystickReturnTween:Cancel() end
	local center = joystickFrame.AbsolutePosition + joystickFrame.AbsoluteSize / 2
	local radius = joystickFrame.AbsoluteSize.X / 2
	local delta = Vector2.new(pos.X, pos.Y) - center
	if delta.Magnitude > radius then delta = delta.Unit * radius end
	joystickThumb.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
	joystickVector = Vector2.new(delta.X / radius, -delta.Y / radius)
end

-- 摇杆专属区域触摸开始
joystickFrame.InputBegan:Connect(function(input)
	if not freeCamActive or pcMode then return end
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not joystickTouchId then
			joystickTouchId = input.UserInputType == Enum.UserInputType.Touch and input or "Mouse"
			calculateJoystick(input.Position)
		end
	end
end)

-- 全局屏幕触摸开始（摇杆以外的空白处用来旋转视角）
UserInputService.InputBegan:Connect(function(input, gp)
	if not freeCamActive then return end
	if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	
	-- 如果按在摇杆区域内，留给摇杆处理，不在空白处触发旋转
	if joystickFrame.Visible and withinAbs(joystickFrame, pos) then return end
	-- 如果按在按钮上，忽略
	if isOverAnyButton(pos) then return end

	if not dragging then
		dragging = true; dragInput = input; lastInputPos = pos
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not freeCamActive then return end
	
	-- 1. 处理摇杆拖动
	if joystickTouchId then
		if (input.UserInputType == Enum.UserInputType.Touch and input == joystickTouchId) or (input.UserInputType == Enum.UserInputType.MouseMovement and joystickTouchId == "Mouse") then
			calculateJoystick(input.Position)
			return
		end
	end
	
	-- 2. 处理摇杆以外区域的滑屏视角旋转
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	if input.UserInputType == Enum.UserInputType.Touch and input ~= dragInput then return end

	local pos = Vector2.new(input.Position.X, input.Position.Y)
	if lastInputPos then
		local delta = pos - lastInputPos
		yaw = yaw - delta.X * sensitivity
		pitch = math.clamp(pitch - delta.Y * sensitivity, -maxPitch, maxPitch)
	end
	lastInputPos = pos
end)

UserInputService.InputEnded:Connect(function(input)
	-- 摇杆松手弹性回中
	if joystickTouchId then
		if (input.UserInputType == Enum.UserInputType.Touch and input == joystickTouchId) or (input.UserInputType == Enum.UserInputType.MouseButton1 and joystickTouchId == "Mouse") then
			joystickTouchId = nil
			joystickVector = Vector2.zero
			
			joystickReturnTween = TweenService:Create(
				joystickThumb, 
				TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), 
				{Position = UDim2.new(0.5, 0, 0.5, 0)}
			)
			joystickReturnTween:Play()
		end
	end
	
	if input == dragInput then dragging = false; dragInput = nil; lastInputPos = nil end
end)

