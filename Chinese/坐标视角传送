-- ========== 防检测模块 ==========
local AntiDetect = {
	MAX_TELEPORT_DISTANCE = 150,
	TELEPORT_TWEEN_TIME = 0.15,
	VELOCITY_CLEAR_INTERVAL = 2,
	VELOCITY_RESIDUAL = 0.01,
	_cameraTypeCached = nil,
	_frameCount = 0,
}

local function safeSetCameraType(camType)
	if AntiDetect._cameraTypeCached ~= camType then
		camera.CameraType = camType
		AntiDetect._cameraTypeCached = camType
	end
end

local function safeTeleport(rootPart, targetCFrame)
	if not rootPart or not rootPart.Parent then return end
	local startPos = rootPart.Position
	local targetPos = targetCFrame.Position
	local distance = (targetPos - startPos).Magnitude
	if distance <= AntiDetect.MAX_TELEPORT_DISTANCE then
		TweenService:Create(rootPart, TweenInfo.new(AntiDetect.TELEPORT_TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = targetCFrame }):Play()
	else
		local segments = math.ceil(distance / AntiDetect.MAX_TELEPORT_DISTANCE)
		local direction = (targetPos - startPos).Unit
		task.spawn(function()
			for i = 1, segments do
				if not rootPart or not rootPart.Parent then break end
				local segmentTarget = i == segments and targetPos or (startPos + direction * (AntiDetect.MAX_TELEPORT_DISTANCE * i))
				local segmentCFrame = CFrame.new(segmentTarget) * targetCFrame.Rotation
				local tween = TweenService:Create(rootPart, TweenInfo.new(AntiDetect.TELEPORT_TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = segmentCFrame })
				tween:Play()
				tween.Completed:Wait()
			end
		end)
	end
end

-- ========== 原版控制禁用模块 ==========
local controls = nil
local function getControls()
	local playerScripts = player:FindFirstChild("PlayerScripts")
	if not playerScripts then return nil end
	local playerModule = playerScripts:FindFirstChild("PlayerModule")
	if not playerModule then return nil end
	local success, module = pcall(require, playerModule)
	if not success or typeof(module) ~= "table" or typeof(module.GetControls) ~= "function" then return nil end
	local ok, ctrl = pcall(module.GetControls, module)
	return (ok and ctrl) and ctrl or nil
end

local function disableCharacterControls()
	if not controls then controls = getControls() end
	if controls and typeof(controls.Disable) == "function" then controls:Disable() end
	ContextActionService:BindActionAtPriority("FreeCamSinkControls", function() return Enum.ContextActionResult.Sink end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right, Enum.KeyCode.Space)
end

local function enableCharacterControls()
	if controls and typeof(controls.Enable) == "function" then controls:Enable() end
	ContextActionService:UnbindAction("FreeCamSinkControls")
end

local function updateCharacterControls()
	if freeCamActive then disableCharacterControls() else enableCharacterControls() end
end

