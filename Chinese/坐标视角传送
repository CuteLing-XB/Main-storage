-- ========== 配置保存与读取模块 ==========
local CONFIG_FILE_NAME = "FreeCamSettings_V4.json"

local function saveConfig()
	local configData = {
		r = currentThemeColor.R,
		g = currentThemeColor.G,
		b = currentThemeColor.B,
		offsetX = offsetX,
		offsetY = offsetY,
		offsetZ = offsetZ
	}
	pcall(function()
		if writefile then
			writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(configData))
		end
	end)
end

local function loadConfig()
	pcall(function()
		if isfile and isfile(CONFIG_FILE_NAME) and readfile then
			local data = readfile(CONFIG_FILE_NAME)
			local decoded = HttpService:JSONDecode(data)
			if decoded then
				if decoded.r and decoded.g and decoded.b then
					currentThemeColor = Color3.new(decoded.r, decoded.g, decoded.b)
				end
				offsetX = decoded.offsetX or 0
				offsetY = decoded.offsetY or 0
				offsetZ = decoded.offsetZ or 0
			end
		end
	end)
end

