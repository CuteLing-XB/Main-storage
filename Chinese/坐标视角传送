-- 顶部拖拽面板逻辑
local draggingUI = false
local dragInputUI, mousePos, frameStartPos
topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingUI = true
		dragInputUI = input
		mousePos = input.Position
		frameStartPos = settingsPanel.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInputUI and draggingUI then
		local delta = input.Position - mousePos
		settingsPanel.Position = UDim2.new(frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X, frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input == dragInputUI then draggingUI = false end
end)

