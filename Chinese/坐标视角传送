-- ============ 核心渲染循环 ============
RunService.RenderStepped:Connect(function(dt)
	if not freeCamActive then return end
	safeSetCameraType(Enum.CameraType.Scriptable)
	
	local rotationCFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local lookVector = rotationCFrame.LookVector
	local rightVector = rotationCFrame.RightVector
	local inputDir = Vector3.zero

	-- PC键盘输入
	if moveDir.Up then inputDir += lookVector end
	if moveDir.Down then inputDir -= lookVector end
	if moveDir.Left then inputDir -= rightVector end
	if moveDir.Right then inputDir += rightVector end
	
	-- 摇杆输入
	if joystickVector.Magnitude > 0.05 then
		inputDir += (lookVector * joystickVector.Y) + (rightVector * joystickVector.X)
	end

	if inputDir.Magnitude > 0 then inputDir = inputDir.Unit end

	local targetVelocity = inputDir * speed
	local rampAlpha = math.clamp(smoothness * dt * 60, 0, 1)
	velocity = velocity:Lerp(targetVelocity, rampAlpha)
	camPos += velocity * dt
	camera.CFrame = CFrame.new(camPos) * rotationCFrame

	AntiDetect._frameCount += 1

	-- 完美吸附逻辑
	if magnetActive then
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local rootPart = hrp.AssemblyRootPart or hrp
				rootPart.CFrame = camera.CFrame * CFrame.new(offsetX, offsetY, offsetZ)

				if AntiDetect._frameCount % AntiDetect.VELOCITY_CLEAR_INTERVAL == 0 then
					local res = AntiDetect.VELOCITY_RESIDUAL
					rootPart.AssemblyLinearVelocity = Vector3.new(res, res, res)
					rootPart.AssemblyAngularVelocity = Vector3.new(res, res, res)
				end

				if rootPart == hrp then
					local hum2 = char:FindFirstChildOfClass("Humanoid")
					if hum2 and hum2:GetState() ~= Enum.HumanoidStateType.RunningNoPhysics then
						hum2:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
					end
				end
			end
		end
	end
end)

