function stopDriving()
    isDriving = false
    carGui.Enabled = false
    if carBV then carBV:Destroy() carBV = nil end
    if carBG then carBG:Destroy() carBG = nil end
    frozenCarOffsets = {}
    if currentCarPart then currentCarPart = nil end
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hum = LP.Character:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false; hum.Sit = false end
        LP.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
