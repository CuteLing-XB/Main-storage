                hl.Parent = workspace.CurrentCamera 
                hl.FillTransparency = 0.4
                hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                highlights[p] = hl
            end
        else
            if highlights[p] then 
                highlights[p]:Destroy() 
                highlights[p] = nil 
            end
        end
    end
    for part, hl in pairs(highlights) do
        if hl then
            hl.Parent = workspace.CurrentCamera
        end
    end
end)
