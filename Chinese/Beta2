        if moveState.side ~= 0 then carBG.CFrame = carBG.CFrame * CFrame.Angles(0, math.rad(moveState.side * turnSpeed), 0) end
        local fwd = carBG.CFrame.LookVector * (moveState.forward * speed)
        local up = Vector3.new(0, moveState.up * (speed * 0.8), 0)
        carBV.Velocity = fwd + up
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            local root = LP.Character.HumanoidRootPart
            local targetCFrame = currentCarPart.CFrame * CFrame.new(0, currentCarPart.Size.Y/2 + 3, 0)
            root.CFrame = targetCFrame; root.Velocity = Vector3.new(0,0,0); root.RotVelocity = Vector3.new(0,0,0)
        end
        pcall(function() currentCarPart:SetNetworkOwner(LP) end)
        for p, offset in pairs(frozenCarOffsets) do
            if p and p.Parent then
                local targetCF = currentCarPart.CFrame * offset
                local bp = p:FindFirstChildOfClass("BodyPosition")
                local bg = p:FindFirstChildOfClass("BodyGyro")
                if bp and bg then bp.Position = targetCF.Position; bg.CFrame = targetCF else pcall(function() p.CFrame = targetCF end) end
            else
                frozenCarOffsets[p] = nil
            end
        end
    elseif isDriving and (not currentCarPart or not currentCarPart.Parent) then
