local function makeDraggable(frame, handle)
    local dragging = false
    local currentInput = nil
    local dragStart = Vector2.new(0, 0)
    local startPos = UDim2.new(0, 0, 0, 0)

    handle.InputBegan:Connect(function(input)
        if UIConfig.IsLocked and frame == MainFrame then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then return end
            dragging = true
            currentInput = input
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == currentInput then
            local delta = input.Position - dragStart
            if not (UIConfig.IsLocked and frame == MainFrame) then
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == currentInput then dragging = false currentInput = nil end
    end)
end

local restoreUI

local function setupNekoIcon(btn)
    local dragging = false
    local currentInput = nil
    local dragStart = Vector2.new(0, 0)
    local startPos = UDim2.new(0, 0, 0, 0)
    local hasDragged = false

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not btn.Visible or dragging then return end
            dragging = true
            hasDragged = false
            currentInput = input
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == currentInput and btn.Visible then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then hasDragged = true end
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == currentInput then
            dragging = false
            currentInput = nil
            if not hasDragged and btn.Visible then if restoreUI then restoreUI() end end
        end
    end)
end

