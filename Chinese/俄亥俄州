-- Hook Metamethod 核心防护
local OriginalNamecall
OriginalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if checkcaller() then return OriginalNamecall(self, ...) end

    if Remotes and method == "FireServer" and self == Remotes.meleeItemHit then
        if tostring(args[1]) == "player" and args[2] and not table.find(Whitelist, args[2].hitPlayerId) then
            if Options.OnePunch and Options.OnePunch.Value then
                if not string.find(tostring(args[2].meleeType), "swing") then
                    args[2].meleeType = "meleemegapunch"
                end
            end
            if Options.OneSwing and Options.OneSwing.Value then
                if string.find(tostring(args[2].meleeType), "swing") then
                    args[2].meleeType = "meleemegaswing"
                end
            end
            return OriginalNamecall(self, unpack(args))
        end
    end

    if Remotes and Options.Hitbox and Options.Hitbox.Value and method == "FireServer" and self == Remotes.projectileHit then
        if args[2] and args[2].hitPart then
            local hitPart = args[2].hitPart
            local model = hitPart:FindFirstAncestorOfClass("Model")
            local hitPlayer = Players:GetPlayerFromCharacter(model)
            if model and hitPlayer and model:FindFirstChild("Hitbox") and model.Hitbox:FindFirstChild("Head_Hitbox") then
                args[2].hitPart = model.Hitbox["Head_Hitbox"]
                args[2].hitPlayerId = hitPlayer.UserId
                args[2].hitSize = args[2].hitPart.Size
                args[2].pos = args[2].hitPart.Position
            end
        end
        return OriginalNamecall(self, unpack(args))
    end

    return OriginalNamecall(self, ...)
end)

