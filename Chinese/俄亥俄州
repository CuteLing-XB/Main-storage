-- Frame 渲染主循环
RunService.RenderStepped:Connect(function()
    if not HumanoidRootPart or not HumanoidRootPart.Parent then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if not char then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp then continue end
            if char:FindFirstChild("ForceField") or table.find(Whitelist, player.UserId) then continue end

            if Options.KillAura and Options.KillAura.Value and Remotes then
                if (HumanoidRootPart.Position - hrp.Position).Magnitude < 35 and hum.Health > 5 then
                    Remotes.FireServer("meleeItemHit", "player", { meleeType = "meleemegapunch", hitPlayerId = player.UserId })
                end
            end

            if Options.StompAura and Options.StompAura.Value and Remotes and ClientReplicator then
                pcall(function()
                    if ClientReplicator.Get(player, "knocked") and (HumanoidRootPart.Position - hrp.Position).Magnitude < 30 then
                        Remotes.FireServer("stomp", player)
                    end
                end)
            end

            if Options.GrabAura and Options.GrabAura.Value and Remotes and ClientReplicator then
                pcall(function()
                    if ClientReplicator.Get(player, "knocked") and (HumanoidRootPart.Position - hrp.Position).Magnitude < 35 then
                        Remotes.FireServer("grabPlayer", player)
                    end
                end)
            end
        end
    end

    if Options.Godmode and Options.Godmode.Value and ClientReplicator then
        pcall(function()
            if ClientReplicator.Get(LocalPlayer, "knocked") then ClientReplicator.Set(LocalPlayer, "knocked", false) end
        end)
    end

    if Options.WalkSpeed and Options.WalkSpeed.IsMoved and Humanoid then Humanoid.WalkSpeed = Options.WalkSpeed.Value end
    if Options.JumpPower and Options.JumpPower.IsMoved and Humanoid then Humanoid.JumpPower = Options.JumpPower.Value Humanoid.UseJumpPower = true end

    if Options.Noclip and Options.Noclip.Value and Character then
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if Options.Fullbright and Options.Fullbright.Value then Lighting.Ambient = Color3.new(1, 1, 1) else Lighting.Ambient = Color3.new(0, 0, 0) end
end)

