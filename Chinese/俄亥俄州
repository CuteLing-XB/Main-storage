local function ApplyTheme(themeName)
    local target = Themes[themeName]
    if not target then return end
    UIConfig.CurrentTheme = themeName
    for _, f in ipairs(Themeables.MainFrames) do TweenService:Create(f, TweenInfo.new(0.3), {BackgroundColor3 = target.MainBg}):Play() end
    for _, h in ipairs(Themeables.Headers) do TweenService:Create(h, TweenInfo.new(0.3), {BackgroundColor3 = target.HeaderBg}):Play() end
    for _, c in ipairs(Themeables.Cards) do TweenService:Create(c, TweenInfo.new(0.3), {BackgroundColor3 = target.CardBg}):Play() end
    for _, a in ipairs(Themeables.Accents) do
        if a:IsA("UIStroke") then TweenService:Create(a, TweenInfo.new(0.3), {Color = target.Accent}):Play()
        else TweenService:Create(a, TweenInfo.new(0.3), {BackgroundColor3 = target.Accent, TextColor3 = target.Accent}):Play() end
    end
    for _, t in ipairs(Themeables.Texts) do TweenService:Create(t, TweenInfo.new(0.3), {TextColor3 = target.Text}):Play() end
    for _, st in ipairs(Themeables.SubTexts) do TweenService:Create(st, TweenInfo.new(0.3), {TextColor3 = target.SubText}):Play() end
    if not UIConfig.RainbowBorder then
        MainStroke.Color = target.Accent
        NekoStroke.Color = target.Accent
    end
end

