local function fetchValidImage(url)
    local body = nil
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local success, response = pcall(function() return req({Url = url, Method = "GET"}) end)
        if success and response and response.Success and response.Body then body = response.Body end
    elseif game.HttpGet then
        pcall(function() body = game:HttpGet(url) end)
    end
    if body and #body > 10240 then return body end
    return nil
end

local function getOrDownloadAsset(url, fileName)
    if writefile and readfile and getcustomasset then
        if isfile and isfile(fileName) then
            pcall(function() if readfile(fileName) and #readfile(fileName) < 10240 then delfile(fileName) end end)
        end
        if not (isfile and isfile(fileName)) then
            local validBytes = fetchValidImage(url)
            if validBytes then pcall(function() writefile(fileName, validBytes) end) end
        end
        if isfile and isfile(fileName) then
            local success, asset = pcall(function() return getcustomasset(fileName) end)
            if success and asset then return asset end
        end
    end
    return FALLBACK_ASSET
end

