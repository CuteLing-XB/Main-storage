local function setIconGlow(button, enabled)
	local stroke = button:FindFirstChild("ActiveGlow")

	if not stroke then
		return
	end

	local goal

	if enabled then
		goal = {
			Color = Color3.fromRGB(190, 90, 255),
			Transparency = 0.05,
			Thickness = 2
		}
	else
		goal = {
			Color = Color3.fromRGB(255, 255, 255),
			Transparency = 0.6,
			Thickness = 1
		}
	end

	TweenService:Create(
		stroke,
		TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		goal
	):Play()
end

