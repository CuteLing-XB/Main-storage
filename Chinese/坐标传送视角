local function getControls()
	local playerScripts =
		player:FindFirstChild("PlayerScripts")

	if not playerScripts then
		return nil
	end

	local playerModule =
		playerScripts:FindFirstChild("PlayerModule")

	if not playerModule then
		return nil
	end

	local success, module =
		pcall(require, playerModule)

	if
		not success
		or typeof(module) ~= "table"
		or typeof(module.GetControls) ~= "function"
	then
		return nil
	end

	local ok, ctrl =
		pcall(module.GetControls, module)

	if ok and ctrl then
		return ctrl
	end

	return nil
end

local function disableCharacterControls()
	if not controls then
		controls = getControls()
	end

	if
		controls
		and typeof(controls.Disable) == "function"
	then
		controls:Disable()
	end
	
	-- 绑定 ContextActionService 阻止 WASD 操控车辆
	ContextActionService:BindActionAtPriority(
		"FreeCamSinkControls",
		function() return Enum.ContextActionResult.Sink end,
		false,
		Enum.ContextActionPriority.High.Value + 100,
		Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
		Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right, Enum.KeyCode.Space
	)
end

local function enableCharacterControls()
	if
		controls
		and typeof(controls.Enable) == "function"
	then
		controls:Enable()
	end
	
	-- 解除阻止
	ContextActionService:UnbindAction("FreeCamSinkControls")
end

local function updateCharacterControls()
	if freeCamActive and pcMode then
		disableCharacterControls()
	else
		enableCharacterControls()
	end
end

