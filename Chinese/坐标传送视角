local function setMagnetState(state)
	magnetActive = state; setIconGlow(magnetIcon, magnetActive)
	local hrp, rootPart, hum = getCachedRootPart()
	if hum and magnetActive then
		if rootPart == hrp then hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics); hum.AutoRotate = false else hum:ChangeState(Enum.HumanoidStateType.Landed) end
	end
	if not state and hum then hum.AutoRotate = true; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
	if not state and rootPart then
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end
end

local function enterFreeCam()
	if isTransitioningCam then return end
	-- 在切换到 Scriptable 之前完整保存当前游戏镜头。退出时只认这一份快照，避免反复开关产生角度下抬/位置漂移。
	savedGameCFrame = camera.CFrame
	savedGameFOV = camera.FieldOfView

	freeCamActive = true
	updateControlVisibility()
	updateCharacterControls()

	local cf = savedGameCFrame
	camPos = cf.Position
	velocity = Vector3.zero
	local look = cf.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))
	fovCurrent = math.clamp(camera.FieldOfView, FOV_MIN, FOV_MAX)

	safeSetCameraType(Enum.CameraType.Scriptable)
	camera.CameraSubject = nil
	camera.CFrame = cf
	setIconGlow(camIcon, true)
end

local function exitFreeCam()
	if isTransitioningCam then return end
	isTransitioningCam = true

	-- 立即停止自由摄像机输入/UI，之后的过渡不会再被自由摄像机逻辑覆盖。
	freeCamActive = false
	updateControlVisibility()

	if settingsOpen then toggleSettingsPanel(false) end
	dragging = false
	dragInput = nil
	lastInputPos = nil
	joystickTouchId = nil
	joystickVector = Vector2.zero
	joystickThumb.Position = UDim2.new(0.5, 0, 0.5, 0)
	if joystickReturnTween then joystickReturnTween:Cancel() end
	table.clear(ignoredControlTouches)
	for k in pairs(moveDir) do moveDir[k] = false end
	if magnetActive then setMagnetState(false) end
	setIconGlow(camIcon, false)
	setIconGlow(pcIcon, false)
	setIconGlow(tpIcon, false)
	pcMode = false
	updateCharacterControls()

	-- 退出目标严格使用“点击开启摄像机时”的镜头快照，不再通过人物 Head + LookVector 二次计算。
	local targetCFrame = savedGameCFrame or camera.CFrame
	local targetFOV = savedGameFOV or 70
	local startCFrame = camera.CFrame
	local startFOV = camera.FieldOfView
	local duration = 0.42
	local elapsed = 0

	-- 过渡期间保持 Scriptable，防止 Roblox 默认摄像机抢写 CFrame。
	safeSetCameraType(Enum.CameraType.Scriptable)
	camera.CameraSubject = nil

	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local easedAlpha = 1 - math.pow(1 - alpha, 3)
		camera.CFrame = startCFrame:Lerp(targetCFrame, easedAlpha)
		camera.FieldOfView = startFOV + (targetFOV - startFOV) * easedAlpha
		if alpha >= 1 then
			camera.CFrame = targetCFrame
			camera.FieldOfView = targetFOV
			connection:Disconnect()
		end
	end)

	task.wait(duration + 0.02)
	if connection and connection.Connected then connection:Disconnect() end

	-- 最后一帧再次写入快照，然后恢复默认摄像机。
	camera.CFrame = targetCFrame
	camera.FieldOfView = targetFOV
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	safeSetCameraType(Enum.CameraType.Custom)
	if hum then camera.CameraSubject = hum end

	-- 清理本次快照，下一次开启会重新准确记录。
	savedGameCFrame = nil
	savedGameFOV = nil
	isTransitioningCam = false
end

