local settingsTweenToken = 0
local function toggleSettingsPanel(forceState)
	if forceState ~= nil then settingsOpen = forceState else settingsOpen = not settingsOpen end
	settingsTweenToken += 1
	local token = settingsTweenToken
	setIconGlow(gearIcon, settingsOpen)
	ddList.Visible = false
	
	if settingsOpen then
		settingsPanel.Visible = true
		settingsPanel.Position = settingsHiddenRightPosition
		TweenService:Create(settingsPanel, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = settingsHomePosition}):Play()
	else
		local closeTween = TweenService:Create(settingsPanel, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = settingsHiddenBottomPosition})
		closeTween:Play()
		closeTween.Completed:Once(function()
			if token == settingsTweenToken and not settingsOpen then
				settingsPanel.Visible = false
				settingsPanel.Position = settingsHiddenRightPosition
			end
		end)
