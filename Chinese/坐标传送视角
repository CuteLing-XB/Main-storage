local function setMagnetState(state)
	magnetActive = state
	setIconGlow(magnetIcon, magnetActive)
	
	local char = player.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		
		if hum and magnetActive then
			-- 强行将角色状态设为落地，避免出现空中乱挥舞手脚的“坠落”动画，让人物乖乖站好
			hum:ChangeState(Enum.HumanoidStateType.Landed)
		end
		
		-- 每次关闭吸附时，重置装配体物理速度防卡顿
		if not state and hrp then
			local rootPart = hrp.AssemblyRootPart or hrp
			rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end
end

local function enterFreeCam()
	freeCamActive = true

	updateControls()
	updateCharacterControls()

	local cf = camera.CFrame
	camPos = cf.Position
	velocity = Vector3.zero

	local look = cf.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CameraSubject = nil

	setIconGlow(camIcon, true)
end

local function exitFreeCam()
	freeCamActive = false

	updateControls()
	enableCharacterControls()

	settingsOpen = false
	settingsPanel.Visible = false

	dragging = false
	dragInput = nil
	lastInputPos = nil

	table.clear(ignoredControlTouches)

	for k in pairs(moveDir) do
		moveDir[k] = false
	end

	camera.CameraType = Enum.CameraType.Custom

	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			camera.CameraSubject = hum
		end
	end

	-- 退出自由视角时，必须强制关闭吸附功能并恢复重力
	if magnetActive then
		setMagnetState(false)
	end

	setIconGlow(camIcon, false)
	setIconGlow(gearIcon, false)
	setIconGlow(pcIcon, false)
	setIconGlow(tpIcon, false)
	
	pcMode = false
	updateControls()
end

camIcon.MouseButton1Click:Connect(function()
	if freeCamActive then
		exitFreeCam()
	else
		enterFreeCam()
	end
end)

pcIcon.MouseButton1Click:Connect(function()
	if not freeCamActive then return end
	pcMode = not pcMode

	moveDir.Up = false; moveDir.Down = false; moveDir.Left = false; moveDir.Right = false

	updateControls()
	updateCharacterControls()
	setIconGlow(pcIcon, pcMode)
end)

tpIcon.MouseButton1Click:Connect(function()
	if not freeCamActive then return end
	local char = player.Character
	if char then
		local newCFrame = CFrame.new(camPos) * CFrame.Angles(0, yaw, 0)
		local hrp = char:FindFirstChild("HumanoidRootPart")
		
		-- 如果传送时有载具(装配体)，则优先传送载具
		if hrp then
			local rootPart = hrp.AssemblyRootPart or hrp
			if rootPart ~= hrp then
				rootPart.CFrame = newCFrame
			else
				char:PivotTo(newCFrame)
			end
		else
			char:PivotTo(newCFrame)
		end
		
		setIconGlow(tpIcon, true)
		task.delay(0.2, function()
			if freeCamActive then setIconGlow(tpIcon, false) end
		end)
	end
end)

