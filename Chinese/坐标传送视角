local function commitSpeed(newSpeed)
	speed = math.max(SPEED_MIN, math.floor(newSpeed + 0.5))
	speedValueLabel.Text = tostring(speed)
end

local function commitSmoothness(newPercent)
	local clampedPercent = math.clamp(math.floor(newPercent + 0.5), SMOOTH_MIN * 100, SMOOTH_MAX * 100)
	smoothness = clampedPercent / 100
	smoothValueLabel.Text = tostring(clampedPercent) .. "%"
end

local function commitSensitivity(newPercent)
	local clampedPercent = math.clamp(math.floor(newPercent + 0.5), SENSITIVITY_MIN_PERCENT, SENSITIVITY_MAX_PERCENT)
	sensitivity = SENSITIVITY_BASE * (clampedPercent / 100)
	sensitivityValueLabel.Text = tostring(clampedPercent) .. "%"
end

local function commitOffsetX(newVal)
	offsetX = math.floor(newVal * 10) / 10
	xValueLabel.Text = tostring(offsetX)
end

local function commitOffsetY(newVal)
	offsetY = math.floor(newVal * 10) / 10
	yValueLabel.Text = tostring(offsetY)
end

local function commitOffsetZ(newVal)
	offsetZ = math.floor(newVal * 10) / 10
	zValueLabel.Text = tostring(offsetZ)
end

