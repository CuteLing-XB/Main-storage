local function withinAbs(guiObj, pos)
	local abs = guiObj.AbsolutePosition
	local size = guiObj.AbsoluteSize
	return pos.X >= abs.X and pos.X <= abs.X + size.X and pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y
end

local function isOverAnyButton(pos)
	for _, b in ipairs(arrowButtons) do
		if b.Visible and withinAbs(b, pos) then return true end
	end
	if withinAbs(camIcon, pos) then return true end
	if withinAbs(gearIcon, pos) then return true end
	if withinAbs(pcIcon, pos) then return true end
	if withinAbs(tpIcon, pos) then return true end
	if withinAbs(magnetIcon, pos) then return true end
	if settingsPanel.Visible and withinAbs(settingsPanel, pos) then return true end

	return false
end

local function findJoystickGuiObject()
	local touchGui = playerGui:FindFirstChild("TouchGui")
	if not touchGui then return nil end

	local preferredNames = {"ThumbstickFrame", "DynamicThumbstickFrame", "Thumbstick", "DynamicThumbstick"}
	for _, wantedName in ipairs(preferredNames) do
		for _, obj in ipairs(touchGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Visible and obj.Name == wantedName then
				return obj
			end
		end
	end

	for _, obj in ipairs(touchGui:GetDescendants()) do
		if obj:IsA("GuiObject") and obj.Visible then
			local lowerName = string.lower(obj.Name)
			if lowerName:find("thumbstick") or lowerName:find("joystick") then
				return obj
			end
		end
	end
	return nil
end

local function isInsideJoystick(pos)
	local joystick = findJoystickGuiObject()
	if not joystick then return false end
	local abs = joystick.AbsolutePosition
	local size = joystick.AbsoluteSize
	local padding = 6
	return pos.X >= abs.X - padding and pos.X <= abs.X + size.X + padding and pos.Y >= abs.Y - padding and pos.Y <= abs.Y + size.Y + padding
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not freeCamActive then return end
	if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end

	local pos = Vector2.new(input.Position.X, input.Position.Y)

	if input.UserInputType == Enum.UserInputType.Touch and isInsideJoystick(pos) then
		ignoredControlTouches[input] = true
		return
	end
	if isOverAnyButton(pos) then return end

	if not dragging then
		dragging = true
		dragInput = input
		lastInputPos = pos
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not freeCamActive then return end
	if input.UserInputType == Enum.UserInputType.Touch and ignoredControlTouches[input] then return end
	if not dragging then return end

	local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouch = input.UserInputType == Enum.UserInputType.Touch
	if not (isMouse or isTouch) then return end
	if isTouch and input ~= dragInput then return end

	local pos = Vector2.new(input.Position.X, input.Position.Y)

	if lastInputPos then
		local delta = pos - lastInputPos
		yaw = yaw - delta.X * sensitivity
		pitch = math.clamp(pitch - delta.Y * sensitivity, -maxPitch, maxPitch)
	end
	lastInputPos = pos
end)

UserInputService.InputEnded:Connect(function(input)
	if ignoredControlTouches[input] then
		ignoredControlTouches[input] = nil
		return
	end
	if input == dragInput then
		dragging = false
		dragInput = nil
		lastInputPos = nil
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not freeCamActive or not pcMode then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	local isMoveKey = (input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.D)
	
	if gameProcessed and not isMoveKey then return end

	if input.KeyCode == Enum.KeyCode.W then moveDir.Up = true
	elseif input.KeyCode == Enum.KeyCode.S then moveDir.Down = true
	elseif input.KeyCode == Enum.KeyCode.A then moveDir.Left = true
	elseif input.KeyCode == Enum.KeyCode.D then moveDir.Right = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	if input.KeyCode == Enum.KeyCode.W then moveDir.Up = false
	elseif input.KeyCode == Enum.KeyCode.S then moveDir.Down = false
	elseif input.KeyCode == Enum.KeyCode.A then moveDir.Left = false
	elseif input.KeyCode == Enum.KeyCode.D then moveDir.Right = false
	end
end)

-- 统一在 RenderStepped 中渲染摄像机和吸附人物，确保 0 延迟，0 抽搐
RunService.RenderStepped:Connect(function(dt)
	if not freeCamActive then return end

	camera.CameraType = Enum.CameraType.Scriptable
	local rotationCFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local lookVector = rotationCFrame.LookVector
	local rightVector = rotationCFrame.RightVector
	local inputDir = Vector3.zero

	if moveDir.Up then inputDir += lookVector end
	if moveDir.Down then inputDir -= lookVector end
	if moveDir.Left then inputDir -= rightVector end
	if moveDir.Right then inputDir += rightVector end
	if inputDir.Magnitude > 0 then inputDir = inputDir.Unit end

	local targetVelocity = inputDir * speed
	local rampAlpha = math.clamp(smoothness * dt * 60, 0, 1)

	velocity = velocity:Lerp(targetVelocity, rampAlpha)
	camPos += velocity * dt
	camera.CFrame = CFrame.new(camPos) * rotationCFrame
	
	-- 【修复核心】丝滑吸附代码：不冻结实体，直接强制跟随，并清空所有碰撞/重力动量
	if magnetActive then
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				-- 获取装配体：如果是坐车，就会连带着车一块获取到
				local rootPart = hrp.AssemblyRootPart or hrp
				
				-- 将偏移量直接应用到人物/车
				rootPart.CFrame = camera.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
				
				-- 实时清空物理速度，完美抵消重力和碰撞，真正成为“跟你飞行的实体”
				rootPart.AssemblyLinearVelocity = Vector3.zero
				rootPart.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	if freeCamActive then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CameraSubject = nil
	end
	
	-- 角色重生后重新检查并应用磁铁状态
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart")
		if magnetActive then
			setMagnetState(true)
		end
	end)
end)

