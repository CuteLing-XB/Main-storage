-- ========== 配置保存与读取模块 ==========
local CONFIG_FILE_NAME = "XQVIP888_Settings.json"

local function saveConfig()
	local configData = {
		r = currentThemeColor.R, g = currentThemeColor.G, b = currentThemeColor.B,
		offsetX = offsetX, offsetY = offsetY, offsetZ = offsetZ,
		controlStyle = controlStyle, joystickSize = joystickSize, joystickShape = joystickShape, joystickTransparency = joystickTransparency,
		playerTeleportMode = playerTeleportMode,
		fovTarget = fovTarget,
		joystickOffsetX = joystickOffsetX, joystickOffsetY = joystickOffsetY,
		dpadOffsetX = dpadOffsetX, dpadOffsetY = dpadOffsetY,
		dpadSize = dpadSize, dpadGap = dpadGap, arrowOffset = arrowOffset
	}
	pcall(function() if writefile then writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(configData)) end end)
end

local function loadConfig()
	pcall(function()
		if isfile and isfile(CONFIG_FILE_NAME) and readfile then
			local data = readfile(CONFIG_FILE_NAME)
			local decoded = HttpService:JSONDecode(data)
			if decoded then
				if decoded.r then currentThemeColor = Color3.new(decoded.r, decoded.g, decoded.b) end
				offsetX = decoded.offsetX or 0; offsetY = decoded.offsetY or 0; offsetZ = decoded.offsetZ or 0
				controlStyle = decoded.controlStyle or 1
				fovTarget = math.clamp(tonumber(decoded.fovTarget) or FOV_DEFAULT, FOV_MIN, FOV_MAX)
				fovCurrent = fovTarget
				joystickSize = decoded.joystickSize or 160
				joystickShape = decoded.joystickShape or 1
				joystickTransparency = decoded.joystickTransparency or 45
				playerTeleportMode = (decoded.playerTeleportMode == 2) and 2 or 1
				joystickOffsetX = decoded.joystickOffsetX or 0; joystickOffsetY = decoded.joystickOffsetY or 0
				dpadOffsetX = decoded.dpadOffsetX or 0; dpadOffsetY = decoded.dpadOffsetY or 0
				dpadSize = decoded.dpadSize or 80; dpadGap = decoded.dpadGap or 85
				if decoded.arrowOffset then
					arrowOffset.Up = decoded.arrowOffset.Up or {x=0,y=0}
					arrowOffset.Down = decoded.arrowOffset.Down or {x=0,y=0}
					arrowOffset.Left = decoded.arrowOffset.Left or {x=0,y=0}
					arrowOffset.Right = decoded.arrowOffset.Right or {x=0,y=0}
				end
			end
		end
	end)
end
loadConfig()

-- ========== 防检测与平滑传送模块 ==========
local AntiDetect = { MAX_TELEPORT_DISTANCE = 150, TELEPORT_TWEEN_TIME = 0.15, VELOCITY_CLEAR_INTERVAL = 2, VELOCITY_RESIDUAL = 0.01, _cameraTypeCached = nil, _frameCount = 0 }
local function safeSetCameraType(camType) if AntiDetect._cameraTypeCached ~= camType then camera.CameraType = camType; AntiDetect._cameraTypeCached = camType end end

local function safeTeleport(rootPart, targetCFrame)
	if not rootPart or not rootPart.Parent then return end
	local startPos = rootPart.Position; local distance = (targetCFrame.Position - startPos).Magnitude
	if distance <= AntiDetect.MAX_TELEPORT_DISTANCE then
		TweenService:Create(rootPart, TweenInfo.new(AntiDetect.TELEPORT_TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = targetCFrame }):Play()
	else
		local segments = math.ceil(distance / AntiDetect.MAX_TELEPORT_DISTANCE)
		local direction = (targetCFrame.Position - startPos).Unit
		task.spawn(function()
			for i = 1, segments do
				if not rootPart or not rootPart.Parent then break end
				local segmentTarget = i == segments and targetCFrame.Position or (startPos + direction * (AntiDetect.MAX_TELEPORT_DISTANCE * i))
				local tween = TweenService:Create(rootPart, TweenInfo.new(AntiDetect.TELEPORT_TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = CFrame.new(segmentTarget) * targetCFrame.Rotation })
				tween:Play(); tween.Completed:Wait()
			end
		end)
	end
end

-- 直接传送：只用于普通人物传送；坐在车辆/载具中时仍沿用上面的平移传送逻辑。
local function directTeleport(rootPart, targetCFrame)
	if not rootPart or not rootPart.Parent then return end
	rootPart.CFrame = targetCFrame
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
end

local function isInVehicle(char, hum)
	if not char then return false end
	if hum and hum.Sit then return true end
	local seat = hum and hum.SeatPart
	return seat ~= nil and (seat:IsA("Seat") or seat:IsA("VehicleSeat"))
end

local controls = nil
local function getControls()
	local ps = player:FindFirstChild("PlayerScripts"); if not ps then return nil end
	local pm = ps:FindFirstChild("PlayerModule"); if not pm then return nil end
	local s, m = pcall(require, pm); if not s or typeof(m) ~= "table" then return nil end
	local ok, ctrl = pcall(m.GetControls, m); return (ok and ctrl) and ctrl or nil
end
local function updateCharacterControls()
	if not controls then controls = getControls() end
	if freeCamActive and pcMode then
		if controls and typeof(controls.Disable) == "function" then controls:Disable() end
		ContextActionService:BindActionAtPriority("FreeCamSink", function() return Enum.ContextActionResult.Sink end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space)
	else
		if controls and typeof(controls.Enable) == "function" then controls:Enable() end
		ContextActionService:UnbindAction("FreeCamSink")
	end
end

