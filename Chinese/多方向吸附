local function getRandomString(length)
    length = length or math.random(12, 16)
    local charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    local result = {}
    for i = 1, length do
        local idx = math.random(1, #charset)
        table.insert(result, string.sub(charset, idx, idx))
    end
    return table.concat(result)
end

local function createSafeInstance(className, properties)
    local inst = Instance.new(className)
    inst.Name = getRandomString()
    if properties then
        for k, v in pairs(properties) do
            inst[k] = v
        end
    end
    return inst
end

