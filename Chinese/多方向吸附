local function setMagnetState(enabled)
    state.enabled = enabled
    if enabled then
        toggleBtn.Text = "吸附状态: 开启"
        updateMarqueeColor(toggleStroke, Colors.RedAccent)
        task.defer(function() applyHumanoidLock(true) end)
    else
        toggleBtn.Text = "吸附状态: 暂停"
        updateMarqueeColor(toggleStroke, Colors.GoldAccent)
        applyHumanoidLock(false)
    end
end
toggleBtn.MouseButton1Click:Connect(function()
    setMagnetState(not state.enabled)
end)

local currentAngle = 0
local ROTATION_SPEED = 140
table.insert(eventConnections, RunService.RenderStepped:Connect(function(dt)
    currentAngle = (currentAngle + dt * ROTATION_SPEED) % 360
    for i = #animatedGradients, 1, -1 do
        local item = animatedGradients[i]
        if item and item.Gradient and item.Gradient.Parent then
            item.Gradient.Rotation = currentAngle
        else
            table.remove(animatedGradients, i)
        end
    end
end))

table.insert(eventConnections, RunService.Heartbeat:Connect(function(dt)
    if not state.enabled or not state.targetPlayer then return end
    if not isPlayerValid(LocalPlayer) then return end
    if not isPlayerValid(state.targetPlayer) then return end

    local myChar = LocalPlayer.Character
    local targetChar = state.targetPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end

    trackTargetVelocity(targetRoot)

    local distToTarget = (myRoot.Position - targetRoot.Position).Magnitude
    if distToTarget > state.maxDistance then return end

    local targetCF = calculateMagnetCFrame(targetRoot, 0)

    if state.meleeMode and state.faceTarget then
        if not isTargetInAttackArc(myRoot, targetRoot) then
            local lookPos = Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z)
            if (lookPos - myRoot.Position).Magnitude > 0.01 then
                targetCF = CFrame.lookAt(targetCF.Position, lookPos, Vector3.new(0, 1, 0))
            end
        end
    end

    if distToTarget < 0.8 then
        myRoot.CFrame = targetCF
    else
        local alpha = math.clamp(dt * state.smoothSpeed, 0, 1)
        myRoot.CFrame = myRoot.CFrame:Lerp(targetCF, alpha)
    end
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
end))

