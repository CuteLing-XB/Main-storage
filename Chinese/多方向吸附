-- 长按加减控制逻辑
local function bindAutoHold(button, delta)
    local holding = false

    local function changeValue()
        state.distance = math.clamp(state.distance + delta, 0.1, 50.0)
        distText.Text = string.format("吸附距离: %.1fm", state.distance)
    end

    button.MouseButton1Down:Connect(function()
        holding = true
        changeValue()
        task.wait(0.3)
        while holding do
            changeValue()
            task.wait(0.05)
        end
    end)

    local function stopHold()
        holding = false
    end

    button.MouseButton1Up:Connect(stopHold)
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            stopHold()
        end
    end)
end

bindAutoHold(minusBtn, -0.1)
bindAutoHold(plusBtn, 0.1)

