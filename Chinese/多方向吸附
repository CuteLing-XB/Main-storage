local function makeSeamlessColorSequence(activeColor)
    local d = Color3.new(activeColor.R * 0.12, activeColor.G * 0.12, activeColor.B * 0.12)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, d),
        ColorSequenceKeypoint.new(0.35, d),
        ColorSequenceKeypoint.new(0.50, activeColor),
        ColorSequenceKeypoint.new(0.65, d),
        ColorSequenceKeypoint.new(1.0, d),
    })
end

local function addMarqueeStroke(parent, color, thickness)
    local stroke = createSafeInstance("UIStroke", {
        Color = Color3.fromRGB(255, 255, 255),
        Thickness = thickness or 1.2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
    local gradient = createSafeInstance("UIGradient", {
        Color = makeSeamlessColorSequence(color or Colors.GoldAccent),
        Transparency = NumberSequence.new(0),
        Parent = stroke,
    })
    table.insert(animatedGradients, { Gradient = gradient, Stroke = stroke })
    return stroke, gradient
end

local function updateMarqueeColor(stroke, newColor)
    for _, item in ipairs(animatedGradients) do
        if item.Stroke == stroke then
            item.Gradient.Color = makeSeamlessColorSequence(newColor)
            break
        end
    end
end

local cachedPing, lastPingTime = 0.05, 0
local function getPing()
    local now = os.clock()
    if now - lastPingTime > 0.5 then
        local ok, val = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        cachedPing = (ok and val and val / 1000) or 0.05
        lastPingTime = now
    end
    return cachedPing
end

local velocityTracker = { samples = {}, maxSamples = 8, maxAge = 0.25 }

local function resetVelocityTracker()
    velocityTracker.samples = {}
end

local function trackTargetVelocity(targetRoot)
    local now = os.clock()
    table.insert(velocityTracker.samples, { t = now, pos = targetRoot.Position })
    while #velocityTracker.samples > velocityTracker.maxSamples do
        table.remove(velocityTracker.samples, 1)
    end
    while #velocityTracker.samples > 1
        and (now - velocityTracker.samples[1].t) > velocityTracker.maxAge do
        table.remove(velocityTracker.samples, 1)
    end
end

local function getSmoothedVelocity(fallback)
    local s = velocityTracker.samples
    if #s < 2 then return fallback or Vector3.zero end
    local first, last = s[1], s[#s]
    local dt = last.t - first.t
    if dt < 0.001 then return fallback or Vector3.zero end
    return (last.pos - first.pos) / dt
end

local function getAdaptivePredictTime(extra)
    local base = state.predictTime + (extra or 0)
    return math.clamp(base + getPing() * state.pingPredictMul, 0, 0.35)
end

local function isPlayerValid(p)
    if not p or not p.Parent then return false end
    local char = p.Character
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local hs = hum:GetState()
    if hs == Enum.HumanoidStateType.Dead or hs == Enum.HumanoidStateType.Physics then
        return false
    end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function buildRayFilter()
    local list = {}
    if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
    local tp = state.targetPlayer
    if tp and tp.Character then table.insert(list, tp.Character) end
    rayParams.FilterDescendantsInstances = list
    return rayParams
end

local function isPosBlocked(fromPos, toPos)
    buildRayFilter()
    return workspace:Raycast(fromPos, toPos - fromPos, rayParams) ~= nil
end

local function getGroundY(pos)
    buildRayFilter()
    local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -80, 0), rayParams)
    return hit and hit.Position.Y or nil
end

local function isTargetInAttackArc(myRoot, targetRoot)
    if not state.faceTarget then return true end
    local toTarget = targetRoot.Position - myRoot.Position
    toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
    if toTarget.Magnitude < 0.01 then return true end
    toTarget = toTarget.Unit
    local myLook = myRoot.CFrame.LookVector
    myLook = Vector3.new(myLook.X, 0, myLook.Z)
    if myLook.Magnitude < 0.01 then return true end
    myLook = myLook.Unit
    local dot = math.clamp(myLook:Dot(toTarget), -1, 1)
    local angle = math.deg(math.acos(dot))
    return angle <= state.attackArcLimit
end

local function calculateMagnetCFrame(targetRoot, extraPredict)
    local rawPos = targetRoot.Position
    local targetVel = getSmoothedVelocity(targetRoot.AssemblyLinearVelocity)
    if targetVel.Magnitude < 0.5 then
        targetVel = targetRoot.AssemblyLinearVelocity
    end

    local predictT = getAdaptivePredictTime(extraPredict)
    local targetPos = rawPos
    if predictT > 0 then
        local vFlat = Vector3.new(targetVel.X, 0, targetVel.Z)
        local p = rawPos + vFlat * predictT
        targetPos = Vector3.new(p.X, rawPos.Y, p.Z)
    end

    local look = targetRoot.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    flatLook = (flatLook.Magnitude < 0.001) and -Vector3.zAxis or flatLook.Unit
    local yawCF = CFrame.lookAt(targetPos, targetPos + flatLook)

    local myPos = targetPos
    local dist = state.distance
    if state.direction == "Behind" then
        myPos = (yawCF * CFrame.new(0, 0, dist)).Position
    elseif state.direction == "Head" then
        myPos = (yawCF * CFrame.new(0, dist, 0)).Position
    elseif state.direction == "Below" then
        myPos = (yawCF * CFrame.new(0, -dist, 0)).Position
    elseif state.direction == "Left" then
        myPos = (yawCF * CFrame.new(-dist, 0, 0)).Position
    elseif state.direction == "Right" then
        myPos = (yawCF * CFrame.new(dist, 0, 0)).Position
    end

    if state.checkObstacle and (myPos - targetPos).Magnitude > 0.01 then
        if isPosBlocked(targetPos, myPos) then
            local dir = (myPos - targetPos).Unit
            myPos = targetPos + dir * math.max(dist * 0.5, 1)
        end
    end

    if state.groundClamp then
        local groundY = getGroundY(myPos)
        if groundY and myPos.Y < groundY - 0.5 then
            myPos = Vector3.new(myPos.X, groundY + 1.5, myPos.Z)
        end
    end

    if state.meleeMode and state.faceTarget then
        local flatTarget = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
        local diff = flatTarget - myPos
        if diff.Magnitude > 0.01 then
            return CFrame.lookAt(myPos, flatTarget, Vector3.new(0, 1, 0))
        else
            return CFrame.lookAt(myPos, myPos + flatLook, Vector3.new(0, 1, 0))
        end
    end

    if state.forceGroundUp then
        local flatTarget = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
        local diff = flatTarget - myPos
        if diff.Magnitude < 0.01 then
            return CFrame.lookAt(myPos, myPos + flatLook, Vector3.new(0, 1, 0))
        end
        return CFrame.lookAt(myPos, flatTarget, Vector3.new(0, 1, 0))
    end

    if (myPos - targetPos).Magnitude > 0.001 then
        return CFrame.lookAt(myPos, targetPos)
    else
        return yawCF
    end
end

local savedCanCollide = {}

local function applyHumanoidLock(lock)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if state.lockHumanoid then
        pcall(function()
            hum.AutoRotate = not lock
            if not isMobile then
                hum.PlatformStand = lock
            end
        end)
    end

    if state.disableCollide then
        if lock then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    savedCanCollide[part] = part.CanCollide
                    part.CanCollide = false
                end
            end
        else
            for part, oldVal in pairs(savedCanCollide) do
                if part and part.Parent then
                    pcall(function() part.CanCollide = oldVal end)
                end
            end
            savedCanCollide = {}
        end
    end
end

local function preAttackSync(forceSnap)
    if not state.enabled or not state.targetPlayer then return end
    if not isPlayerValid(state.targetPlayer) then return end
    local myChar = LocalPlayer.Character
    local tc = state.targetPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = tc and tc:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return end

    trackTargetVelocity(tRoot)

    local nowDist = (myRoot.Position - tRoot.Position).Magnitude
    if not forceSnap and nowDist < state.finalSnapDist * 0.9 then
        return
    end

    local origDist = state.distance
    if forceSnap and nowDist > state.finalSnapDist then
        state.distance = math.min(state.distance, state.finalSnapDist)
    end

    local targetCF = calculateMagnetCFrame(tRoot, state.attackPredictX)
    state.distance = origDist

    if not isTargetInAttackArc(myRoot, tRoot) then
        local lookPos = Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z)
        if (lookPos - myRoot.Position).Magnitude > 0.01 then
            targetCF = CFrame.lookAt(targetCF.Position, lookPos, Vector3.new(0, 1, 0))
        end
    end

    myRoot.CFrame = targetCF
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
end

local ATTACK_ANIM_PATTERNS = {
    "m1", "m2", "punch", "kick", "slash", "strike", "jab", "hook",
    "uppercut", "slam", "sweep", "elbow", "knee", "attack", "hit",
    "swing", "combo", "melee",
}

local function isAttackAnimName(name)
    if type(name) ~= "string" or name == "" then return false end
    local lower = name:lower()
    for _, p in ipairs(ATTACK_ANIM_PATTERNS) do
        if string.find(lower, p, 1, true) then return true end
    end
    return false
end

local hookedAnimators = setmetatable({}, { __mode = "k" })

local function watchMyAnimator(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 10)
    if not animator then return end
    if hookedAnimators[animator] then return end
    hookedAnimators[animator] = true

    local conn = animator.AnimationPlayed:Connect(function(track)
        if not state.enabled or not state.targetPlayer then return end
        local animName = ""
        pcall(function()
            if track.Animation then animName = track.Animation.Name end
        end)
        if isAttackAnimName(animName) then
            task.defer(function()
                pcall(preAttackSync, true)
            end)
        end
    end)
    table.insert(eventConnections, conn)
end

if LocalPlayer.Character then
    task.spawn(watchMyAnimator, LocalPlayer.Character)
end
table.insert(eventConnections, LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    watchMyAnimator(char)
end))

local function isAttackRemoteName(name)
    if type(name) ~= "string" then return false end
    local lower = name:lower()
    for _, kw in ipairs(ATTACK_ANIM_PATTERNS) do
        if string.find(lower, kw, 1, true) then return true end
    end
    return false
end

pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            if state.enabled and state.targetPlayer then
                local args = {...}
                local data = args[1]
                local shouldSync = false

                if type(data) == "table" then
                    if data.Type == "Combat" and (data.Action == "M1" or data.Action == "M2") then
                        shouldSync = true
                    end
                end

                if not shouldSync then
                    local ok, name = pcall(function() return self.Name end)
                    if ok and isAttackRemoteName(name) then
                        shouldSync = true
                    end
                end

                if shouldSync then
                    pcall(preAttackSync, true)
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end)

