local function updatePlayerList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local isTarget = (state.targetPlayer == p)
            local aliveTag = isPlayerValid(p) and "" or " [死亡]"
            local pBtn = createSafeInstance("TextButton", {
                Size = UDim2.new(1, -4, 0, 34),
                BackgroundColor3 = Colors.Panel,
                Font = Enum.Font.Gotham,
                Text = p.DisplayName .. " (@" .. p.Name .. ")" .. aliveTag,
                TextColor3 = isTarget and Colors.GoldAccent or Colors.TextPrimary,
                TextSize = 12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = scrollFrame,
            })
            addCorner(pBtn, 6)
            addMarqueeStroke(pBtn, isTarget and Colors.RedAccent or Colors.GoldAccent, 1.2)
            pBtn.MouseButton1Click:Connect(function()
                state.targetPlayer = p
                targetText.Text = "目标: " .. p.DisplayName
                resetVelocityTracker()
                updatePlayerList()
            end)
        end
    end
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

