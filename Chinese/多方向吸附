-- 平滑匀速顺时针跑马灯动画驱动
local currentAngle = 0
local ROTATION_SPEED = 140

table.insert(eventConnections, RunService.RenderStepped:Connect(function(deltaTime)
    currentAngle = (currentAngle + deltaTime * ROTATION_SPEED) % 360
    for i = #animatedGradients, 1, -1 do
        local item = animatedGradients[i]
        if item and item.Gradient and item.Gradient.Parent then
            item.Gradient.Rotation = currentAngle
        else
            table.remove(animatedGradients, i)
        end
    end
end))

table.insert(eventConnections, RunService.Heartbeat:Connect(function()
    if not state.enabled or not state.targetPlayer then return end

    local myChar = LocalPlayer.Character
    local targetChar = state.targetPlayer.Character

    if not myChar or not targetChar then return end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")

    if not myRoot or not targetRoot then return end

    -- 执行贴合解算
    local calculatedCFrame = calculateMagnetCFrame(targetRoot)
    myRoot.CFrame = calculatedCFrame
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
end))

