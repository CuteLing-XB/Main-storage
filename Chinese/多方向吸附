-- 独立吸附解算逻辑 (过滤目标倒地/趴下的旋转影响)
----------------------------------------------------
local function getTargetYawCFrame(targetRoot)
    local targetPos = targetRoot.Position
    local lookVector = targetRoot.CFrame.LookVector
    local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
    if flatLook.Magnitude < 0.001 then
        flatLook = -Vector3.zAxis
    else
        flatLook = flatLook.Unit
    end
    return CFrame.lookAt(targetPos, targetPos + flatLook)
end

local function calculateMagnetCFrame(targetRoot)
    local targetPos = targetRoot.Position
    local yawCFrame = getTargetYawCFrame(targetRoot)
    local myPos = targetPos
    local dist = state.distance

    if state.direction == "Behind" then
        myPos = (yawCFrame * CFrame.new(0, 0, dist)).Position
    elseif state.direction == "Head" then
        myPos = (yawCFrame * CFrame.new(0, dist, 0)).Position
    elseif state.direction == "Below" then
        myPos = (yawCFrame * CFrame.new(0, -dist, 0)).Position
    elseif state.direction == "Left" then
        myPos = (yawCFrame * CFrame.new(-dist, 0, 0)).Position
    elseif state.direction == "Right" then
        myPos = (yawCFrame * CFrame.new(dist, 0, 0)).Position
    end

    if (myPos - targetPos).Magnitude > 0.001 then
        return CFrame.lookAt(myPos, targetPos)
    else
        return yawCFrame
    end
end

