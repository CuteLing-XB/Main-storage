        function BypassCore:SetPropertyOverride(obj, key, fakeValue)
            if not obj then return end
            if not self.State.PropertyOverrides[obj] then
                self.State.PropertyOverrides[obj] = {}
            end
            self.State.PropertyOverrides[obj][key] = fakeValue

            if not self.State.OldIndexHook then
                pcall(function()
                    if hookmetamethod and checkcaller then
                        self.State.OldIndexHook = hookmetamethod(game, "__index", function(self_obj, k)
                            if not checkcaller() then
                                local ov = BypassCore.State.PropertyOverrides[self_obj]
                                if ov and ov[k] ~= nil then
                                    return ov[k]
                                end
                                pcall(function()
                                    if self_obj and self_obj.IsA and self_obj:IsA("Humanoid") then
