            {Name = "学乱3", Url = "https://raw.githubusercontent.com/CuteLing-XB/Main-storage/refs/heads/main/Chinese/%E5%AD%A6%E4%B9%B1%E6%96%B0%E7%89%88%E6%B1%89%E5%8C%96%E6%A8%A1%E6%9D%BF.lua"},
            {Name = "学乱2", Url = "https://raw.githubusercontent.com/CuteLing-XB/Main-storage/refs/heads/main/Chinese/%E5%AD%A6%E4%B9%B12"},
        }
        XueLuanTab:Section({ Title = "脚本列表" })
        for _, scriptInfo in ipairs(XueLuanScripts) do
            XueLuanTab:Button({
                Title = scriptInfo.Name,
                Desc = "点击直接执行",
                Icon = "solar:bolt-bold-duotone",
                Callback = function()
                    SafeExecute(scriptInfo.Name, scriptInfo.Url)
                end,
            })
        end

        -- ========== 9. 设置 Tab ==========
        local SettingTab = Window:Tab({ Title = "设置", Icon = "solar:settings-bold-duotone" })
        SettingTab:Section({ Title = "透明界面设置" })
        SettingTab:Paragraph({ Title = "纯透明背景模式", Desc = "已移除所有背景图片，当前 UI 背景完全透明。" })

        SettingTab:Section({ Title = "PC 端按键绑定" })
        local pcToggleKeybind = SettingTab:Keybind({
            Title = "自定义开关按键", Desc = "切换 XL Hub 显示状态", Icon = "solar:keyboard-bold-duotone",
            Value = "RightShift", Flag = "PCWindowToggleKey",
            Callback = function(keyName)
                local keyCode = typeof(keyName) == "EnumItem" and keyName or Enum.KeyCode[keyName]
                if keyCode then Window:SetToggleKey(keyCode) end
            end,
        })

        -- ========== 10. 配置管理 ==========
        local ConfigManager = Window.ConfigManager
        local ConfigName = "default"
        local ConfigFile = nil
        local function getWindUIConfig()
            if not ConfigManager then return nil end
            if not ConfigFile then
                ConfigFile = ConfigManager:CreateConfig(ConfigName)
                if ConfigFile then
                    ConfigFile:Register("PCWindowToggleKey", pcToggleKeybind)
                end
            end
            return ConfigFile
        end
        local ConfigSaveBusy = false
        local function saveWindUIConfig()
            if ConfigSaveBusy or not StartupAlive then return false end
            ConfigSaveBusy = true
            local ok, result = pcall(function()
                local config = getWindUIConfig()
                if not config then return false end
                return config:Save() == true
            end)
            ConfigSaveBusy = false
            return ok and result == true
        end
        local function loadWindUIConfig()
            local config = getWindUIConfig()
            if not config then return false end
            local ok, result = pcall(function() return config:Load() end)
            return ok and result ~= nil
        end

        if ConfigManager then
            local configInitOk, configInitError = pcall(function() ConfigManager:Init(Window); getWindUIConfig() end)
            if not configInitOk then warn("[XL Hub] 配置初始化跳过：" .. tostring(configInitError)) end
            SettingTab:Section({ Title = "配置保存" })
            SettingTab:Button({
                Title = "保存控件配置", Desc = "保存主题、参数和按键", Icon = "solar:diskette-bold-duotone",
                Callback = function()
                    if saveWindUIConfig() then WindUI:Notify({Title = "配置已保存", Content = "已保存到 default", Duration = 2})
                    else WindUI:Notify({Title = "保存失败", Content = "ConfigManager 不可用", Duration = 3}) end
                end,
            })
            SettingTab:Button({
                Title = "立即读取已保存配置", Desc = "恢复主题、参数和按键", Icon = "solar:folder-open-bold-duotone",
                Callback = function()
                    if loadWindUIConfig() then WindUI:Notify({Title = "配置已读取", Content = "已恢复 default 配置", Duration = 2})
                    else WindUI:Notify({Title = "读取失败", Content = "暂未找到配置文件", Duration = 3}) end
                end,
            })
            task.defer(function()
                task.wait(0.25)
                if not StartupAlive then return end
                pcall(loadWindUIConfig)
            end)
            Window:OnClose(function() saveWindUIConfig() end)
            Window:OnDestroy(function() saveWindUIConfig() end)
        else
            SettingTab:Paragraph({ Title = "配置管理器不可用", Desc = "WindUI 未提供 ConfigManager", Icon = "solar:danger-triangle-bold-duotone" })
        end

        -- ========== 11. 清理函数 ==========
        _G.__XLHubCleanup = function()
            if not StartupAlive then return end
            StartupAlive = false
            if ImageWindowCleanup then pcall(ImageWindowCleanup); ImageWindowCleanup = nil end
            ImageReloadCurrent = nil
            if SidebarTransparencyCleanup then pcall(SidebarTransparencyCleanup) end
            if _G.__XLHubBootToken == BootToken then _G.__XLHubBootToken = nil end
            pcall(function()
                if Window and Window.Destroy then Window:Destroy() end
            end)
        end
    end, function(err)
        warn("[XL Hub] 启动过程发生错误: " .. tostring(err))
        warn(debug.traceback())
    end)

    if not ok then
        warn("[XL Hub] 启动异常: " .. tostring(startupErr))
    end
end

xpcall(safeStartup, function(err)
    warn("[XL Hub] 致命启动错误: " .. tostring(err))
    warn(debug.traceback())
end)
