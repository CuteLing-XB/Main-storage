            local url = "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
            local done = false
            local source
            local fetchError
            task.spawn(function()
                local ok, result = pcall(function()
                    local candidates = {}
                    local function addCandidate(value)
                        if type(value) == "function" then candidates[#candidates + 1] = value end
                    end
                    addCandidate(rawget(_G, "request"))
                    addCandidate(rawget(_G, "http_request"))
                    local synTable = rawget(_G, "syn")
                    if type(synTable) == "table" then addCandidate(synTable.request) end
                    local httpTable = rawget(_G, "http")
                    if type(httpTable) == "table" then addCandidate(httpTable.request) end
                    for _, requestFunction in ipairs(candidates) do
                        local requestOk, response = pcall(function()
                            return requestFunction({Url = url, Method = "GET", Headers = {['User-Agent'] = "XLHub/2.0"}, Timeout = 10})
                        end)
                        if requestOk and type(response) == "table" then
                            local body = response.Body or response.body
                            if type(body) == "string" and body ~= "" then return body end
                        elseif requestOk and type(response) == "string" and response ~= "" then
                            return response
                        end
                    end
                    if game then return game:HttpGet(url) end
                    error("所有请求函数均失败")
                end)
                if ok and type(result) == "string" and result ~= "" then source = result
                else fetchError = result end
                done = true
            end)
            local deadline = os.clock() + 12
            while not done and os.clock() < deadline do task.wait(0.05) end
            if not done then error("WindUI 请求超时") end
            if type(source) ~= "string" or source == "" then error(tostring(fetchError or "WindUI 返回为空")) end
            local chunk = loadstring(source)
            assert(type(chunk) == "function", "WindUI 源码无法编译")
            WindUI = chunk()
        end)
