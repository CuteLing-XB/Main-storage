                for attempt = 1, retryCount do
                    local ok, err = pcall(function()
                        local source = game:HttpGet(url)
                        if type(source) ~= "string" or source == "" then
                            error("远程内容为空")
                        end
                        local chunk = loadstring(source)
                        assert(type(chunk) == "function", "远程内容无法编译")
                        chunk()
                    end)
                    if ok then
                        WindUI:Notify({
                            Title = "执行成功",
                            Content = scriptName .. " 已成功运行",
                            Duration = 3,
                        })
                        return
                    end
                    lastErr = err
                    if attempt < retryCount then task.wait(1.2) end
                end
                WindUI:Notify({
                    Title = "执行失败",
                    Content = scriptName .. "：" .. tostring(lastErr),
                    Duration = 5,
                })
                warn("[" .. scriptName .. "] " .. tostring(lastErr))
            end)
        end

