                end
            end
            local sidebar = Window.UIElements and Window.UIElements.SideBarContainer
            if sidebar then
                bindSidebarTree(sidebar)
                local sidebarConnection = sidebar.DescendantAdded:Connect(function(descendant) makeSidebarTabBackgroundTransparent(descendant) end)
