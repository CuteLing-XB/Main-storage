                                            return Vector3.new(0, 0, 0)
                                        end
                                    end
                                end)
                            end
                            return BypassCore.State.OldIndexHook(self_obj, k)
                        end)
                    end
                end)
            end
        end

        function BypassCore:ClearPropertyOverride(obj, key)
            if self.State.PropertyOverrides[obj] then
                if key then
                    self.State.PropertyOverrides[obj][key] = nil
                else
                    self.State.PropertyOverrides[obj] = nil
                end
            end
        end

        function BypassCore:ProtectGUI(instance)
