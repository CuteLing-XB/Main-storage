            local function makeSidebarTabBackgroundTransparent(object)
                if not object or not object:IsA("GuiObject") then return end
                if object.Name ~= "Frame" and object.Name ~= "Outline" then return end
                if boundSidebarObjects[object] then return end
                boundSidebarObjects[object] = true
                if object:IsA("ImageLabel") or object:IsA("ImageButton") then object.ImageTransparency = 1 end
                object.BackgroundTransparency = 1
            end
            local function bindSidebarTree(root)
                makeSidebarTabBackgroundTransparent(root)
