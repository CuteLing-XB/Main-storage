        function BypassCore:DisableAntiCheatEvents()
            pcall(function()
                if not getconnections then return end
                local eventNames = {"AntiCheat", "AntiExploit", "AntiSpeed", "AntiFling", "SpeedCheck", "KillFeed", "AC_Remote", "ExploitDetector"}
                local rs = game:GetService("ReplicatedStorage")
                for _, name in ipairs(eventNames) do
                    local ev = rs:FindFirstChild(name)
                    if ev and ev:IsA("RemoteEvent") then
                        for _, c in ipairs(getconnections(ev.OnClientEvent)) do
                            if c.Disable then pcall(c.Disable, c) end
                        end
                    end
                end
            end)
        end

        function BypassCore:HideErrors(keywords)
            keywords = keywords or {"AntiCheat", "Fling", "Bypass", "Exploit"}
            pcall(function()
                local oldError = error
                error = function(msg, level)
                    if type(msg) == "string" then
                        for _, kw in ipairs(keywords) do
                            if msg:find(kw, 1, true) then return end
                        end
                    end
                    oldError(msg, level)
                end
            end)
        end

        function BypassCore:SafeFireServer(remoteObj, ...)
            local args = {...}
            return pcall(function()
                local old = getthreadidentity and getthreadidentity() or 2
                if setthreadidentity then setthreadidentity(2) end
                remoteObj:FireServer(unpack(args))
                if setthreadidentity then setthreadidentity(old) end
            end)
        end

        function BypassCore:InitializeAll()
            if self.State.Initialized then return end
            self.State.Initialized = true
            self:HideErrors()
            self:DisableAntiCheatEvents()
            print("[BypassCore Lite] 反作弊防护已启动：属性欺骗+事件屏蔽+错误隐藏（已关闭反踢出）")
