        local function SafeExecute(scriptName, url, retryCount)
            retryCount = tonumber(retryCount) or 3
            WindUI:Notify({
                Title = "正在加载",
                Content = "正在获取 " .. scriptName .. "，请稍候...",
                Duration = 2,
