        -- 获取角色的关键部件（带缓存）
        local function AimGetCharParts(player)
            local character = player and player.Character
            if not character then return nil end
            local cache = AimCharCache[player]
            if cache and cache.Character == character and cache.Root and cache.Root.Parent then
                return cache
            end
            local root = character:FindFirstChild("HumanoidRootPart")
            local head = character:FindFirstChild("Head")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local upperTorso = character:FindFirstChild("UpperTorso")
            local torso = character:FindFirstChild("Torso")
            cache = {
                Character = character,
                Root = root,
                Head = head,
                Humanoid = humanoid,
                UpperTorso = upperTorso,
                Torso = torso,
            }
            AimCharCache[player] = cache
            return cache
        end

        -- ============================================================
        -- 3.3 ★ 修复：队伍检查（全方位兼容）
        -- 根因：自由对战中 TeamColor 全为 White，旧代码误判全员为队友
        -- 新增：Attribute 检查、自定义队伍属性检查
        -- ============================================================
        local DEFAULT_TEAM_COLORS = {
            ["White"] = true,
            ["Medium stone grey"] = true,
            ["Dark stone grey"] = true,
            ["Black"] = true,
            ["Really black"] = true,
        }

        -- 常见自定义队伍属性名
        local CUSTOM_TEAM_PROPS = {
            "Team", "TeamID", "TeamName", "Faction", "Gang",
            "Squad", "Side", "ColorTeam", "PlayerTeam", "TeamColor",
        }

        -- 从 Player 或 Character 中读取自定义队伍标识
        local function AimReadCustomTeam(player)
            local character = player and player.Character
            -- 1. Attribute 系统（Roblox 推荐方式）
            for _, propName in ipairs(CUSTOM_TEAM_PROPS) do
                local ok, val = pcall(function() return player:GetAttribute(propName) end)
                if ok and val ~= nil and val ~= "" then
                    return tostring(val)
                end
            end
            -- 2. Player 的子对象（StringValue / IntValue / BrickColorValue）
            for _, propName in ipairs(CUSTOM_TEAM_PROPS) do
                local obj = player:FindFirstChild(propName)
                if obj and obj.Value ~= nil and obj.Value ~= "" then
                    return tostring(obj.Value)
                end
            end
            -- 3. Character 的子对象
            if character then
                for _, propName in ipairs(CUSTOM_TEAM_PROPS) do
                    local obj = character:FindFirstChild(propName)
                    if obj and obj.Value ~= nil and obj.Value ~= "" then
                        return tostring(obj.Value)
                    end
                end
            end
            return nil
        end

        local function AimValidTarget(player)
            if not player or player == AimLocalPlayer then return false end

            if AimConfig.TeamCheck then
                -- 方式1：标准 Team 对象（最可靠）
                local myTeam = AimLocalPlayer.Team
                local targetTeam = player.Team
                if myTeam and targetTeam then
                    if myTeam == targetTeam then return false end
                elseif not (myTeam or targetTeam) then
                    -- 双方都没有 Team 对象 → 检查 TeamColor
                    local myColor = AimLocalPlayer.TeamColor
                    local targetColor = player.TeamColor
                    if myColor and targetColor and myColor == targetColor then
                        -- 排除默认颜色（自由对战中所有人都是这些颜色）
                        if not DEFAULT_TEAM_COLORS[myColor.Name] then
                            return false
                        end
                    end
                end
                -- 方式2：自定义队伍标识（Attribute / Value 对象）
                local myCustom = AimReadCustomTeam(AimLocalPlayer)
                local targetCustom = AimReadCustomTeam(player)
                if myCustom and targetCustom and myCustom == targetCustom then
                    return false
                end
            end

            -- 角色与生命状态检查
            local parts = AimGetCharParts(player)
            if not parts or not parts.Root or not parts.Head then return false end
            if not parts.Humanoid or parts.Humanoid.Health <= 0 then return false end
            if parts.Character:FindFirstChildOfClass("ForceField") then return false end

            -- 距离检查
            local myParts = AimGetCharParts(AimLocalPlayer)
            if myParts and myParts.Root then
                local distance = (parts.Root.Position - myParts.Root.Position).Magnitude
                if distance > AimConfig.MaxDistance then return false end
            end
            return true
        end

        -- ============================================================
        -- 3.4 ★ 修复：墙壁检测（双向射线 + 小偏移 + RespectCanCollide）
        -- 根因：旧代码偏移量0.5太大可绕过薄墙；单向射线在相机穿墙时误判
        -- ============================================================
        -- 偏移检测点（12个方向，偏移量减小到0.25防止绕过薄墙）
        local AIM_VISIBLE_OFFSETS = {
            Vector3.new(0, 0.25, 0),
            Vector3.new(0, -0.25, 0),
            Vector3.new(0.25, 0, 0),
            Vector3.new(-0.25, 0, 0),
            Vector3.new(0, 0, 0.25),
            Vector3.new(0, 0, -0.25),
            Vector3.new(0.15, 0.15, 0),
            Vector3.new(-0.15, -0.15, 0),
            Vector3.new(0.15, -0.15, 0),
            Vector3.new(-0.15, 0.15, 0),
            Vector3.new(0, 0.15, 0.15),
            Vector3.new(0, -0.15, -0.15),
        }

        -- v5：RaycastParams 缓存，只有本地角色或相机变更时才重建
        local function AimMakeRayParams()
            local myChar = AimLocalPlayer.Character
            local camera = AimWorkspace.CurrentCamera
            if AimCachedRayParams and AimCachedRayParamsChar == myChar and AimCachedRayParamsCamera == camera then
                return AimCachedRayParams
            end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.IgnoreWater = true
            params.RespectCanCollide = true
            local ignoreList = {}
            if camera then
                table.insert(ignoreList, camera)
            end
            if myChar then
                table.insert(ignoreList, myChar)
            end
            params.FilterDescendantsInstances = ignoreList
            AimCachedRayParams = params
            AimCachedRayParamsChar = myChar
            AimCachedRayParamsCamera = camera
            return params
        end

        -- 判断射线结果是否命中目标角色自身
        local function AimHitTarget(result, targetCharacter)
            if not result or not result.Instance then return false end
            local inst = result.Instance
            return inst:IsDescendantOf(targetCharacter) or inst.Parent == targetCharacter
        end

        local function AimVisible(part)
            if not AimConfig.WallCheck then return true end
            local camera = AimWorkspace.CurrentCamera
            if not camera or not part then return false end
            local origin = camera.CFrame.Position
            local targetPos = part.Position
            local targetCharacter = part.Parent
            local direction = targetPos - origin
            if direction.Magnitude < 0.1 then return true end

            local params = AimMakeRayParams()

            -- 主射线：相机 → 目标中心
            local result = AimWorkspace:Raycast(origin, direction, params)
            if not result then return true end
            if AimHitTarget(result, targetCharacter) then return true end

            -- 偏移射线：12个方向的微小偏移（防止帽子/胸甲误判，偏移量小不绕墙）
            for _, offset in ipairs(AIM_VISIBLE_OFFSETS) do
                local offsetPos = targetPos + offset
                local offsetDir = offsetPos - origin
                local subResult = AimWorkspace:Raycast(origin, offsetDir, params)
                if not subResult or AimHitTarget(subResult, targetCharacter) then
                    return true
                end
            end

            -- 反向射线：目标 → 相机（验证相机是否穿墙导致误判）
            -- 如果反向射线无阻挡，说明相机可能在墙内，实际目标可见
            local reverseDir = origin - targetPos
            local reverseResult = AimWorkspace:Raycast(targetPos, reverseDir, params)
            if not reverseResult then return true end
            if AimHitTarget(reverseResult, targetCharacter) then return true end

            return false
        end

        -- ============================================================
        -- 3.5 瞄准辅助函数
        -- ============================================================
        local function AimGetAimPart(character)
            if not character then return nil end
            if AimConfig.AimPartChoice == "Head" then
                return character:FindFirstChild("Head")
            else
                return character:FindFirstChild("UpperTorso")
                    or character:FindFirstChild("Torso")
                    or character:FindFirstChild("HumanoidRootPart")
                    or character:FindFirstChild("Head")
            end
        end

        local function AimScreenDistance(part)
            local camera = AimWorkspace.CurrentCamera
            if not camera or not part then return math.huge end
            local position, onScreen = camera:WorldToViewportPoint(part.Position)
            if not onScreen or position.Z <= 0 then return math.huge end
            -- v5：使用缓存的视口中心，避免重复计算
            return math.sqrt((position.X - AimViewportCenterX) ^ 2 + (position.Y - AimViewportCenterY) ^ 2)
        end

        -- 寻找最佳目标（先做便宜的距离/队伍筛选，再做昂贵的射线检测）
        local function AimFindTarget()
            local bestPlayer = nil
            local bestPart = nil
            local bestDistance = AimConfig.FOV
            local myParts = AimGetCharParts(AimLocalPlayer)

            for _, player in ipairs(AimPlayerList) do
                if player ~= AimLocalPlayer and AimValidTarget(player) then
                    local character = player.Character
                    local part = AimGetAimPart(character)
                    if part then
                        -- 先做屏幕距离快速筛选（便宜），FOV外直接跳过
                        local screenDist = AimScreenDistance(part)
                        if screenDist < bestDistance then
                            -- 再做墙壁检测（昂贵），只对FOV内目标执行
                            if AimVisible(part) then
                                bestDistance = screenDist
                                bestPlayer = player
                                bestPart = part
                            end
                        end
                    end
                end
            end
            return bestPlayer, bestPart
        end

        local function AimTargetStillValid()
            if not AimCurrentTarget or not AimCurrentPart then return false end
            if not AimValidTarget(AimCurrentTarget) then return false end
            local character = AimCurrentTarget.Character
            local part = AimGetAimPart(character)
            if not part then return false end
            AimCurrentPart = part
            if not AimVisible(part) then return false end
            return AimScreenDistance(part) <= AimConfig.FOV * 1.35
        end

        -- 强锁验证（无视墙壁和FOV，只检查存活和距离）
        local function AimStrongValidTarget(player)
            if not player or player == AimLocalPlayer then return false end
            local parts = AimGetCharParts(player)
            if not parts or not parts.Root then return false end
            if not parts.Humanoid or parts.Humanoid.Health <= 0 then return false end
            local myParts = AimGetCharParts(AimLocalPlayer)
            if myParts and myParts.Root then
                local distance = (parts.Root.Position - myParts.Root.Position).Magnitude
                if distance > AimConfig.MaxDistance * 2 then return false end
            end
            return true
        end

