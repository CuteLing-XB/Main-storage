-- 通用脚本执行封装
local function SafeExecute(scriptName, url)
    Rayfield:Notify({Title = "正在加载", Content = "正在获取 " .. scriptName .. "，请稍候...", Duration = 3, Image = "code"})
    task.spawn(function()
        local success, err = pcall(function() loadstring(game:HttpGet(url))() end)
        if success then
            Rayfield:Notify({Title = "执行成功", Content = scriptName .. " 已运行！", Duration = 4, Image = "check"})
        else
            Rayfield:Notify({Title = "执行失败", Content = scriptName .. " 运行出错: " .. tostring(err), Duration = 6, Image = "alert-triangle"})
        end
    end)
end

