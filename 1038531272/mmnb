        connections = {}
        if currentImageAsset ~= "" and type(delfile) == "function" then
            pcall(delfile, currentImageAsset)
            currentImageAsset = ""
        end
        pcall(function()
            screenGui:Destroy()
        end)
        if ImageWindowCleanup == cleanupImageWindow then
            ImageWindowCleanup = nil
        end
    end

