-- 检查卡密是否为本地管理员卡密
local function isLocalAdminKey(key)
    if not key then return false end
    local clean = key:match("^%s*(.-)%s*$")
    return LOCAL_ADMIN_KEYS[clean] == true
end

-- 获取设备 HWID
local function getHWID()
    local hwid = "UNKNOWN_HWID"
    pcall(function() hwid = RbxAnalyticsService:GetClientId() end)
    return hwid
end

-- 向服务器验证卡密 (自动带上自己的 Roblox Username)
local function VerifyKeyWithServer(enteredKey)
    if not enteredKey or enteredKey == "" then 
        return false, "请输入有效卡密！" 
    end

    local cleanKey = enteredKey:match("^%s*(.-)%s*$")

    -- 如果是本地硬编码的管理员卡密，免 HWID 绑定直接通过
    if isLocalAdminKey(cleanKey) then
        return true, "管理员身份验证通过！"
    end

    local payload = {
        key = cleanKey,
        hwid = getHWID(),
        username = LocalPlayer.Name, -- 获取唯一的 Roblox Username
        secret = AUTH_SECRET
    }
    
    local requestData = {
        Url = API_URL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    }
    
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not httpRequest then return false, "当前执行器不支持 HTTP 请求" end
    
    local success, result = pcall(function() return httpRequest(requestData) end)
    if success and result and result.Body then
        local jsonSuccess, decoded = pcall(function() return HttpService:JSONDecode(result.Body) end)
        if jsonSuccess and decoded then
            return decoded.success, decoded.message
        end
    end
    return false, "无法连接卡密服务器，请稍后再试"
end

-- 远程踢人请求（强制发送目标玩家的 Roblox Username）
local function RequestKickPlayerByUsername(targetUsername)
    if not targetUsername or targetUsername == "" then
        return false, "目标 Roblox Username 不能为空！"
    end

    local payload = {
        adminKey = "XLKEY-ADMIN888",
        targetUser = targetUsername:match("^%s*(.-)%s*$"), -- 精确传出 Roblox Username
        secret = AUTH_SECRET
    }
    
    local requestData = {
        Url = KICK_URL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    }
    
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not httpRequest then return false, "执行器不支持请求" end
    
    local success, result = pcall(function() return httpRequest(requestData) end)
    if success and result and result.Body then
        local jsonSuccess, decoded = pcall(function() return HttpService:JSONDecode(result.Body) end)
        if jsonSuccess and decoded then
            return decoded.success, decoded.message
        end
    end
    return false, "请求失败或服务器无响应"
end

-- 获取同服务器所有在线玩家的 Roblox Username 列表
local function GetOnlineUsernames()
    local userList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        table.insert(userList, player.Name) -- player.Name 即唯一的 Roblox Username
    end
    if #userList == 0 then table.insert(userList, LocalPlayer.Name) end
    return userList
end

-- 本地文件操作
local function getSavedKey()
    if isfile and isfile(SAVE_FILE_NAME) then 
        local content = readfile(SAVE_FILE_NAME)
        return content and content:match("^%s*(.-)%s*$")
    end
    return nil
end

local function saveKeyLocally(key)
    if writefile then writefile(SAVE_FILE_NAME, key) end
end

