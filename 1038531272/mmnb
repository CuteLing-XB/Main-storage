                end
            end
            return nil
        end

        -- requestHttpBody 恢复 game:HttpGet 作为最后后备
        local function requestHttpBody(url, accept)
            if type(url) ~= "string" or url == "" then
                error("请求地址为空")
            end
            local errors = {}
            local headers = {
                ["Accept"] = accept or "application/json",
                ["User-Agent"] = "XLHub/2.0 WindUI image client",
            }
            -- 尝试候选函数
            for _, requestFunction in ipairs(getRequestCandidates()) do
                local ok, response = pcall(function()
                    return requestFunction({
                        Url = url,
                        Method = "GET",
                        Headers = headers,
                        Timeout = 10,
                    })
                end)
                if ok then
                    local body = getResponseBody(response)
                    if body then
                        return body
                    end
                    if type(response) == "table" then
                        errors[#errors + 1] = "执行器返回空 Body"
                    else
                        errors[#errors + 1] = "执行器返回格式不是字符串或响应表"
                    end
                else
                    errors[#errors + 1] = tostring(response)
                end
            end
            -- 最后尝试 game:HttpGet（可能阻塞，但作为兼容性保底）
            if game then
                local ok, body = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok and type(body) == "string" and body ~= "" then
                    return body
                end
                errors[#errors + 1] = ok and "game:HttpGet 返回空" or tostring(body)
            end
            error("所有请求方式均失败：" .. table.concat(errors, " | "))
        end

        -- 防止请求函数卡住界面：用事件唤醒替代固定间隔轮询。
        local function requestHttpBodyWithTimeout(url, accept, timeoutSeconds)
            timeoutSeconds = tonumber(timeoutSeconds) or 15
            local finished = false
            local requestOk = false
            local result
            local completion = Instance.new("BindableEvent")
            local waiting = true

            task.spawn(function()
                requestOk, result = pcall(function()
                    return requestHttpBody(url, accept)
                end)
                finished = true
                if waiting then completion:Fire() end
            end)
            task.delay(timeoutSeconds, function()
                if waiting then completion:Fire() end
            end)

            completion.Event:Wait()
            waiting = false
            completion:Destroy()

            if not finished then
                error("请求超时（" .. tostring(timeoutSeconds) .. " 秒）")
            end
            if not requestOk then
                error(tostring(result))
            end
            return result
        end

