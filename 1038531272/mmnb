                    end
                    if objects.outline then
                        objects.outline.Color = Color3.fromRGB(0, 0, 0)
                        objects.outline.Filled = true
                    end
                    DrawingState.Health.Objects[player] = objects
                end
                if objects.bar and objects.outline and min2D and max2D then
                    local height = max2D.Y - min2D.Y
                    local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                    local barHeight = height * ratio
                    objects.outline.Size = Vector2.new(4, height + 2)
                    objects.outline.Position = Vector2.new(min2D.X - 6, min2D.Y - 1)
                    objects.outline.Visible = true
                    objects.bar.Size = Vector2.new(2, barHeight)
                    objects.bar.Position = Vector2.new(min2D.X - 5, max2D.Y - barHeight)
                    objects.bar.Color = Color3.fromRGB(255 * (1 - ratio), 255 * ratio, 0)
                    objects.bar.Visible = true
                elseif objects.bar and objects.outline then
                    objects.bar.Visible = false
                    objects.outline.Visible = false
                end
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("血量条透视", "已开启")
end

local function clearSkeleton()
    DrawingState.Skeleton.Update = nil
    for _, skeleton in pairs(DrawingState.Skeleton.Objects) do
        for _, line in pairs(skeleton) do
            removeDrawing(line)
        end
    end
    DrawingState.Skeleton.Objects = {}
    refreshDrawingLoop()
end

local function setSkeletonEnabled(enabled)
    DrawingState.Skeleton.Enabled = enabled
    clearSkeleton()
    if not enabled then
        drawingNotify("骨骼透视", "已关闭")
        return
    end
    if not drawingSupported() then
        DrawingState.Skeleton.Enabled = false
        drawingNotify("骨骼透视", "当前执行器不支持 Drawing")
        return
    end

    local function makeLine()
        local line = newDrawing("Line")
        if line then
            line.Color = Color3.fromRGB(255, 255, 255)
            line.Thickness = 1
        end
        return line
    end

    DrawingState.Skeleton.Update = function(players)
        pruneDrawingObjects(DrawingState.Skeleton, players)
        local camera = getDrawingCamera()
        if not camera then return end
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local parts = {
                    head = character:FindFirstChild("Head"),
                    upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"),
                    lower = character:FindFirstChild("LowerTorso") or character:FindFirstChild("HumanoidRootPart"),
                    left_arm = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm"),
                    right_arm = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm"),
                    left_leg = character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg"),
                    right_leg = character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg"),
                }
                local skeleton = DrawingState.Skeleton.Objects[player]
                if not skeleton then
                    skeleton = {
                        head = makeLine(), torso = makeLine(), left_arm = makeLine(),
                        right_arm = makeLine(), left_leg = makeLine(), right_leg = makeLine(),
                    }
                    DrawingState.Skeleton.Objects[player] = skeleton
                end

                local valid = true
                local screen = {}
                for name, part in pairs(parts) do
                    if not part then
                        valid = false
                        break
                    end
                    local position, onScreen = camera:WorldToViewportPoint(part.Position)
                    screen[name] = {Position = Vector2.new(position.X, position.Y), Visible = onScreen and position.Z > 0}
                    if not screen[name].Visible then valid = false end
                end

                if valid then
                    local pairsToDraw = {
                        {"head", "upper"}, {"upper", "lower"}, {"upper", "left_arm"},
                        {"upper", "right_arm"}, {"lower", "left_leg"}, {"lower", "right_leg"},
                    }
                    local names = {"head", "torso", "left_arm", "right_arm", "left_leg", "right_leg"}
                    for index, pair in ipairs(pairsToDraw) do
                        local line = skeleton[names[index]]
                        if line then
                            line.From = screen[pair[1]].Position
                            line.To = screen[pair[2]].Position
                            line.Visible = true
                        end
                    end
                else
                    for _, line in pairs(skeleton) do
                        if line then line.Visible = false end
                    end
                end
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("骨骼透视", "已开启")
end

local function clearTracers()
    DrawingState.Tracers.Update = nil
    for _, line in pairs(DrawingState.Tracers.Objects) do
        removeDrawing(line)
    end
    DrawingState.Tracers.Objects = {}
    refreshDrawingLoop()
end

local function setTracersEnabled(enabled)
    DrawingState.Tracers.Enabled = enabled
    clearTracers()
    if not enabled then
        drawingNotify("射线透视", "已关闭")
        return
    end
    if not drawingSupported() then
        DrawingState.Tracers.Enabled = false
        drawingNotify("射线透视", "当前执行器不支持 Drawing")
        return
    end

    DrawingState.Tracers.Update = function(players)
        pruneDrawingObjects(DrawingState.Tracers, players)
        local camera = getDrawingCamera()
        if not camera then return end
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local line = DrawingState.Tracers.Objects[player]
                if not line then
                    line = newDrawing("Line")
                    if line then
                        line.Color = Color3.fromRGB(255, 255, 255)
                        line.Thickness = 1
                        DrawingState.Tracers.Objects[player] = line
                    end
                end
                if line then
                    local position, onScreen = camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                    line.From = Vector2.new(camera.ViewportSize.X / 2, 0)
                    line.To = Vector2.new(position.X, position.Y)
                    line.Visible = onScreen and position.Z > 0
                end
            else
                hideDrawingObject(DrawingState.Tracers.Objects[player])
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("射线透视", "已开启")
end

