        local function detectImageExtension(url, body)
            local lowerUrl = tostring(url or ""):lower()
            if lowerUrl:find(".png", 1, true) then
                return ".png"
            elseif lowerUrl:find(".webp", 1, true) then
                return ".webp"
            elseif lowerUrl:find(".gif", 1, true) then
                return ".gif"
            elseif lowerUrl:find(".jpeg", 1, true) then
                return ".jpeg"
            end
            if type(body) == "string" then
                if body:sub(1, 8) == string.char(137, 80, 78, 71, 13, 10, 26, 10) then
                    return ".png"
                elseif body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP" then
                    return ".webp"
                elseif body:sub(1, 6) == "GIF87a" or body:sub(1, 6) == "GIF89a" then
                    return ".gif"
                elseif body:sub(1, 2) == string.char(255, 216) then
                    return ".jpg"
                end
            end
            return ".jpg"
        end

        local function downloadTemporaryImage(imageUrl, prefix)
            local assetLoader = getcustomasset or getsynasset
            if type(assetLoader) ~= "function"
