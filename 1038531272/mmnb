--==================================================
-- WindUI 官方配置管理器：保存并自动读取主题、按键等控件配置
--==================================================
local ConfigManager = Window.ConfigManager
local ConfigName = "default"
local ConfigFile = nil

local function getWindUIConfig()
    if not ConfigManager then
        return nil
    end

    if not ConfigFile then
        ConfigFile = ConfigManager:CreateConfig(ConfigName)
        if ConfigFile then
            ConfigFile:Register("ThemeSelection", themeDropdown)
            ConfigFile:Register("PCWindowToggleKey", pcToggleKeybind)
        end
    end

    return ConfigFile
end

local function saveWindUIConfig()
    local config = getWindUIConfig()
    if not config then
        return false
    end

    local ok, result = pcall(function()
        return config:Save()
    end)
    return ok and result == true
end

local function loadWindUIConfig()
    local config = getWindUIConfig()
    if not config then
        return false
    end

    local ok, result = pcall(function()
        return config:Load()
    end)
    return ok and result ~= nil
end

if ConfigManager then
    ConfigManager:Init(Window)
    getWindUIConfig()

    SettingTab:Section({
        Title = "配置保存",
    })

    SettingTab:Button({
        Title = "保存主题和控件配置",
        Desc = "保存当前主题、PC 按键和已注册控件；下次启动会自动读取",
        Icon = "solar:diskette-bold-duotone",
        Callback = function()
            if saveWindUIConfig() then
                WindUI:Notify({
                    Title = "配置已保存",
                    Content = "主题和控件配置已保存到 default",
                    Duration = 3,
                })
            else
                WindUI:Notify({
                    Title = "保存失败",
                    Content = "WindUI ConfigManager 不可用或配置保存失败",
                    Duration = 4,
                })
            end
        end,
    })

    SettingTab:Button({
        Title = "立即读取已保存配置",
        Desc = "手动恢复上次保存的主题和控件配置",
        Icon = "solar:folder-open-bold-duotone",
        Callback = function()
            if loadWindUIConfig() then
                WindUI:Notify({
                    Title = "配置已读取",
                    Content = "已恢复 default 配置",
                    Duration = 3,
                })
            else
                WindUI:Notify({
                    Title = "读取失败",
                    Content = "暂未找到可读取的配置文件",
                    Duration = 4,
                })
            end
        end,
    })

    task.defer(function()
        if loadWindUIConfig() then
            WindUI:Notify({
                Title = "配置已自动读取",
                Content = "已恢复上次保存的主题和控件设置",
                Duration = 3,
            })
        end
    end)

    Window:OnClose(function()
        saveWindUIConfig()
    end)

    Window:OnDestroy(function()
        saveWindUIConfig()
    end)
else
    SettingTab:Paragraph({
        Title = "配置管理器不可用",
        Desc = "当前 WindUI 版本未提供 ConfigManager，无法保存主题配置",
        Icon = "solar:danger-triangle-bold-duotone",
    })
end

_G.__XLHubCleanup = function()
    if ImageWindowCleanup then
        pcall(ImageWindowCleanup)
        ImageWindowCleanup = nil
    end
    ImageReloadCurrent = nil

    if TranslatorCleanup then
        pcall(TranslatorCleanup)
    end

    if GeneralState and GeneralState.CharacterConnection then
        pcall(function() GeneralState.CharacterConnection:Disconnect() end)
        GeneralState.CharacterConnection = nil
    end

    if TeleportState then
        for _, connectionName in ipairs({"PlayerAddedConnection", "PlayerRemovingConnection"}) do
            local connection = TeleportState[connectionName]
            if connection then
                pcall(function() connection:Disconnect() end)
                TeleportState[connectionName] = nil
            end
        end
    end

    if DrawingState then
        if DrawingState.RenderConnection then
            pcall(function() DrawingState.RenderConnection:Disconnect() end)
            DrawingState.RenderConnection = nil
        end
        if DrawingState.PlayerRemovingConnection then
            pcall(function() DrawingState.PlayerRemovingConnection:Disconnect() end)
            DrawingState.PlayerRemovingConnection = nil
        end
        for _, category in ipairs(DrawingCategories) do
            category.Enabled = false
            category.Update = nil
            for player, object in pairs(category.Objects) do
                removeDrawingObject(object)
                category.Objects[player] = nil
            end
        end
    end

    pcall(function()
        if Window and Window.Destroy then
            Window:Destroy()
        end
    end)
end

