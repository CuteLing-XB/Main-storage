local function setBoxesEnabled(enabled)
    DrawingState.Boxes.Enabled = enabled
    clearBoxes()
    if not enabled then
        drawingNotify("方框透视", "已关闭")
        return
    end
    if not drawingSupported() then
        DrawingState.Boxes.Enabled = false
        drawingNotify("方框透视", "当前执行器不支持 Drawing")
        return
    end

    DrawingState.Boxes.Update = function(players)
        pruneDrawingObjects(DrawingState.Boxes, players)
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character then
                local min2D, max2D = getScreenBounds(player.Character)
                local objects = DrawingState.Boxes.Objects[player]
                if not objects then
                    objects = {box = newDrawing("Square"), outline = newDrawing("Square")}
                    if objects.box then
                        objects.box.Color = Color3.fromRGB(255, 255, 255)
                        objects.box.Thickness = 1
                        objects.box.Filled = false
                    end
                    if objects.outline then
                        objects.outline.Color = Color3.fromRGB(0, 0, 0)
                        objects.outline.Thickness = 3
                        objects.outline.Filled = false
                    end
                    DrawingState.Boxes.Objects[player] = objects
                end

                if objects.box and objects.outline and min2D and max2D then
                    local size = max2D - min2D
                    objects.box.Position = min2D
                    objects.box.Size = size
                    objects.box.Visible = true
                    objects.outline.Position = min2D
                    objects.outline.Size = size
                    objects.outline.Visible = true
                elseif objects.box and objects.outline then
                    objects.box.Visible = false
                    objects.outline.Visible = false
                end
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("方框透视", "已开启")
end

