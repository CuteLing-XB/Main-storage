        local function addResizeHandle(frame, connectFunc, minWidth, minHeight, maxWidth, maxHeight, onResize)
            local handle = Instance.new("TextButton")
            handle.Name = "ResizeHandle"
            handle.Parent = frame
            handle.AnchorPoint = Vector2.new(1, 1)
            handle.Position = UDim2.new(1, -4, 1, -4)
            handle.Size = UDim2.fromOffset(28, 28)
            handle.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
            handle.BackgroundTransparency = 0.08
            handle.BorderSizePixel = 0
            handle.AutoButtonColor = false
            handle.Text = "◢"
            handle.TextColor3 = Color3.fromRGB(255, 255, 255)
            handle.TextSize = 17
            handle.Font = Enum.Font.SourceSansBold
            handle.Active = true
            handle.Selectable = false
            handle.ZIndex = 100

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 5)
            corner.Parent = handle

            local resizing = false
            local resizeStart
            local startSize

            local function beginResize(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                resizing = true
                resizeStart = input.Position
                startSize = frame.AbsoluteSize
            end

            local function moveResize(input)
                if not resizing or not resizeStart or not startSize then
                    return
                end
                local delta = input.Position - resizeStart
                local width = math.clamp(startSize.X + delta.X, minWidth, maxWidth)
                local height = math.clamp(startSize.Y + delta.Y, minHeight, maxHeight)
                if onResize then
                    onResize(width, height)
                else
                    frame.Size = UDim2.fromOffset(width, height)
                end
            end

            connectFunc(handle.InputBegan, beginResize)
            connectFunc(UserInputService.InputChanged, function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    moveResize(input)
                end
            end)
            connectFunc(UserInputService.TouchMoved, moveResize)
            connectFunc(UserInputService.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    resizing = false
                    resizeStart = nil
                    startSize = nil
                end
            end)

            return handle
        end

