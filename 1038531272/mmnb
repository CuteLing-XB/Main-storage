local function clearHealth()
    if DrawingState.Health.Connection then
        DrawingState.Health.Connection:Disconnect()
        DrawingState.Health.Connection = nil
    end
    for _, objects in pairs(DrawingState.Health.Objects) do
        removeDrawing(objects.bar)
        removeDrawing(objects.outline)
    end
    DrawingState.Health.Objects = {}
