local function NewDrawing(class, props)
    if not HasDrawing then return nil end
    local ok, obj = pcall(function()
        return Drawing.new(class)
    end)
    if not ok or not obj then return nil end
    for k, v in pairs(props or {}) do
        pcall(function() obj[k] = v end)
    end
    return obj
end

local PhantomDrawingPropertyCache = setmetatable({}, {__mode = "k"})
local function SetDrawingProperty(obj, property, value)
    if not obj then return end
    local cache = PhantomDrawingPropertyCache[obj]
    if not cache then
        cache = {}
        PhantomDrawingPropertyCache[obj] = cache
    end
    if cache[property] == value then return end
    cache[property] = value
    pcall(function() obj[property] = value end)
end

local function Hide(obj)
    if not obj then return end
    local cache = PhantomDrawingPropertyCache[obj]
    if cache then cache.Visible = false end
    pcall(function() obj.Visible = false end)
end

local function DestroyDrawing(obj)
    if obj then
        pcall(function() obj.Visible = false end)
        pcall(function() obj:Remove() end)
    end
end

