local function playDingSound()
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9114223297"
        sound.Volume = 1.0
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function() 
            sound:Destroy() 
        end)
    end)
end

local function Loader()
    -- 自动匹配 PlaceId 或 GameId
    local target = Config[game.PlaceId] or Config[game.GameId]
    
    if target and target.scripts then
        local loaded = false
        
        for idx, url in ipairs(target.scripts) do
            if url and url ~= "" then
                -- 核心精简加载逻辑
                pcall(function()
                    loadstring(game:HttpGet(url))()
                end)
                print("[" .. target.name .. "] 已加载脚本 " .. idx)
                loaded = true
            end
        end
        
        if loaded then
            print("【" .. target.name .. "] 所有脚本加载完成！")
            playDingSound()
        end
    else
        print("未匹配到当前游戏配置 (PlaceId: " .. game.PlaceId .. " / GameId: " .. game.GameId .. ")")
    end
end

Loader()
