        -- ESP 更新（降频到每2帧，减少性能开销）
        local function AimUpdateESP()
            AimESPFrameCount = AimESPFrameCount + 1
            if AimESPFrameCount < 2 then return end
            AimESPFrameCount = 0

            for player, obj in pairs(AimESPObjects) do
                if not player.Parent then
                    pcall(function() obj:Destroy() end)
                    AimESPObjects[player] = nil
                else
                    obj.Adornee = player.Character
                    obj.Enabled = AimConfig.ESP and AimValidTarget(player)
                end
            end
            if not AimConfig.ESP then return end
            for _, player in ipairs(AimPlayerList) do
                if player ~= AimLocalPlayer then
                    AimCreateESP(player)
                end
            end
        end

