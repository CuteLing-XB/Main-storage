local API_URL = "https://gh-jkll.onrender.com/api/bind-hwid"
local AUTH_SECRET = "XiaoLin666"
local SAVE_FILE_NAME = "MyScriptKey.txt"

local function getHWID()
    local hwid = "UNKNOWN_HWID"
    pcall(function()
        hwid = RbxAnalyticsService:GetClientId()
    end)
    return hwid
end

local function VerifyKeyWithServer(enteredKey)
    if not enteredKey or enteredKey == "" then
        return false, "请输入有效卡密！"
    end

    local payload = {
        key = enteredKey,
        hwid = getHWID(),
        username = LocalPlayer.Name,
        secret = AUTH_SECRET
    }
    
    local requestData = {
        Url = API_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode(payload)
    }
    
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    
    if not httpRequest then
        return false, "当前执行器不支持 HTTP 请求"
    end
    
    local success, result = pcall(function()
        return httpRequest(requestData)
    end)
    
    if success and result and result.Body then
        local jsonSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(result.Body)
        end)
        if jsonSuccess and decoded then
            return decoded.success, decoded.message
        end
    end
    
    return false, "无法连接卡密服务器，请稍后再试"
end

local function getSavedKey()
    if isfile and isfile(SAVE_FILE_NAME) then
        return readfile(SAVE_FILE_NAME)
    end
    return nil
end

local function saveKeyLocally(key)
    if writefile then
        writefile(SAVE_FILE_NAME, key)
    end
end

