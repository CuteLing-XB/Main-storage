local IMAGE_CACHE_FOLDER = "XLHub_ImageCache"
local TemporaryImageSequence = 0

local function addRequestCandidate(list, candidate)
    if type(candidate) == "function" then
        list[#list + 1] = candidate
    end
end

local function getRequestCandidates()
    local candidates = {}
    addRequestCandidate(candidates, rawget(_G, "request"))
    addRequestCandidate(candidates, rawget(_G, "http_request"))
    local synTable = rawget(_G, "syn")
    if type(synTable) == "table" then
        addRequestCandidate(candidates, synTable.request)
    end
    local httpTable = rawget(_G, "http")
    if type(httpTable) == "table" then
        addRequestCandidate(candidates, httpTable.request)
    end
    return candidates
end

local function requestHttpBody(url, accept)
    if type(url) ~= "string" or url == "" then
        error("图片地址为空")
    end
    local errors = {}
    local headers = {
        ["Accept"] = accept or "application/json",
        ["User-Agent"] = "XLHub/2.0 WindUI image client",
    }
    for _, requestFunction in ipairs(getRequestCandidates()) do
        local ok, response = pcall(function()
            return requestFunction({
                Url = url,
                Method = "GET",
                Headers = headers,
            })
        end)
        if ok then
            if type(response) == "string" and response ~= "" then
                return response
            end
            if type(response) == "table" then
                local body = response.Body or response.body
                if type(body) == "string" and body ~= "" then
                    return body
                end
                errors[#errors + 1] = "执行器返回空 Body"
            else
                errors[#errors + 1] = "执行器返回格式不是字符串或响应表"
            end
        else
            errors[#errors + 1] = tostring(response)
        end
    end

    if game then
        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(body) == "string" and body ~= "" then
            return body
        end
        errors[#errors + 1] = ok and "game:HttpGet 返回空内容" or tostring(body)
    else
        errors[#errors + 1] = "当前环境没有 game 对象"
    end
    error("请求失败：" .. table.concat(errors, " | "))
end

local function ensureImageCacheFolder()
    if type(makefolder) ~= "function" then
        return false
    end
    if type(isfolder) == "function" then
        local ok, exists = pcall(isfolder, IMAGE_CACHE_FOLDER)
        if ok and exists then
            return true
        end
    end
    local ok = pcall(makefolder, IMAGE_CACHE_FOLDER)
    if ok then
        return true
    end
    return type(isfolder) ~= "function"
end

local function deleteTemporaryImage(fileName)
    if type(fileName) == "string" and fileName ~= "" and type(delfile) == "function" then
        pcall(delfile, fileName)
    end
end

local function detectImageExtension(url, body)
    local lowerUrl = tostring(url or ""):lower()
    if lowerUrl:find(".png", 1, true) then
        return ".png"
    elseif lowerUrl:find(".webp", 1, true) then
        return ".webp"
    elseif lowerUrl:find(".gif", 1, true) then
        return ".gif"
    elseif lowerUrl:find(".jpeg", 1, true) then
        return ".jpeg"
    end
    if type(body) == "string" then
        if body:sub(1, 8) == string.char(137, 80, 78, 71, 13, 10, 26, 10) then
            return ".png"
        elseif body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP" then
            return ".webp"
        elseif body:sub(1, 6) == "GIF87a" or body:sub(1, 6) == "GIF89a" then
            return ".gif"
        elseif body:sub(1, 2) == string.char(255, 216) then
            return ".jpg"
        end
    end
    return ".jpg"
end

local function downloadTemporaryImage(imageUrl, prefix)
    local assetLoader = getcustomasset or getsynasset
    if type(assetLoader) ~= "function"
        or type(writefile) ~= "function"
        or type(delfile) ~= "function"
        or not ensureImageCacheFolder() then
        return "", "", false
    end

    local body = requestHttpBody(imageUrl, "image/*")
    local extension = detectImageExtension(imageUrl, body)
    TemporaryImageSequence = TemporaryImageSequence + 1
    local fileName = IMAGE_CACHE_FOLDER .. "/"
        .. (prefix or "XLHub_CurrentImage_")
        .. tostring(TemporaryImageSequence) .. extension
    local writeOk = pcall(function()
        writefile(fileName, body)
    end)
    if not writeOk then
        return "", "", false
    end

    -- 关键点：写入后直接使用刚写入的相对路径读取，不扫描、不猜文件名。
    local assetOk, assetId = pcall(assetLoader, fileName)
    if assetOk and type(assetId) == "string" and assetId ~= "" then
        return assetId, fileName, true
    end
    deleteTemporaryImage(fileName)
    return "", "", false
end

