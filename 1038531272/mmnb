local function ResetCharacter(player)
    local old = PhantomCharacterCache[player]
    if old and old.HealthConnection then
        pcall(function() old.HealthConnection:Disconnect() end)
    end
    PhantomCharacterCache[player] = {
        Character = nil,
        Humanoid = nil,
        Root = nil,
        Head = nil,
        Ready = false,
        Status = "RESPAWNING",
        LastRatio = 1
    }
    PhantomSmoothHealth[player] = 1
    TrailHistory[player] = {}
    PhantomDamageCache[player] = {Previous = nil, Value = 0, Time = 0}
end

local function BindCharacter(player, character)
    ResetCharacter(player)
    local state = PhantomCharacterCache[player]
    state.Character = character
    state.Status = "RESPAWNING"

    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then humanoid = character:WaitForChild("Humanoid", 5) end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then root = character:WaitForChild("HumanoidRootPart", 5) end
        local head = character:FindFirstChild("Head")

        if player.Character ~= character or not humanoid or not root then
            return
        end

        local untilTime = os.clock() + 5
        while os.clock() < untilTime do
            if player.Character ~= character then return end
            if humanoid.Parent and root.Parent and humanoid.MaxHealth > 0 then break end
            task.wait()
        end

        if player.Character ~= character or not humanoid.Parent or not root.Parent then
            return
        end

        state.Humanoid = humanoid
        state.Root = root
        state.Head = head or character:FindFirstChild("Head")
        state.Ready = humanoid.MaxHealth > 0
        state.Status = (humanoid.Health > 0) and "ALIVE" or "DEAD"

        local ratio = 1
        if humanoid.MaxHealth > 0 then
            ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
        end
        state.LastRatio = ratio
        PhantomSmoothHealth[player] = ratio
        PhantomDamageCache[player].Previous = humanoid.Health

        state.HealthConnection = humanoid.HealthChanged:Connect(function(h)
            if player.Character ~= character or state.Humanoid ~= humanoid then return end
            local maxH = humanoid.MaxHealth
            if type(h) == "number" and type(maxH) == "number" and maxH > 0 then
                local previous = PhantomDamageCache[player].Previous
                local damage = previous and math.max(previous - h, 0) or 0
                PhantomDamageCache[player].Previous = h
                if damage > 0 then
                    PhantomDamageCache[player].Value = damage
                    PhantomDamageCache[player].Time = os.clock()
                end
                state.LastRatio = math.clamp(h / maxH, 0, 1)
                state.Status = h > 0 and "ALIVE" or "DEAD"
            end
        end)
    end)
end

local function GetSafeRatio(player)
    local s = PhantomCharacterCache[player]
    if not s or not s.Ready or player.Character ~= s.Character or not s.Humanoid then
        return nil, false
    end
    local h = s.Humanoid.Health
    local mh = s.Humanoid.MaxHealth
    if type(h) ~= "number" or type(mh) ~= "number" or mh <= 0 or h <= 0 then
        return 0, false
    end
    local ratio = math.clamp(h / mh, 0, 1)
    s.LastRatio = ratio
    return ratio, true
end


local function SmoothValue(old, target, amount)
    if old == nil then return target end
    amount = math.clamp(amount or 0.22, 0.05, 1)
    return old + (target - old) * amount
end

local function HealthColor(ratio)
    ratio = math.clamp(ratio, 0, 1)
    if ratio > 0.5 then
        local t = (ratio - 0.5) / 0.5
        return Color3.fromRGB(255 - math.floor(175 * t), 255, 50)
    end
    local t = ratio / 0.5
    return Color3.fromRGB(255, math.floor(60 + 175 * t), 45)
end

