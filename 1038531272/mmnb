    local function cleanImageUrl(value)
        if type(value) ~= "string" then
            return ""
        end
        value = value:gsub("^%s+", ""):gsub("%s+$", "")
        if value:sub(1, 2) == "//" then
            value = "https:" .. value
        end
        if value:match("^https?://") then
            return value
        end
        return ""
    end

    local function parseImageResponse(source, body)
        local decodedOk, decoded = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not decodedOk or type(decoded) ~= "table" then
            error(source.Name .. " 返回的不是有效 JSON")
        end

        local imageUrl = ""
        if source.Parser == "Nekosia" then
            if decoded.success ~= true or tonumber(decoded.status) ~= 200 then
                error(source.Name .. " 返回错误：" .. tostring(decoded.message or decoded.status))
            end
            imageUrl = decoded.image
                and decoded.image.compressed
                and decoded.image.compressed.url
        elseif source.Parser == "Waifu" then
            local first = decoded.items and decoded.items[1]
            imageUrl = first and first.url
        elseif source.Parser == "NekosBest" then
            local first = decoded.results and decoded.results[1]
            imageUrl = first and first.url
        elseif source.Parser == "PurrBot" then
            if decoded.error == true or tonumber(decoded["response-code"]) ~= 200 then
                error(source.Name .. " 返回错误：" .. tostring(decoded.error or decoded["response-code"]))
            end
            imageUrl = decoded.link
        end

        imageUrl = cleanImageUrl(imageUrl)
        if imageUrl == "" then
            error(source.Name .. " 未返回有效的图片地址")
        end
        return imageUrl
    end

    local function requestSourceBody(source)
        local requestFunctions = {}
        local function addRequestFunction(candidate)
            if type(candidate) == "function" then
                requestFunctions[#requestFunctions + 1] = candidate
            end
        end

        addRequestFunction(rawget(_G, "request"))
        addRequestFunction(rawget(_G, "http_request"))

        local synTable = rawget(_G, "syn")
        if type(synTable) == "table" then
            addRequestFunction(synTable.request)
        end

        local httpTable = rawget(_G, "http")
        if type(httpTable) == "table" then
            addRequestFunction(httpTable.request)
        end

        local requestHeaders = {
            ["Accept"] = "application/json",
            ["User-Agent"] = "XLHub/1.0 (NekosBest-compatible client)",
        }
        for _, requestFunction in ipairs(requestFunctions) do
            local requestOk, response = pcall(function()
                return requestFunction({
                    Url = source.Url,
                    Method = "GET",
                    Headers = requestHeaders,
                })
            end)
            if requestOk and type(response) == "table" then
                local body = response.Body or response.body
                if type(body) == "string" and body ~= "" then
                    return body
                end
            end
        end

        local body = game:HttpGet(source.Url)
        if type(body) ~= "string" or body == "" then
            error(source.Name .. " 返回为空")
        end
        return body
    end

    local function requestImageFromSelectedSource()
        local source = IMAGE_SOURCES[currentImageSourceIndex]
        if not source then
            error("没有选择有效的图片源")
        end
        local body = requestSourceBody(source)
        return parseImageResponse(source, body), source.Name
    end

    local function loadImageAsset(imageUrl)
        local assetLoader = getcustomasset or getsynasset
        if type(assetLoader) ~= "function" or type(writefile) ~= "function" then
            return imageUrl
        end

        if currentImageAsset ~= "" and type(delfile) == "function" then
            pcall(delfile, currentImageAsset)
            currentImageAsset = ""
        end

        local extension = imageUrl:lower():match("%.png") and ".png" or ".jpg"
        local fileName = "XLHub_Catgirl_" .. tostring(math.random(100000, 999999)) .. extension
        local body = nil
        local requestFunctions = {}
        local function addRequestFunction(candidate)
            if type(candidate) == "function" then
                requestFunctions[#requestFunctions + 1] = candidate
            end
        end

        addRequestFunction(rawget(_G, "request"))
        addRequestFunction(rawget(_G, "http_request"))
        local synTable = rawget(_G, "syn")
        if type(synTable) == "table" then
            addRequestFunction(synTable.request)
        end

        for _, requestFunction in ipairs(requestFunctions) do
            local requestOk, response = pcall(function()
                return requestFunction({
                    Url = imageUrl,
                    Method = "GET",
                    Headers = { ["Accept"] = "image/*" },
                })
            end)
            if requestOk and type(response) == "table" then
                local responseBody = response.Body or response.body
                if type(responseBody) == "string" and responseBody ~= "" then
                    body = responseBody
                    break
                end
            end
        end

        if not body then
            local httpOk, responseBody = pcall(function()
                return game:HttpGet(imageUrl)
            end)
            if httpOk and type(responseBody) == "string" and responseBody ~= "" then
                body = responseBody
            end
        end

        if not body then
            return imageUrl
        end

        local writeOk = pcall(function()
            writefile(fileName, body)
        end)
        if not writeOk then
            return imageUrl
        end

        local assetOk, assetId = pcall(assetLoader, fileName)
        if assetOk and type(assetId) == "string" and assetId ~= "" then
            currentImageAsset = fileName
            ImageAssetFile = fileName
            return assetId
        end
        if type(delfile) == "function" then
            pcall(delfile, fileName)
        end
        return imageUrl
    end

    local function loadImage()
        if destroyed then
            return
        end

        cover.Visible = true
        cover.Image = ""
        coverText.Text = "正在请求图片..."
        setImageStatus(status, "正在连接图片源...", Color3.fromRGB(255, 215, 0))
        nextButton.Text = "请求中"

        task.spawn(function()
            local ok, result, sourceName = pcall(requestImageFromSelectedSource)

            if destroyed then
                return
            end

            nextButton.Text = "下一张"
            if not ok or type(result) ~= "string" or result == "" then
                coverText.Text = "图片请求失败"
                setImageStatus(status, "请求失败：" .. tostring(result), Color3.fromRGB(255, 120, 120))
                return
            end

            currentImageUrl = result
            coverText.Text = "图片加载中..."
            local displayImage = loadImageAsset(currentImageUrl)
            imageFrame.Image = displayImage
            imageFrame.ScaleType = Enum.ScaleType.Fit
            imageFrame.ImageTransparency = 0
            imageFrame.Visible = true
            imageFrame.ZIndex = 4
            cover.Visible = false
            setImageStatus(status, sourceName .. "已显示", Color3.fromRGB(180, 255, 180))
        end)
    end

    connect(closeButton.MouseButton1Click, cleanupImageWindow)
    connect(nextButton.MouseButton1Click, function()
        loadImage()
    end)
    sourceButton.Text = "刷新当前"
    connect(sourceButton.MouseButton1Click, function()
        loadImage()
    end)
    connect(pauseButton.MouseButton1Click, function()
        loadImage()
    end)
    ImageReloadCurrent = loadImage
    loadImage()
end

