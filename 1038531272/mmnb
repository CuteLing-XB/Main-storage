local function OffscreenArrow(world)
    local viewport = PhantomCamera.ViewportSize
    local centerX, centerY = viewport.X * 0.5, viewport.Y * 0.5
    local point, onScreen = PhantomCamera:WorldToViewportPoint(world)
    if onScreen then return nil end

    local dx, dy = point.X - centerX, point.Y - centerY
    local length = math.sqrt(dx * dx + dy * dy)
    if length < 0.01 then
        dx, dy, length = 0, -1, 1
    end
    dx, dy = dx / length, dy / length
    local radius = math.min(viewport.X, viewport.Y) * 0.38
    local tipX, tipY = centerX + dx * radius, centerY + dy * radius
    local baseX, baseY = tipX - dx * 18, tipY - dy * 18
    local sideX, sideY = -dy * 10, dx * 10

    return Vector2.new(tipX, tipY),
        Vector2.new(baseX + sideX, baseY + sideY),
        Vector2.new(baseX - sideX, baseY - sideY)
end

