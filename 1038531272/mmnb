do
    -- 使用固定命名空间；重复执行脚本时先停止旧实例，避免旧连接和队列继续驻留。
    local MY_NAMESPACE = "EnhancedTranslator"
    local previousEngine = _G[MY_NAMESPACE]
    if previousEngine and type(previousEngine.stop) == "function" then
        pcall(previousEngine.stop)
    end

    local Engine = {
        textData = {},
        scannedElements = setmetatable({}, {__mode = "k"}),
        monitoredElements = setmetatable({}, {__mode = "k"}),
        lastSeenText = setmetatable({}, {__mode = "k"}),
        applyingElements = setmetatable({}, {__mode = "k"}),
        ignoreNextText = setmetatable({}, {__mode = "k"}),
        monitorRecords = {},
        monitorRecordByElement = setmetatable({}, {__mode = "k"}),
        containerConnections = setmetatable({}, {__mode = "k"}),
        monitorConnections = {},
        translateQueue = {},
        queueHead = 1,
        queuedSet = {},
        isRunning = false,
        extractCount = 0,
        translateCount = 0,
        localizeCount = 0,
        textDataCount = 0,
    }
    _G[MY_NAMESPACE] = Engine

    local RUNTIME = {
        translationAPI = "Google",
        translationsPerSecond = 20,
        batchSize = 5,
        minTextLength = 2,
        maxTextLength = 100,
        maxTextCache = 2000,
        filterOfficial = true,
    }

    local function isTextElement(element)
        return element and (
            element:IsA("TextLabel")
            or element:IsA("TextButton")
            or element:IsA("TextBox")
        )
    end

    local function shouldFilterText(text)
        if not text or text:gsub("%s+", "") == "" then
            return true
        end
        if text:match("^[%p%s]+$") then
            return true
        end
        if #text < RUNTIME.minTextLength or #text > RUNTIME.maxTextLength then
            return true
        end
        return false
    end

    local function isOfficialChatOrInventory(element)
        if not element or not RUNTIME.filterOfficial then
            return false
        end

        local fullName = ""
        pcall(function()
            fullName = element:GetFullName():lower()
        end)
        if fullName:find("chat")
            or fullName:find("textchat")
            or fullName:find("defaultchatsystem")
            or fullName:find("backpack")
            or fullName:find("inventory")
            or fullName:find("tool")
            or fullName:find("item") then
            return true
        end

        local parent = element.Parent
        while parent do
            local parentName = tostring(parent.Name):lower()
            if parentName:find("chat")
                or parentName:find("backpack")
                or parentName:find("inventory")
                or parentName:find("tool")
                or parentName:find("item") then
                return true
            end
            parent = parent.Parent
        end
        return false
    end

    local function translateWithGoogle(orig)
        local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=zh-CN&dt=t&q="
            .. HttpService:UrlEncode(orig)
        local body
        for retry = 1, 3 do
            local ok, result = pcall(function()
                return game:HttpGet(url)
            end)
            if ok and type(result) == "string" and result ~= "" then
                body = result
                break
            end
            if retry < 3 then
                task.wait(0.1 * retry)
            end
        end
        if not body then
            return ""
        end

        local parsedOk, parsed = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not parsedOk or type(parsed) ~= "table" or type(parsed[1]) ~= "table" then
            return ""
        end

        local parts = {}
        for _, segment in ipairs(parsed[1]) do
            if type(segment) == "table" and segment[1] then
                parts[#parts + 1] = tostring(segment[1])
            end
        end
        return table.concat(parts)
    end

    local function translateWithMyMemory(text)
        local url = "https://api.mymemory.translated.net/get?q="
            .. HttpService:UrlEncode(text) .. "&langpair=en|zh"
        local body
        for retry = 1, 2 do
            local ok, result = pcall(game.HttpGet, game, url)
            if ok and type(result) == "string" and result ~= "" then
                body = result
                break
            end
            if retry < 2 then
                task.wait(0.1)
            end
        end
        if not body then
            return ""
        end

        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
        if ok and type(decoded) == "table" and decoded.responseData then
            return tostring(decoded.responseData.translatedText or "")
        end
        return ""
    end

    local function pruneTranslationCache()
        if Engine.textDataCount < RUNTIME.maxTextCache then
            return
        end

        local oldestKey
        local oldestTime = math.huge
        for key, record in pairs(Engine.textData) do
            local hasLiveElement = false
            if record.elements then
                for element in pairs(record.elements) do
                    if element and element.Parent then
                        hasLiveElement = true
                        break
                    end
                end
            end
            local lastUsed = tonumber(record.lastUsed) or 0
            if not hasLiveElement and lastUsed < oldestTime then
                oldestKey = key
                oldestTime = lastUsed
            end
        end

        -- 如果所有缓存仍有关联控件，仍淘汰最旧项，保证缓存有硬上限。
        if not oldestKey then
            for key, record in pairs(Engine.textData) do
                local lastUsed = tonumber(record.lastUsed) or 0
                if lastUsed < oldestTime then
                    oldestKey = key
                    oldestTime = lastUsed
                end
            end
        end

        if oldestKey then
            Engine.textData[oldestKey] = nil
            Engine.textDataCount = math.max(0, Engine.textDataCount - 1)
        end
    end

    local function translateText(orig)
        if not orig or orig == "" then
            return ""
        end

        local record = Engine.textData[orig]
        if record then
            record.lastUsed = os.clock()
        end
        if record and record.translated then
            return record.translation or ""
        end
        if not record then
            pruneTranslationCache()
            record = {
                source = orig,
                translation = "",
                translated = false,
                lastUsed = os.clock(),
                elements = setmetatable({}, {__mode = "k"}),
            }
            Engine.textData[orig] = record
            Engine.textDataCount = Engine.textDataCount + 1
        end

        local translation = ""
        if RUNTIME.translationAPI == "Google" then
            translation = translateWithGoogle(orig)
            if translation == "" then
                translation = translateWithMyMemory(orig)
            end
        else
            translation = translateWithMyMemory(orig)
            if translation == "" then
                translation = translateWithGoogle(orig)
            end
        end

        if translation ~= "" and translation ~= orig then
            record.translation = translation
            Engine.translateCount = Engine.translateCount + 1
        else
            -- 与原逻辑一致：失败或无需翻译时标记为已处理，避免每次扫描重复请求。
            record.translation = orig
        end
        record.translated = true
        return record.translation
    end

    local function enqueueText(text)
        if not text or shouldFilterText(text) then
            return
        end
        local record = Engine.textData[text]
        if record then
            record.lastUsed = os.clock()
        end
        if record and record.translated then
            return
        end
        if Engine.queuedSet[text] then
            return
        end
        Engine.translateQueue[#Engine.translateQueue + 1] = text
        Engine.queuedSet[text] = true
    end

    local function gethui_enhanced()
        local guis = {}
        local seen = {}
        local function addGui(gui)
            if gui and not seen[gui] then
                seen[gui] = true
                guis[#guis + 1] = gui
            end
        end

        if type(gethui) == "function" then
            local ok, result = pcall(gethui)
            if ok then
                addGui(result)
            end
        end

        local aliases = {"get_hui", "get_container", "get_roblox_gui", "_x92a", "get_gui"}
        for _, alias in ipairs(aliases) do
            if type(_G[alias]) == "function" then
                local ok, result = pcall(_G[alias])
                if ok then
                    addGui(result)
                end
            end
        end

        local ok, coreGui = pcall(function()
            return game:GetService("CoreGui")
        end)
        if ok then
            addGui(coreGui)
        end

        if LocalPlayer then
            addGui(LocalPlayer:FindFirstChildOfClass("PlayerGui"))
        end
        return guis
    end

    local function localizeElement(element, record)
        if not element or not record or not record.translation
            or record.translation == "" or record.translation == record.source then
            return
        end
        if Engine.applyingElements[element] then
            return
        end

        local ok, currentText = pcall(function()
            return tostring(element.Text)
        end)
        if not ok or currentText == record.translation then
            return
        end

        Engine.applyingElements[element] = true
        Engine.ignoreNextText[element] = record.translation
        local changed = pcall(function()
            element.Text = record.translation
        end)
        Engine.applyingElements[element] = nil
        if changed then
            Engine.lastSeenText[element] = record.translation
            Engine.localizeCount = Engine.localizeCount + 1
        end
    end

    local function applyKnownText(text)
        local record = Engine.textData[text]
        if not record or not record.elements or not record.translated then
            return
        end
        for element in pairs(record.elements) do
            local ok = pcall(function()
                local currentText = tostring(element.Text)
                if currentText == text then
                    localizeElement(element, record)
                end
            end)
            if not ok then
                record.elements[element] = nil
            end
        end
    end

    local function extractElementText(element)
        if not isTextElement(element) or not element.Parent then
            return
        end
        if Engine.applyingElements[element] then
            return
        end
        if isOfficialChatOrInventory(element) then
            Engine.scannedElements[element] = true
            return
        end

        local ok, value = pcall(function()
            return element.Text
        end)
        if not ok or value == nil then
            return
        end
        local text = tostring(value)
        if Engine.ignoreNextText[element] == text then
            Engine.ignoreNextText[element] = nil
            Engine.lastSeenText[element] = text
            return
        end
        if shouldFilterText(text) then
            Engine.scannedElements[element] = true
            Engine.lastSeenText[element] = text
            return
        end

        if Engine.lastSeenText[element] == text then
            local existing = Engine.textData[text]
            if existing then
                existing.elements = existing.elements or setmetatable({}, {__mode = "k"})
                existing.elements[element] = true
                localizeElement(element, existing)
            end
            return
        end
        Engine.lastSeenText[element] = text
        Engine.scannedElements[element] = true

        local record = Engine.textData[text]
        if not record then
            pruneTranslationCache()
            record = {
                source = text,
                translation = "",
                translated = false,
                lastUsed = os.clock(),
                elements = setmetatable({}, {__mode = "k"}),
            }
            Engine.textData[text] = record
            Engine.textDataCount = Engine.textDataCount + 1
            Engine.extractCount = Engine.extractCount + 1
        end
        record.elements[element] = true
        if not record.translated then
            enqueueText(text)
        else
            localizeElement(element, record)
        end
    end

    local function disconnectMonitor(record)
        if not record or not record.active then
            return
        end
        record.active = false

        for _, connection in pairs({record.text, record.destroy}) do
            pcall(function()
                if connection then
                    connection:Disconnect()
                end
            end)
        end

        local element = record.element
        if element then
            Engine.monitorRecordByElement[element] = nil
            Engine.monitoredElements[element] = nil
            Engine.scannedElements[element] = nil
            Engine.lastSeenText[element] = nil
            Engine.applyingElements[element] = nil
            Engine.ignoreNextText[element] = nil
        end

        local index = record.index
        local lastIndex = #Engine.monitorRecords
        if index and index <= lastIndex then
            local lastRecord = Engine.monitorRecords[lastIndex]
            Engine.monitorRecords[index] = lastRecord
            if lastRecord and lastRecord ~= record then
                lastRecord.index = index
            end
            Engine.monitorRecords[lastIndex] = nil
        end

        -- 清掉连接对象和控件引用，避免连接回调闭包反向固定 GUI 实例。
        record.text = nil
        record.destroy = nil
        record.element = nil
        record.index = nil
    end

    local function setupElementMonitor(element)
        if not isTextElement(element) or Engine.monitoredElements[element] then
            return
        end
        if isOfficialChatOrInventory(element) then
            Engine.monitoredElements[element] = true
            return
        end

        local record = {
            element = element,
            active = true,
            text = nil,
            destroy = nil,
            index = nil,
        }
        local ok, textConnection = pcall(function()
            return element:GetPropertyChangedSignal("Text"):Connect(function()
                local currentElement = record.element
                if not record.active or not Engine.isRunning or not currentElement or not currentElement.Parent then
                    return
                end
                extractElementText(currentElement)
                local currentText = tostring(currentElement.Text or "")
                local textRecord = Engine.textData[currentText]
                if textRecord then
                    localizeElement(currentElement, textRecord)
                end
            end)
        end)
        if not ok or not textConnection then
            return
        end
        record.text = textConnection

        pcall(function()
            record.destroy = element.Destroying:Connect(function()
                disconnectMonitor(record)
            end)
        end)

        Engine.monitoredElements[element] = true
        Engine.monitorRecordByElement[element] = record
        record.index = #Engine.monitorRecords + 1
        Engine.monitorRecords[record.index] = record

    end

    local function scanAllGuiElements(force)
        force = force == true
        for _, container in ipairs(gethui_enhanced()) do
            if (not force and not Engine.isRunning) or not container then
                return
            end

            local descendants = {}
            pcall(function()
                descendants = container:GetDescendants()
            end)
            for index, desc in ipairs(descendants) do
                if not force and not Engine.isRunning then
                    return
                end
                if isTextElement(desc) then
                    extractElementText(desc)
                    setupElementMonitor(desc)
                end
                if index % 100 == 0 then
                    task.wait()
                end
            end

            if not Engine.containerConnections[container] then
                pcall(function()
                    local connection = container.DescendantAdded:Connect(function(desc)
                        if not Engine.isRunning or not isTextElement(desc) then
                            return
                        end
                        task.defer(function()
                            if Engine.isRunning and desc.Parent then
                                extractElementText(desc)
                                setupElementMonitor(desc)
                            end
                        end)
                    end)
                    Engine.containerConnections[container] = connection
                    Engine.monitorConnections[#Engine.monitorConnections + 1] = connection
                end)
            end
        end
    end

    local function compactQueue()
        if Engine.queueHead <= 128 or Engine.queueHead <= (#Engine.translateQueue / 2) then
            return
        end
        local compacted = {}
        for index = Engine.queueHead, #Engine.translateQueue do
            compacted[#compacted + 1] = Engine.translateQueue[index]
        end
        Engine.translateQueue = compacted
        Engine.queueHead = 1
    end

    local function processTranslationQueue()
        while Engine.isRunning do
            local processed = 0
            local batchLimit = math.max(1, math.floor(tonumber(RUNTIME.batchSize) or 5))
            local rate = math.max(1, tonumber(RUNTIME.translationsPerSecond) or 20)
            while Engine.isRunning and processed < batchLimit do
                local item = Engine.translateQueue[Engine.queueHead]
                if not item then
                    break
                end
                Engine.translateQueue[Engine.queueHead] = nil
                Engine.queueHead = Engine.queueHead + 1
                Engine.queuedSet[item] = nil
                translateText(item)
                applyKnownText(item)
                compactQueue()
                processed = processed + 1
                task.wait(1 / rate)
            end
            if processed == 0 then
                Engine.queueHead = 1
                task.wait(0.2)
            end
        end
    end

    local function manualRefresh()
        Engine.scannedElements = setmetatable({}, {__mode = "k"})
        Engine.lastSeenText = setmetatable({}, {__mode = "k"})
        if Engine.isRunning then
            task.spawn(scanAllGuiElements)
        end
    end

    local function resetCache()
        Engine.textData = {}
        Engine.scannedElements = setmetatable({}, {__mode = "k"})
        Engine.lastSeenText = setmetatable({}, {__mode = "k"})
        Engine.translateQueue = {}
        Engine.queueHead = 1
        Engine.queuedSet = {}
        Engine.extractCount = 0
        Engine.translateCount = 0
        Engine.localizeCount = 0
        Engine.textDataCount = 0
    end

    local function startLocalization()
        if Engine.isRunning then
            return
        end
        Engine.isRunning = true
        task.spawn(scanAllGuiElements)
        task.spawn(processTranslationQueue)
    end

    local function stopLocalization()
        if not Engine.isRunning then
            return
        end
        Engine.isRunning = false
        while #Engine.monitorRecords > 0 do
            disconnectMonitor(Engine.monitorRecords[#Engine.monitorRecords])
        end
        for _, connection in ipairs(Engine.monitorConnections) do
            pcall(function()
                if connection then
                    connection:Disconnect()
                end
            end)
        end
        Engine.monitorConnections = {}
        Engine.monitoredElements = setmetatable({}, {__mode = "k"})
        Engine.monitorRecordByElement = setmetatable({}, {__mode = "k"})
        Engine.containerConnections = setmetatable({}, {__mode = "k"})
        Engine.ignoreNextText = setmetatable({}, {__mode = "k"})
        Engine.translateQueue = {}
        Engine.queueHead = 1
        Engine.queuedSet = {}
    end

    Engine.stop = stopLocalization
    TranslatorCleanup = stopLocalization
    _G.__XLHubCleanup = function()
        pcall(stopLocalization)
        if GeneralState and GeneralState.CharacterConnection then
            pcall(function() GeneralState.CharacterConnection:Disconnect() end)
        end
    end

    HanHuaTab:Toggle({
        Title = "启用实时汉化",
        Icon = "solar:translation-bold-duotone",
        Value = false,
        Desc = "实时自动翻译 TextLabel/TextButton/TextBox（含动态内容）",
        Callback = function(value)
            if value then
                startLocalization()
            else
                stopLocalization()
            end
        end,
    })
    HanHuaTab:Dropdown({
        Title = "翻译接口",
        Icon = "solar:global-bold-duotone",
        Value = "Google",
        Values = {"Google", "MyMemory"},
        Callback = function(value)
            RUNTIME.translationAPI = value
        end,
    })
    HanHuaTab:Slider({
        Title = "翻译速度",
        Desc = "每秒处理的翻译请求数",
        Icon = "solar:bolt-bold-duotone",
        Step = 1,
        Value = {Min = 5, Max = 60, Default = 20},
        Callback = function(value)
            RUNTIME.translationsPerSecond = tonumber(value) or 20
        end,
    })
    HanHuaTab:Slider({
        Title = "批量翻译数",
        Desc = "控制队列单次处理窗口，避免并发请求堆积",
        Icon = "solar:list-check-bold-duotone",
        Step = 1,
        Value = {Min = 1, Max = 15, Default = 5},
        Callback = function(value)
            RUNTIME.batchSize = tonumber(value) or 5
        end,
    })
    HanHuaTab:Button({
        Title = "手动刷新翻译",
        Icon = "solar:refresh-bold-duotone",
        Callback = function()
            manualRefresh()
            WindUI:Notify({Title = "实时汉化", Content = "正在重新扫描并翻译 UI…", Duration = 3})
        end,
    })
    HanHuaTab:Button({
        Title = "重置翻译缓存",
        Icon = "solar:trash-bin-trash-bold-duotone",
        Callback = function()
