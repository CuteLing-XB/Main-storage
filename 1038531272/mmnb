        FETab:Button({
            Title = "C00",
            Desc = "已解锁：执行禁忌之力",
            Icon = "solar:lock-unlocked-bold-duotone",
            Callback = function()
                SafeExecute("禁忌之力", "https://raw.githubusercontent.com/CuteLing-XB/Main-storage/refs/heads/main/Chinese/%E7%A6%81%E5%BF%8C%E4%B9%8B%E5%8A%9B.txt")
            end,
        })

        -- ========== 15. 服务器脚本 Tabs ==========
        for _, server in ipairs(ServerScripts) do
            local tab = Window:Tab({
                Title = server.Name,
                Icon = server.Icon,
            })
            tab:Section({ Title = "脚本列表" })
            for _, scriptInfo in ipairs(server.Scripts) do
                tab:Button({
                    Title = scriptInfo.Name,
                    Desc = "点击直接执行",
                    Icon = "solar:bolt-bold-duotone",
                    Callback = function()
                        SafeExecute(scriptInfo.Name, scriptInfo.Url)
                    end,
                })
            end
        end

        -- ========== 16. 设置 Tab ==========
        local SettingTab = Window:Tab({
            Title = "设置",
            Icon = "solar:settings-bold-duotone",
        })
        SettingTab:Section({ Title = "透明界面设置" })
        SettingTab:Paragraph({
            Title = "透明 UI 模式",
            Desc = "已固定使用 LiquidGold 透明主题，已移除会覆盖透明度的主题切换",
        })

        local uiBackgroundNames = {}
        for _, backgroundSource in ipairs(UI_BACKGROUND_SOURCES) do
            uiBackgroundNames[#uiBackgroundNames + 1] = backgroundSource.Name
        end

        local uiBackgroundDropdown = SettingTab:Dropdown({
            Title = "UI 背景图片",
            Desc = "切换时才会下载并缓存，启动只加载第一张",
            Icon = "solar:wallpaper-bold-duotone",
            Values = uiBackgroundNames,
            Value = uiBackgroundNames[1],
            Callback = function(value)
                local selected = type(value) == "table" and value[1] or value
                for index, backgroundSource in ipairs(UI_BACKGROUND_SOURCES) do
                    if backgroundSource.Name == selected then
                        task.spawn(function()
                            local callOk, backgroundOk, backgroundError = pcall(applyUIBackground, index)
                            if callOk and backgroundOk then
                                WindUI:Notify({
                                    Title = "UI 背景已切换",
                                    Content = backgroundSource.Name .. " 已从本地缓存读取",
                                    Duration = 3,
                                })
                            else
                                WindUI:Notify({
                                    Title = "UI 背景读取失败",
                                    Content = tostring(backgroundError or "下载失败，请检查网络"),
                                    Duration = 5,
                                })
                            end
                        end)
                        break
                    end
                end
            end,
        })

        SettingTab:Section({ Title = "PC 端按键绑定" })
        local pcToggleKeybind = SettingTab:Keybind({
            Title = "自定义开关按键",
            Desc = "按下绑定键切换 XL Hub 的显示状态",
            Icon = "solar:keyboard-bold-duotone",
            Value = "RightShift",
            Flag = "PCWindowToggleKey",
            Callback = function(keyName)
                local keyCode = typeof(keyName) == "EnumItem" and keyName or Enum.KeyCode[keyName]
                if keyCode then
                    Window:SetToggleKey(keyCode)
                end
            end,
        })

        -- ========== 17. 配置管理 ==========
        local ConfigManager = Window.ConfigManager
        local ConfigName = "default"
        local ConfigFile = nil

        local function getWindUIConfig()
            if not ConfigManager then
                return nil
            end
            if not ConfigFile then
                ConfigFile = ConfigManager:CreateConfig(ConfigName)
                if ConfigFile then
                    ConfigFile:Register("UIBackgroundSelection", uiBackgroundDropdown)
                    ConfigFile:Register("PCWindowToggleKey", pcToggleKeybind)
                    for flag, control in pairs(PhantomControls) do
                        local key = string.gsub(flag, "^ESP_", "")
                        if control and not PhantomToggleControls[key] then
                            pcall(function() ConfigFile:Register(flag, control) end)
                        end
                    end
                end
            end
            return ConfigFile
        end

        local ConfigSaveBusy = false
        local function saveWindUIConfig()
            if ConfigSaveBusy or not StartupAlive then return false end
            ConfigSaveBusy = true
            local ok, result = pcall(function()
                local config = getWindUIConfig()
                if not config then return false end
                return config:Save() == true
            end)
            ConfigSaveBusy = false
            return ok and result == true
        end

        local function loadWindUIConfig()
            local config = getWindUIConfig()
            if not config then
                return false
            end
            local ok, result = pcall(function()
                local loaded = config:Load()
                if PhantomDisableAll then
                    PhantomDisableAll()
                end
                return loaded
            end)
            return ok and result ~= nil
        end

        if ConfigManager then
            local configInitOk, configInitError = pcall(function()
                ConfigManager:Init(Window)
                getWindUIConfig()
            end)
            if not configInitOk then
                warn("[XL Hub] 配置初始化跳过：" .. tostring(configInitError))
            end
            SettingTab:Section({ Title = "配置保存" })
            SettingTab:Button({
                Title = "保存控件配置",
                Desc = "保存主题、参数和按键；ESP 开关不保存",
                Icon = "solar:diskette-bold-duotone",
                Callback = function()
                    if saveWindUIConfig() then
                        WindUI:Notify({
                            Title = "配置已保存",
                            Content = "控件配置已保存到 default",
                            Duration = 3,
                        })
                    else
                        WindUI:Notify({
                            Title = "保存失败",
                            Content = "WindUI ConfigManager 不可用或配置保存失败",
                            Duration = 4,
                        })
                    end
                end,
            })
            SettingTab:Button({
                Title = "立即读取已保存配置",
                Desc = "恢复主题、参数和按键；ESP 开关需手动开启",
                Icon = "solar:folder-open-bold-duotone",
                Callback = function()
                    if loadWindUIConfig() then
                        WindUI:Notify({
                            Title = "配置已读取",
                            Content = "已恢复 default 配置",
                            Duration = 3,
                        })
                    else
                        WindUI:Notify({
                            Title = "读取失败",
                            Content = "暂未找到可读取的配置文件",
                            Duration = 4,
                        })
                    end
                end,
            })
            task.defer(function()
                task.wait(0.25)
                if not StartupAlive then return end
                local loadOk, loaded = pcall(loadWindUIConfig)
                if loadOk and loaded then
                    WindUI:Notify({
                        Title = "配置已自动读取",
                        Content = "已恢复主题、参数和按键；ESP 开关保持关闭",
                        Duration = 3,
                    })
                end
            end)
            Window:OnClose(function()
                saveWindUIConfig()
            end)
            Window:OnDestroy(function()
                saveWindUIConfig()
            end)
        else
            SettingTab:Paragraph({
                Title = "配置管理器不可用",
                Desc = "当前 WindUI 版本未提供 ConfigManager，无法保存主题配置",
                Icon = "solar:danger-triangle-bold-duotone",
            })
        end

        -- ========== 18. 清理函数 ==========
        _G.__XLHubCleanup = function()
            if not StartupAlive then return end
            StartupAlive = false
            if UIBackgroundCleanup then
                pcall(UIBackgroundCleanup)
            end
            if ImageWindowCleanup then
                pcall(ImageWindowCleanup)
                ImageWindowCleanup = nil
            end
            ImageReloadCurrent = nil
            if SidebarTransparencyCleanup then
                pcall(SidebarTransparencyCleanup)
            end
            UIBackgroundGeneration += 1
            if _G.__XLHubBootToken == BootToken then
                _G.__XLHubBootToken = nil
            end
            if GeneralState and GeneralState.CharacterConnection then
                pcall(function() GeneralState.CharacterConnection:Disconnect() end)
                GeneralState.CharacterConnection = nil
            end
            if TeleportState then
                for _, connectionName in ipairs({"PlayerAddedConnection", "PlayerRemovingConnection"}) do
                    local connection = TeleportState[connectionName]
                    if connection then
                        pcall(function() connection:Disconnect() end)
                        TeleportState[connectionName] = nil
                    end
                end
            end
            if PhantomCleanup then
                pcall(PhantomCleanup)
                PhantomCleanup = nil
            end
            pcall(function()
                if Window and Window.Destroy then
                    Window:Destroy()
                end
            end)
        end

    end, globalErrorHandler)

    if not ok then
        warn("[XL Hub] 启动异常: " .. tostring(startupErr))
    end
end

-- 安全启动
xpcall(safeStartup, function(err)
    warn("[XL Hub] 致命启动错误: " .. tostring(err))
    warn(debug.traceback())
end)
