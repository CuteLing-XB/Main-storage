            local resizing = false
            local dragStart
            local startWidth
            local startHeight

            connect(handle.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    resizing = true
                    dragStart = input.Position
                    startWidth = parent.AbsoluteSize.X
                    startHeight = parent.AbsoluteSize.Y
                    connect(input.Changed, function()
                        if input.UserInputState == Enum.UserInputState.End then
                            resizing = false
                        end
                    end)
                end
            end)

            connect(UserInputService.InputChanged, function(input)
                if resizing and dragStart and startWidth and startHeight
                    and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                    local delta = input.Position - dragStart
                    local width = math.max(minWidth, math.min(maxWidth, startWidth + delta.X))
                    local height = math.max(minHeight, math.min(maxHeight, startHeight + delta.Y))
                    onResize(width, height)
                end
            end)

            return handle
        end

