                or type(delfile) ~= "function"
                or not ensureImageCacheFolder() then
                return "", "", false
            end
            local body = requestHttpBodyWithTimeout(imageUrl, "image/*", 20)
            local extension = detectImageExtension(imageUrl, body)
            TemporaryImageSequence = TemporaryImageSequence + 1
            local fileName = IMAGE_CACHE_FOLDER .. "/"
                .. (prefix or "XLHub_CurrentImage_")
                .. tostring(TemporaryImageSequence) .. extension
            local writeOk = pcall(function()
                writefile(fileName, body)
            end)
            if not writeOk then
                return "", "", false
            end
            local assetOk, assetId = pcall(assetLoader, fileName)
            if assetOk and type(assetId) == "string" and assetId ~= "" then
                return assetId, fileName, true
            end
            deleteTemporaryImage(fileName)
            return "", "", false
        end

