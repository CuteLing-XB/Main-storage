-- 碰飞逻辑优化：移除无休止的 task.wait 死循环，改用帧事件驱动
--==================================================
local BumpFlyState = {
    Enabled = false,
    TargetPlayer = nil,
    ChatConnection = nil,
    HeartbeatConn = nil,
    MoveConn = nil,
}

local function bumpFindPlayer(text)
    text = tostring(text or ""):lower()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower():find(text) or plr.DisplayName:lower():find(text) then
            return plr
        end
    end
end

BumpFlyState.ChatConnection = LocalPlayer.Chatted:Connect(function(msg)
    if not BumpFlyState.Enabled then return end

    if msg:sub(1, 6):lower() == ";kill " then
        local name = msg:sub(7)
        BumpFlyState.TargetPlayer = bumpFindPlayer(name)
    end
end)

local function stopBumpFlyLogic()
    if BumpFlyState.HeartbeatConn then
        BumpFlyState.HeartbeatConn:Disconnect()
        BumpFlyState.HeartbeatConn = nil
    end
    if BumpFlyState.MoveConn then
        BumpFlyState.MoveConn:Disconnect()
        BumpFlyState.MoveConn = nil
    end
end

local function startBumpFlyLogic()
    stopBumpFlyLogic()

    BumpFlyState.HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not BumpFlyState.Enabled or not BumpFlyState.TargetPlayer then return end

        local targetPlayer = BumpFlyState.TargetPlayer
        local char = targetPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            BumpFlyState.TargetPlayer = nil
            return
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            BumpFlyState.TargetPlayer = nil
            return
        end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local targetHRP = char.HumanoidRootPart

        if myHRP and targetHRP then
            local offset = targetHRP.Velocity.Magnitude < 0.1 and 0 or 7
            local goal =
                targetHRP.CFrame
                * CFrame.new(0, 0, -offset)
                * CFrame.Angles(0, math.rad(-3), 0)

            myHRP.CFrame = myHRP.CFrame:Lerp(goal, 0.4)
            myHRP.Velocity = Vector3.zero
            myHRP.RotVelocity = Vector3.zero
        end
    end)

    BumpFlyState.MoveConn = RunService.RenderStepped:Connect(function()
        if not BumpFlyState.Enabled then return end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            hum:Move(Vector3.one * 1e31)
        end
    end)
end

