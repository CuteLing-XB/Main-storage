        local function detectImageExtension(url, body)
            local lowerUrl = tostring(url or ""):lower()
            if lowerUrl:find(".png", 1, true) then
                return ".png"
            elseif lowerUrl:find(".webp", 1, true) then
                return ".webp"
            elseif lowerUrl:find(".gif", 1, true) then
                return ".gif"
            elseif lowerUrl:find(".jpeg", 1, true) then
                return ".jpeg"
            end
            if type(body) == "string" then
                if body:sub(1, 8) == string.char(137, 80, 78, 71, 13, 10, 26, 10) then
                    return ".png"
                elseif body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP" then
                    return ".webp"
                elseif body:sub(1, 6) == "GIF87a" or body:sub(1, 6) == "GIF89a" then
                    return ".gif"
                elseif body:sub(1, 2) == string.char(255, 216) then
                    return ".jpg"
                end
            end
            return ".jpg"
        end

        local function downloadTemporaryImage(imageUrl, prefix)
            local assetLoader = getcustomasset or getsynasset
            if type(assetLoader) ~= "function"
                or type(writefile) ~= "function"
                or type(delfile) ~= "function"
                or not ensureImageCacheFolder() then
                return "", "", false
            end
            local body = requestHttpBodyWithTimeout(imageUrl, "image/*", 20)
            local extension = detectImageExtension(imageUrl, body)
            TemporaryImageSequence = TemporaryImageSequence + 1
            local fileName = IMAGE_CACHE_FOLDER .. "/"
                .. (prefix or "XLHub_CurrentImage_")
                .. tostring(TemporaryImageSequence) .. extension
            local writeOk = pcall(function()
                writefile(fileName, body)
            end)
            if not writeOk then
                return "", "", false
            end
            local assetOk, assetId = pcall(assetLoader, fileName)
            if assetOk and type(assetId) == "string" and assetId ~= "" then
                return assetId, fileName, true
            end
            deleteTemporaryImage(fileName)
            return "", "", false
        end

