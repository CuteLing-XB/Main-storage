-- 移位锁与飞行功能
--==================================================

local ShiftLockState = {
    Enabled = false,
    Connection = nil,
}

local FlightState = {
    Enabled = false,
    Speed = 50,
    Connection = nil,
    Attachment = nil,
    LinearVelocity = nil,
    AlignOrientation = nil,
}

local function getCharacterParts()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil, nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    return character, humanoid, root
end

local function disableShiftLock()
    ShiftLockState.Enabled = false
    if ShiftLockState.Connection then
        ShiftLockState.Connection:Disconnect()
        ShiftLockState.Connection = nil
    end

    local _, humanoid = getCharacterParts()
    if humanoid then
        humanoid.AutoRotate = true
        humanoid.CameraOffset = Vector3.zero
    end
end

local function enableShiftLock()
    disableShiftLock()
    ShiftLockState.Enabled = true

    ShiftLockState.Connection = RunService.RenderStepped:Connect(function()
        local _, humanoid, root = getCharacterParts()
        local camera = workspace.CurrentCamera
        if not humanoid or not root or not camera then
            return
        end

        local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
        if look.Magnitude > 0 then
            humanoid.AutoRotate = false
            humanoid.CameraOffset = Vector3.new(1.7, 0, 0)
            root.CFrame = CFrame.lookAt(root.Position, root.Position + look.Unit)
        end
    end)
end

local function setShiftLockEnabled(enabled)
    if enabled then
        enableShiftLock()
    else
        disableShiftLock()
    end
end

local function destroyFlightObjects()
    if FlightState.Connection then
        FlightState.Connection:Disconnect()
        FlightState.Connection = nil
    end
    for _, objectName in ipairs({"LinearVelocity", "AlignOrientation", "Attachment"}) do
        local object = FlightState[objectName]
        if object then
            object:Destroy()
            FlightState[objectName] = nil
        end
    end
end

local function disableFlight()
    FlightState.Enabled = false
    destroyFlightObjects()
    local _, humanoid = getCharacterParts()
    if humanoid then
        humanoid.PlatformStand = false
        if not ShiftLockState.Enabled then
            humanoid.AutoRotate = true
        end
    end
end

local function enableFlight()
    disableFlight()
    FlightState.Enabled = true

    local _, humanoid, root = getCharacterParts()
    if not humanoid or not root then
        FlightState.Enabled = false
        return
    end

    local attachment = Instance.new("Attachment")
    attachment.Name = "WindUIFlightAttachment"
    attachment.Parent = root
    FlightState.Attachment = attachment

    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "WindUIFlightVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = math.huge
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Parent = root
    FlightState.LinearVelocity = linearVelocity

    local alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Name = "WindUIFlightOrientation"
    alignOrientation.Attachment0 = attachment
    alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.MaxTorque = math.huge
    alignOrientation.Responsiveness = 20
    alignOrientation.Parent = root
    FlightState.AlignOrientation = alignOrientation

    humanoid.PlatformStand = true
    FlightState.Connection = RunService.RenderStepped:Connect(function()
        if not FlightState.Enabled then
            return
        end

        local character, currentHumanoid, currentRoot = getCharacterParts()
        local camera = workspace.CurrentCamera
        if not character or not currentHumanoid or not currentRoot or not camera then
            return
        end

        local moveDirection = currentHumanoid.MoveDirection
        local horizontal = Vector3.new(moveDirection.X, 0, moveDirection.Z)
        if horizontal.Magnitude > 0 then
            horizontal = horizontal.Unit * FlightState.Speed
        else
            horizontal = Vector3.zero
        end

        local vertical = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or currentHumanoid.Jump then
            vertical = FlightState.Speed
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vertical = -FlightState.Speed
        end

        if FlightState.LinearVelocity then
            FlightState.LinearVelocity.VectorVelocity = Vector3.new(horizontal.X, vertical, horizontal.Z)
        end

        local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
        if look.Magnitude > 0 and FlightState.AlignOrientation then
            FlightState.AlignOrientation.CFrame = CFrame.lookAt(Vector3.zero, look.Unit)
        end
    end)
end

