_G.__XLHubCleanup = function()
    if TranslatorCleanup then
        pcall(TranslatorCleanup)
    end

    if GeneralState and GeneralState.CharacterConnection then
        pcall(function() GeneralState.CharacterConnection:Disconnect() end)
        GeneralState.CharacterConnection = nil
    end

    if TeleportState then
        for _, connectionName in ipairs({"PlayerAddedConnection", "PlayerRemovingConnection"}) do
            local connection = TeleportState[connectionName]
            if connection then
                pcall(function() connection:Disconnect() end)
                TeleportState[connectionName] = nil
            end
        end
    end

    if DrawingState then
        if DrawingState.RenderConnection then
            pcall(function() DrawingState.RenderConnection:Disconnect() end)
            DrawingState.RenderConnection = nil
        end
        if DrawingState.PlayerRemovingConnection then
            pcall(function() DrawingState.PlayerRemovingConnection:Disconnect() end)
            DrawingState.PlayerRemovingConnection = nil
        end
        for _, category in ipairs(DrawingCategories) do
            category.Enabled = false
            category.Update = nil
            for player, object in pairs(category.Objects) do
                removeDrawingObject(object)
                category.Objects[player] = nil
            end
        end
    end

    pcall(function()
        if Window and Window.Destroy then
            Window:Destroy()
        end
    end)
end

