local function getLocalHumanoid()
    local character = LocalPlayer and LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function applyGeneralMovement()
    local humanoid = getLocalHumanoid()
    if not humanoid then
        return
    end

    if GeneralState.SpeedEnabled then
        humanoid.WalkSpeed = GeneralState.SpeedValue
    else
        humanoid.WalkSpeed = GeneralState.DefaultWalkSpeed
    end

    if GeneralState.InfiniteJumpEnabled then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = GeneralState.JumpPowerValue
    else
        humanoid.UseJumpPower = true
        humanoid.JumpPower = GeneralState.DefaultJumpPower
    end
end

local function setInfiniteJumpEnabled(enabled)
    GeneralState.InfiniteJumpEnabled = enabled
    if GeneralState.JumpConnection then
        GeneralState.JumpConnection:Disconnect()
        GeneralState.JumpConnection = nil
    end

    if enabled then
        GeneralState.JumpConnection = UserInputService.JumpRequest:Connect(function()
            local humanoid = getLocalHumanoid()
            if humanoid and humanoid.Health > 0 then
                humanoid.JumpPower = GeneralState.JumpPowerValue
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end

    applyGeneralMovement()
end

local function setCompatibilityProtectionEnabled(enabled)
    GeneralState.CompatibilityEnabled = enabled
    if GeneralState.CharacterConnection then
        GeneralState.CharacterConnection:Disconnect()
        GeneralState.CharacterConnection = nil
    end

    if enabled then
        -- 安全兼容保护：仅在重生后重新应用本地设置，不禁用校验、不拦截远程。
        GeneralState.CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
            character:WaitForChild("Humanoid", 5)
            task.wait(0.15)
            applyGeneralMovement()
        end)
        applyGeneralMovement()
    end
end

