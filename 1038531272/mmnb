local function getSavedKey()
    if isfile and isfile(SAVE_FILE_NAME) then 
        local content = readfile(SAVE_FILE_NAME)
        return content and content:match("^%s*(.-)%s*$")
    end
    return nil
end

local function saveKeyLocally(key)
    if writefile then writefile(SAVE_FILE_NAME, key) end
end

