        local camera = getDrawingCamera()
        if not camera then return end
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                local text = DrawingState.Names.Objects[player]
                if not text then
                    text = newDrawing("Text")
                    if text then
                        text.Size = 13
                        text.Center = true
                        text.Outline = true
                        text.Font = 2
                        text.Color = Color3.fromRGB(255, 255, 255)
                        DrawingState.Names.Objects[player] = text
                    end
                end
                if text then
                    local position, onScreen = camera:WorldToViewportPoint(player.Character.Head.Position + Vector3.new(0, 1.8, 0))
                    text.Position = Vector2.new(position.X, position.Y)
                    text.Text = player.Name
                    text.Visible = onScreen and position.Z > 0
                end
            else
                hideDrawingObject(DrawingState.Names.Objects[player])
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("名字透视", "已开启")
