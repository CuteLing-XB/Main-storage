local function RenderPlayer(player, o, precomputedDistance, isLowFreqFrame)
    HideObjects(o)
    if o and o.Velocity then
        -- 速度线每次进入目标渲染时先强制清零，避免停速/裁剪/失活后残留。
        pcall(function() o.Velocity.Visible = false end)
    end

    if not PhantomConfig.Enabled or player == PhantomLocalPlayer then return end
    if PhantomConfig.TeamCheck and player.Team == PhantomLocalPlayer.Team then return end

    local s = PhantomCharacterCache[player]
    if not s or not s.Ready or s.Status ~= "ALIVE" then return end
    if player.Character ~= s.Character or not s.Root or not s.Root.Parent then return end

    local root = s.Root
    local head = s.Head or s.Character:FindFirstChild("Head")
    local distance = precomputedDistance or (PhantomCamera.CFrame.Position - root.Position).Magnitude
    if distance > PhantomConfig.MaxDistance then return end

    local rootP, onScreen = PhantomCamera:WorldToViewportPoint(root.Position)
    local theme = GetTheme()
    local base = theme.Main

    -- 默认永久穿墙绘制，不进行遮挡 return。

    if not onScreen then
        if PhantomConfig.ShowOffScreen and o.Arrow then
            o._Hidden = false
            local a, b, c = OffscreenArrow(root.Position)
            if a then
                o.Arrow.PointA, o.Arrow.PointB, o.Arrow.PointC = a, b, c
                SetDrawingProperty(o.Arrow, "Color", base)
                SetDrawingProperty(o.Arrow, "Visible", true)
            end
        end
        return
    end

    o._Hidden = false
    local headWorld = head and head.Position or (root.Position + Vector3.new(0, 3, 0))
    local headP = PhantomCamera:WorldToViewportPoint(headWorld + Vector3.new(0, 0.5, 0))
    local legP = PhantomCamera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
    local height = math.clamp(math.abs(headP.Y - legP.Y), 18, 600)
    local width = math.clamp(height * 0.55, 12, 320)
    local pos = Vector2.new(rootP.X - width * 0.5, headP.Y)

    -- 动态拖尾：记录屏幕位置，关闭时立即清空显示
    if PhantomConfig.ShowMotionTrail or PhantomConfig.ShowGhostTrail then
        local history = o.TrailHistory
        local now = os.clock()
        local last = history[#history]
        if not last or (last.Position - Vector2.new(rootP.X, rootP.Y)).Magnitude > 1.5 or now - last.Time > 0.045 then
            local poolCount = #o.TrailPool
            local entry = poolCount > 0 and o.TrailPool[poolCount] or {}
            if poolCount > 0 then o.TrailPool[poolCount] = nil end
            entry.Position = Vector2.new(rootP.X, rootP.Y)
            entry.Width = width
            entry.Height = height
            entry.Time = now
            history[#history + 1] = entry
        end
        while #history > 13 do
            local oldEntry = history[1]
            for i = 1, #history - 1 do history[i] = history[i + 1] end
            history[#history] = nil
            if oldEntry then o.TrailPool[#o.TrailPool + 1] = oldEntry end
        end

        -- 清理过旧历史，防止站立/重生后残影留屏
        for i = #history, 1, -1 do
            if now - history[i].Time > 1.0 then
                local oldEntry = history[i]
                for j = i, #history - 1 do history[j] = history[j + 1] end
                history[#history] = nil
                if oldEntry then o.TrailPool[#o.TrailPool + 1] = oldEntry end
            end
        end

        if PhantomConfig.ShowMotionTrail then
            for i = 1, #o.Trail do
                local line = o.Trail[i]
                local a = history[i]
                local b = history[i + 1]
                if a and b and line then
                    local age = math.clamp((now - a.Time) / 1.0, 0, 1)
                    line.From = a.Position
                    line.To = b.Position
                    SetDrawingProperty(line, "Color", base)
                    SetDrawingProperty(line, "Transparency", 0.08 + age * 0.82)
                    SetDrawingProperty(line, "Visible", true)
                else
                    Hide(line)
                end
            end
        end

        if PhantomConfig.ShowGhostTrail then
            local count = math.min(#o.Ghost, #history)
            for i = 1, #o.Ghost do
                local ghost = o.Ghost[i]
                local point = history[math.max(1, #history - i + 1)]
                if i <= count and point and ghost then
                    local age = math.clamp((now - point.Time) / 1.0, 0, 1)
                    local scale = 1 - i * 0.035
                    local gw = math.max(8, point.Width * scale)
                    local gh = math.max(12, point.Height * scale)
                    ghost.Position = Vector2.new(point.Position.X - gw * 0.5, point.Position.Y - gh * 0.5)
                    ghost.Size = Vector2.new(gw, gh)
                    SetDrawingProperty(ghost, "Color", base)
                    SetDrawingProperty(ghost, "Transparency", math.clamp(0.15 + i * 0.1 + age * 0.35, 0, 0.95))
                    SetDrawingProperty(ghost, "Visible", true)
                else
                    Hide(ghost)
                end
            end
        end
    else
        table.clear(o.TrailHistory)
        for _, line in pairs(o.Trail) do Hide(line) end
        for _, ghost in pairs(o.Ghost) do Hide(ghost) end
    end

    -- CornerBox：只计算标量坐标，复用同一帧内的端点向量，不创建 segments 临时表。
    if PhantomConfig.ShowCornerBox or PhantomConfig.ShowPulseBox then
        local l = width * 0.25
        local px, py = pos.X, pos.Y
        local wx, hy = px + width, py + height
        local tl = Vector2.new(px, py)
        local tr = Vector2.new(wx, py)
        local bl = Vector2.new(px, hy)
        local br = Vector2.new(wx, hy)
        local tlH = Vector2.new(px + l, py)
        local tlV = Vector2.new(px, py + l)
        local trH = Vector2.new(wx - l, py)
        local trV = Vector2.new(wx, py + l)
        local blH = Vector2.new(px + l, hy)
        local blV = Vector2.new(px, hy - l)
        local brH = Vector2.new(wx - l, hy)
        local brV = Vector2.new(wx, hy - l)
        local corner = o.Corner
        corner[1].From, corner[1].To = tl, tlH
        corner[2].From, corner[2].To = tl, tlV
        corner[3].From, corner[3].To = tr, trH
        corner[4].From, corner[4].To = tr, trV
        corner[5].From, corner[5].To = bl, blH
        corner[6].From, corner[6].To = bl, blV
        corner[7].From, corner[7].To = br, brH
        corner[8].From, corner[8].To = br, brV
        local alpha = PhantomConfig.ShowPulseBox
            and (0.55 + (math.sin(os.clock() * 3.4) + 1) * 0.2)
            or 1
        for i = 1, 8 do
            local line = corner[i]
            SetDrawingProperty(line, "Color", base)
            SetDrawingProperty(line, "Transparency", alpha)
            SetDrawingProperty(line, "Visible", true)
        end
    end

    if PhantomConfig.ShowFilledBox and o.Filled then
        o.Filled.Position = pos
        o.Filled.Size = Vector2.new(width, height)
        SetDrawingProperty(o.Filled, "Color", base)
        SetDrawingProperty(o.Filled, "Transparency", 0.18)
        SetDrawingProperty(o.Filled, "Visible", true)
    end

    if PhantomConfig.ShowHeadHitbox and head and o.Head then
        local p, vis = PhantomCamera:WorldToViewportPoint(head.Position)
        if vis then
            o.Head.Position = Vector2.new(p.X, p.Y)
            o.Head.Radius = math.clamp(900 / math.max(distance, 1), 3, 18)
            SetDrawingProperty(o.Head, "Color", base)
            SetDrawingProperty(o.Head, "Visible", true)
        end
    end

    if PhantomConfig.ShowSkeleton then
        local pairs = BonePairs(s.Character, s.Humanoid)
        for i, pair in ipairs(pairs) do
            if o.Skeleton[i] then
                local p1 = s.Character:FindFirstChild(pair[1])
                local p2 = s.Character:FindFirstChild(pair[2])
                if p1 and p2 then
                    local a, va = PhantomCamera:WorldToViewportPoint(p1.Position)
                    local b, vb = PhantomCamera:WorldToViewportPoint(p2.Position)
                    if va and vb then
                        o.Skeleton[i].From = Vector2.new(a.X, a.Y)
                        o.Skeleton[i].To = Vector2.new(b.X, b.Y)
                        SetDrawingProperty(o.Skeleton[i], "Color", base)
                        SetDrawingProperty(o.Skeleton[i], "Visible", true)
                    end
                end
            end
        end
    end

    local textCache = o.TextCache
    if PhantomConfig.ShowName and o.Name then
        if isLowFreqFrame or textCache.Name == nil then
            textCache.Name = tostring(player.DisplayName or player.Name)
            o.Name.Text = textCache.Name
        end
        o.Name.Position = Vector2.new(rootP.X, pos.Y - 16)
        SetDrawingProperty(o.Name, "Color", base)
        SetDrawingProperty(o.Name, "Visible", true)
    end

    if PhantomConfig.ShowDistance and o.Distance then
        local distanceValue = math.floor(distance)
        local now = os.clock()
        if isLowFreqFrame or textCache.DistanceValue == nil
            or distanceValue ~= textCache.DistanceValue
                and (not textCache.NextDistanceUpdate or now >= textCache.NextDistanceUpdate) then
            o.Distance.Text = "[" .. tostring(distanceValue) .. "m]"
            textCache.DistanceValue = distanceValue
            textCache.NextDistanceUpdate = now + 0.25
        end
        o.Distance.Position = Vector2.new(rootP.X, pos.Y + height + 3)
        SetDrawingProperty(o.Distance, "Color", PhantomStaticColors.Distance)
        SetDrawingProperty(o.Distance, "Visible", true)
    end

    if PhantomConfig.ShowWeapon and o.Weapon then
        if isLowFreqFrame or textCache.Weapon == nil then
            local tool = s.Character:FindFirstChildOfClass("Tool")
            textCache.Weapon = tool and tool.Name or ""
        end
        if textCache.Weapon ~= "" then
            if o.Weapon.Text ~= textCache.Weapon then
                o.Weapon.Text = textCache.Weapon
            end
            o.Weapon.Position = Vector2.new(rootP.X, pos.Y + height + 17)
            SetDrawingProperty(o.Weapon, "Color", theme.Secondary)
            SetDrawingProperty(o.Weapon, "Visible", true)
        end
    end

    if PhantomConfig.ShowHealth then
        local ratio, valid = GetSafeRatio(player)
        if valid and ratio then
            PhantomSmoothHealth[player] = SmoothValue(PhantomSmoothHealth[player], ratio, PhantomConfig.HealthSmoothness)
            local drawRatio = math.clamp(PhantomSmoothHealth[player], 0, 1)
            local x = pos.X - 7
            local bottom = pos.Y + height
            local top = bottom - math.max(height * drawRatio, 1.5)
            local color = PhantomConfig.ShowHealthGradient and HealthColor(ratio) or theme.Secondary

            -- 核心：默认没有任何黑色健康条背景。
            if PhantomConfig.ShowHealthBorder and o.HealthBorder then
                o.HealthBorder.From = Vector2.new(x, pos.Y)
                o.HealthBorder.To = Vector2.new(x, bottom)
                SetDrawingProperty(o.HealthBorder, "Color", PhantomStaticColors.HealthBorder)
                SetDrawingProperty(o.HealthBorder, "Transparency", 0.35)
                SetDrawingProperty(o.HealthBorder, "Visible", true)
            end

            o.Health.From = Vector2.new(x, bottom)
            o.Health.To = Vector2.new(x, top)
            SetDrawingProperty(o.Health, "Color", color)
            SetDrawingProperty(o.Health, "Visible", true)

            local healthPercent = math.floor(ratio * 100 + 0.5)
            if textCache.HealthPercent ~= healthPercent then
                o.HealthText.Text = tostring(healthPercent) .. "%"
                textCache.HealthPercent = healthPercent
            end
            o.HealthText.Position = Vector2.new(x - 22, top - 6)
            SetDrawingProperty(o.HealthText, "Color", color)
            SetDrawingProperty(o.HealthText, "Visible", true)
        end
    end

    if PhantomConfig.ShowAimView and head and o.Aim then
        local a = PhantomCamera:WorldToViewportPoint(head.Position)
        local b = PhantomCamera:WorldToViewportPoint(head.Position + head.CFrame.LookVector * 8)
        if a and b then
            o.Aim.From = Vector2.new(a.X, a.Y)
            o.Aim.To = Vector2.new(b.X, b.Y)
            SetDrawingProperty(o.Aim, "Color", theme.Text)
            SetDrawingProperty(o.Aim, "Visible", true)
        end
    end

    if PhantomConfig.ShowVelocity and o.Velocity then
        local velocity = root.AssemblyLinearVelocity
        if velocity.Magnitude > 0.5 then
            local p, vis = PhantomCamera:WorldToViewportPoint(root.Position + velocity * 0.35)
                        if vis then
                o.Velocity.From = Vector2.new(rootP.X, rootP.Y)
                o.Velocity.To = Vector2.new(p.X, p.Y)
                o.Velocity.Color = theme.Accent
                o.Velocity.Visible = true
            else
                pcall(function() o.Velocity.Visible = false end)
            end
        else
            pcall(function() o.Velocity.Visible = false end)
        end
    else
        if o.Velocity then
            pcall(function() o.Velocity.Visible = false end)
        end
    end
    if PhantomConfig.ShowTracer and o.Tracer then
        o.Tracer.From = Vector2.new(PhantomCamera.ViewportSize.X * 0.5, PhantomCamera.ViewportSize.Y - 6)
        o.Tracer.To = Vector2.new(rootP.X, rootP.Y)
        SetDrawingProperty(o.Tracer, "Color", base)
        SetDrawingProperty(o.Tracer, "Transparency", 0.75)
        SetDrawingProperty(o.Tracer, "Visible", true)
    elseif PhantomConfig.ShowDistanceLine and o.Tracer then
        o.Tracer.From = Vector2.new(rootP.X, rootP.Y)
        o.Tracer.To = Vector2.new(rootP.X, math.min(PhantomCamera.ViewportSize.Y - 8, rootP.Y + 100))
        SetDrawingProperty(o.Tracer, "Color", base)
        SetDrawingProperty(o.Tracer, "Transparency", 0.7)
        SetDrawingProperty(o.Tracer, "Visible", true)
    end

    if PhantomConfig.ShowTargetDot and o.TargetDot then
        o.TargetDot.Position = Vector2.new(rootP.X, rootP.Y)
        o.TargetDot.Radius = math.clamp(700 / math.max(distance, 1), 3, 10)
        SetDrawingProperty(o.TargetDot, "Color", base)
        SetDrawingProperty(o.TargetDot, "Visible", true)
    end

    if PhantomConfig.ShowStatusTag and o.Status then
        o.Status.Text = "[ALIVE]"
        o.Status.Position = Vector2.new(rootP.X, pos.Y - 30)
        SetDrawingProperty(o.Status, "Color", theme.Secondary)
        SetDrawingProperty(o.Status, "Visible", true)
    end

    if PhantomConfig.ShowDamageIndicator then
        local d = PhantomDamageCache[player]
        if d and d.Value > 0 and os.clock() - d.Time < 0.75 then
            local a = math.clamp((os.clock() - d.Time) / 0.75, 0, 1)
            local damageValue = math.floor(d.Value + 0.5)
            if o.TextCache.DamageValue ~= damageValue then
                o.Damage.Text = "-" .. tostring(damageValue)
                o.TextCache.DamageValue = damageValue
            end
            o.Damage.Position = Vector2.new(rootP.X, pos.Y - 44 - a * 25)
            o.Damage.Transparency = a
            SetDrawingProperty(o.Damage, "Color", PhantomStaticColors.Damage)
            SetDrawingProperty(o.Damage, "Visible", true)
        end
    end

    if PhantomConfig.ShowFootRings then
        local foot = root.Position - Vector3.new(0, 3, 0)
        local pts = o.FootPoints
        local pointCount = 0
        for i = 1, 16 do
            local p, vis = PhantomCamera:WorldToViewportPoint(foot + PhantomFootOffsets[i])
            if not vis then
                pointCount = 0
                break
            end
            pointCount = i
            pts[i] = Vector2.new(p.X, p.Y)
        end
        if pointCount == 16 then
            for i = 1, 16 do
                local footLine = o.Foot[i]
                if footLine then
                    footLine.From = pts[i]
                    footLine.To = pts[(i % 16) + 1]
                    SetDrawingProperty(footLine, "Color", base)
                    SetDrawingProperty(footLine, "Visible", true)
                end
            end
        end
    end
end

