local function SafeExecute(scriptName, url)
    WindUI:Notify({
        Title = "正在加载",
        Content = "正在获取 " .. scriptName .. "，请稍候...",
        Duration = 3,
    })

    task.spawn(function()
        local ok, err = pcall(function()
            local source = game:HttpGet(url)
            local chunk = loadstring(source)
            assert(type(chunk) == "function", "远程内容无法编译")
            chunk()
        end)

        if ok then
            WindUI:Notify({
                Title = "执行成功",
                Content = scriptName .. " 已成功运行",
                Duration = 4,
            })
        else
            WindUI:Notify({
                Title = "执行失败",
                Content = scriptName .. "：" .. tostring(err),
                Duration = 6,
            })
            warn("[" .. scriptName .. "] " .. tostring(err))
        end
    end)
end

