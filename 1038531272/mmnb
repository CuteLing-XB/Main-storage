local DrawingState = {
    Boxes = {Enabled = false, Update = nil, Objects = {}},
    Chams = {Enabled = false, Update = nil, Objects = {}, Color = Color3.fromRGB(255, 255, 255)},
    Names = {Enabled = false, Update = nil, Objects = {}},
    Health = {Enabled = false, Update = nil, Objects = {}},
    Skeleton = {Enabled = false, Update = nil, Objects = {}},
    Tracers = {Enabled = false, Update = nil, Objects = {}},
    RenderConnection = nil,
    PlayerRemovingConnection = nil,
    LastUpdate = 0,
    FrameInterval = 1 / 30,
}

local DrawingCategories = {
    DrawingState.Boxes,
    DrawingState.Chams,
    DrawingState.Names,
    DrawingState.Health,
    DrawingState.Skeleton,
    DrawingState.Tracers,
}

local function drawingSupported()
    return type(Drawing) == "table" and type(Drawing.new) == "function"
end

local function drawingNotify(title, content)
    WindUI:Notify({Title = title, Content = content, Duration = 3})
end

local function removeDrawing(object)
    if not object then return end
    pcall(function()
        if type(object.Remove) == "function" then
            object:Remove()
        else
            object:Destroy()
        end
    end)
end

local function newDrawing(className)
    if not drawingSupported() then return nil end
    local ok, object = pcall(function()
        return Drawing.new(className)
    end)
    return ok and object or nil
end

local function getDrawingCamera()
    return workspace.CurrentCamera
end

-- 玩家离线清理（解决 ESP 内存泄露与残留）
local function cleanupDrawingPlayer(player)
    for _, category in ipairs(DrawingCategories) do
        local obj = category.Objects[player]
        if obj then
            if type(obj) == "table" then
                for _, subObj in pairs(obj) do
                    removeDrawing(subObj)
                end
            else
                removeDrawing(obj)
            end
            category.Objects[player] = nil
        end
    end
end

local ScreenBoundsCache = setmetatable({}, {__mode = "k"})

local function getScreenBounds(character)
    local camera = getDrawingCamera()
    if not camera or not character or not character.Parent then
        return nil
    end

    local cached = ScreenBoundsCache[character]
    if cached and cached.stamp == DrawingState.LastUpdate then
        if cached.visible then
            return cached.min2D, cached.max2D
        end
        return nil
    end

    -- GetBoundingBox 比逐个 GetDescendants 遍历 BasePart 更轻量，且保留原有八点投影逻辑。
    local ok, boxCFrame, boxSize = pcall(function()
        return character:GetBoundingBox()
    end)
    if not ok or not boxCFrame or not boxSize then
        return nil
    end

    local half = boxSize * 0.5
    local points = {
        boxCFrame:PointToWorldSpace(Vector3.new(-half.X, -half.Y, -half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(-half.X, half.Y, -half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(half.X, -half.Y, -half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(half.X, half.Y, -half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(-half.X, -half.Y, half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(-half.X, half.Y, half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(half.X, -half.Y, half.Z)),
        boxCFrame:PointToWorldSpace(Vector3.new(half.X, half.Y, half.Z)),
    }

    local min2D = Vector2.new(math.huge, math.huge)
    local max2D = Vector2.new(-math.huge, -math.huge)
    local visible = false
    for _, point in ipairs(points) do
        local screen, onScreen = camera:WorldToViewportPoint(point)
        if onScreen and screen.Z > 0 then
            visible = true
            min2D = Vector2.new(math.min(min2D.X, screen.X), math.min(min2D.Y, screen.Y))
            max2D = Vector2.new(math.max(max2D.X, screen.X), math.max(max2D.Y, screen.Y))
        end
    end

    if not visible then
        ScreenBoundsCache[character] = {stamp = DrawingState.LastUpdate, visible = false}
        return nil
    end
    ScreenBoundsCache[character] = {
        stamp = DrawingState.LastUpdate,
        visible = true,
        min2D = min2D,
        max2D = max2D,
    }
    return min2D, max2D
end

local function hideDrawingObject(object)
    if not object then
        return
    end
    if type(object) == "table" then
        for _, child in pairs(object) do
            hideDrawingObject(child)
        end
        return
    end
    local disabled = pcall(function()
        object.Enabled = false
    end)
    if not disabled then
        pcall(function()
            object.Visible = false
        end)
    end
end

local function removeDrawingObject(object)
    if not object then
        return
    end
    if type(object) == "table" then
        for _, child in pairs(object) do
            removeDrawingObject(child)
        end
    else
        removeDrawing(object)
    end
end

local function pruneDrawingObjects(category, players)
    local activePlayers = {}
    for _, player in ipairs(players) do
        activePlayers[player] = true
    end
    for player, object in pairs(category.Objects) do
        if not activePlayers[player] then
            removeDrawingObject(object)
            category.Objects[player] = nil
        elseif not player.Character then
            hideDrawingObject(object)
        end
    end
end

local function refreshDrawingLoop()
    local hasEnabledFeature = false
    for _, category in ipairs(DrawingCategories) do
        if category.Enabled and category.Update then
            hasEnabledFeature = true
            break
        end
    end

    if hasEnabledFeature and not DrawingState.PlayerRemovingConnection then
        DrawingState.PlayerRemovingConnection = Players.PlayerRemoving:Connect(cleanupDrawingPlayer)
    elseif not hasEnabledFeature and DrawingState.PlayerRemovingConnection then
        DrawingState.PlayerRemovingConnection:Disconnect()
        DrawingState.PlayerRemovingConnection = nil
    end

    if hasEnabledFeature and not DrawingState.RenderConnection then
        DrawingState.RenderConnection = RunService.RenderStepped:Connect(function()
            local now = os.clock()
            if now - DrawingState.LastUpdate < DrawingState.FrameInterval then
                return
            end
            DrawingState.LastUpdate = now
            local players = Players:GetPlayers()
            for _, category in ipairs(DrawingCategories) do
                if category.Enabled and category.Update then
                    pcall(category.Update, players)
                end
            end
        end)
    elseif not hasEnabledFeature and DrawingState.RenderConnection then
        DrawingState.RenderConnection:Disconnect()
        DrawingState.RenderConnection = nil
    end
end

local function clearBoxes()
    DrawingState.Boxes.Update = nil
    for _, objects in pairs(DrawingState.Boxes.Objects) do
        removeDrawing(objects.box)
        removeDrawing(objects.outline)
    end
    DrawingState.Boxes.Objects = {}
    refreshDrawingLoop()
end

local function setBoxesEnabled(enabled)
    DrawingState.Boxes.Enabled = enabled
    clearBoxes()
    if not enabled then
        drawingNotify("方框透视", "已关闭")
        return
    end
    if not drawingSupported() then
        DrawingState.Boxes.Enabled = false
        drawingNotify("方框透视", "当前执行器不支持 Drawing")
        return
    end

    DrawingState.Boxes.Update = function(players)
        pruneDrawingObjects(DrawingState.Boxes, players)
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character then
                local min2D, max2D = getScreenBounds(player.Character)
                local objects = DrawingState.Boxes.Objects[player]
                if not objects then
                    objects = {box = newDrawing("Square"), outline = newDrawing("Square")}
                    if objects.box then
                        objects.box.Color = Color3.fromRGB(255, 255, 255)
                        objects.box.Thickness = 1
                        objects.box.Filled = false
                    end
                    if objects.outline then
                        objects.outline.Color = Color3.fromRGB(0, 0, 0)
                        objects.outline.Thickness = 3
                        objects.outline.Filled = false
                    end
                    DrawingState.Boxes.Objects[player] = objects
                end

                if objects.box and objects.outline and min2D and max2D then
                    local size = max2D - min2D
                    objects.box.Position = min2D
                    objects.box.Size = size
                    objects.box.Visible = true
                    objects.outline.Position = min2D
                    objects.outline.Size = size
                    objects.outline.Visible = true
                elseif objects.box and objects.outline then
                    objects.box.Visible = false
                    objects.outline.Visible = false
                end
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("方框透视", "已开启")
end

local function clearChams()
    DrawingState.Chams.Update = nil
    for _, highlight in pairs(DrawingState.Chams.Objects) do
        pcall(function() highlight:Destroy() end)
    end
    DrawingState.Chams.Objects = {}
    refreshDrawingLoop()
end

local function setChamsEnabled(enabled)
    DrawingState.Chams.Enabled = enabled
