local function setHealthEnabled(enabled)
    DrawingState.Health.Enabled = enabled
    clearHealth()
    if not enabled then
        drawingNotify("血量条透视", "已关闭")
        return
    end
    if not drawingSupported() then
        DrawingState.Health.Enabled = false
        drawingNotify("血量条透视", "当前执行器不支持 Drawing")
        return
    end

    DrawingState.Health.Update = function(players)
        pruneDrawingObjects(DrawingState.Health, players)
        for _, player in ipairs(players) do
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if player ~= LocalPlayer and character and humanoid then
                local min2D, max2D = getScreenBounds(character)
                local objects = DrawingState.Health.Objects[player]
                if not objects then
                    objects = {bar = newDrawing("Square"), outline = newDrawing("Square")}
                    if objects.bar then
                        objects.bar.Color = Color3.fromRGB(0, 255, 0)
                        objects.bar.Filled = true
                    end
                    if objects.outline then
                        objects.outline.Color = Color3.fromRGB(0, 0, 0)
                        objects.outline.Filled = true
                    end
                    DrawingState.Health.Objects[player] = objects
                end
                if objects.bar and objects.outline and min2D and max2D then
                    local height = max2D.Y - min2D.Y
                    local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                    local barHeight = height * ratio
                    objects.outline.Size = Vector2.new(4, height + 2)
                    objects.outline.Position = Vector2.new(min2D.X - 6, min2D.Y - 1)
                    objects.outline.Visible = true
                    objects.bar.Size = Vector2.new(2, barHeight)
                    objects.bar.Position = Vector2.new(min2D.X - 5, max2D.Y - barHeight)
                    objects.bar.Color = Color3.fromRGB(255 * (1 - ratio), 255 * ratio, 0)
                    objects.bar.Visible = true
                elseif objects.bar and objects.outline then
                    objects.bar.Visible = false
                    objects.outline.Visible = false
                end
            end
        end
    end
    refreshDrawingLoop()
    drawingNotify("血量条透视", "已开启")
end

