--==================================================
-- WindUI 官方配置管理器：保存并自动读取主题、按键等控件配置
--==================================================
local ConfigManager = Window.ConfigManager
local ConfigName = "default"
local ConfigFile = nil

local function getWindUIConfig()
    if not ConfigManager then
        return nil
    end

    if not ConfigFile then
        ConfigFile = ConfigManager:CreateConfig(ConfigName)
        if ConfigFile then
            ConfigFile:Register("UIBackgroundSelection", uiBackgroundDropdown)
            ConfigFile:Register("PCWindowToggleKey", pcToggleKeybind)
        end
    end

    return ConfigFile
end

local function saveWindUIConfig()
    local config = getWindUIConfig()
    if not config then
        return false
    end

    local ok, result = pcall(function()
        return config:Save()
    end)
    return ok and result == true
end

local function loadWindUIConfig()
    local config = getWindUIConfig()
    if not config then
        return false
    end

    local ok, result = pcall(function()
        return config:Load()
    end)
    return ok and result ~= nil
end

if ConfigManager then
    ConfigManager:Init(Window)
    getWindUIConfig()

    SettingTab:Section({
        Title = "配置保存",
    })

    SettingTab:Button({
        Title = "保存控件配置",
        Desc = "保存 PC 按键和已注册控件；下次启动会自动读取",
