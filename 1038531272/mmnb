-- WindUI 侧边栏 Tab 的白色圆角层由官方内部 Frame/Outline 渲染；
-- 只透明化这两个背景层，保留左侧图标、文字和点击区域。
do
    local sidebarTransparencyConnections = {}
    local boundSidebarObjects = setmetatable({}, {__mode = "k"})

    local function makeSidebarTabBackgroundTransparent(object)
        if not object or not object:IsA("GuiObject") then
            return
        end
        if object.Name ~= "Frame" and object.Name ~= "Outline" then
            return
        end
        if boundSidebarObjects[object] then
            return
        end
        boundSidebarObjects[object] = true

        if object:IsA("ImageLabel") or object:IsA("ImageButton") then
            object.ImageTransparency = 1
            local imageConnection = object:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
                if object.Parent then
                    object.ImageTransparency = 1
                end
            end)
            sidebarTransparencyConnections[#sidebarTransparencyConnections + 1] = imageConnection
        end

        object.BackgroundTransparency = 1
        local backgroundConnection = object:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
            if object.Parent then
                object.BackgroundTransparency = 1
            end
        end)
        sidebarTransparencyConnections[#sidebarTransparencyConnections + 1] = backgroundConnection
    end

    local function bindSidebarTree(root)
        makeSidebarTabBackgroundTransparent(root)
        if root and root.GetDescendants then
            for _, descendant in ipairs(root:GetDescendants()) do
                makeSidebarTabBackgroundTransparent(descendant)
            end
        end
    end

    local sidebar = Window.UIElements and Window.UIElements.SideBarContainer
    if sidebar then
        bindSidebarTree(sidebar)
        local sidebarConnection = sidebar.DescendantAdded:Connect(function(descendant)
            task.defer(function()
                bindSidebarTree(descendant)
            end)
        end)
        sidebarTransparencyConnections[#sidebarTransparencyConnections + 1] = sidebarConnection
        SidebarTransparencyCleanup = function()
            for _, connection in ipairs(sidebarTransparencyConnections) do
                pcall(function() connection:Disconnect() end)
            end
            sidebarTransparencyConnections = {}
            boundSidebarObjects = setmetatable({}, {__mode = "k"})
            SidebarTransparencyCleanup = nil
        end
    end
end

