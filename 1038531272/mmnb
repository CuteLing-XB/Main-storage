-- 独立移位锁悬浮按钮，保留原脚本的图标和移动端显示方式。
local function createStandaloneShiftLock()
    local parent = getUiParent()
    local old = parent:FindFirstChild("Shiftlock (StarterGui)")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "Shiftlock (StarterGui)"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = parent

    local button = Instance.new("ImageButton")
    button.Name = "ShiftLockButton"
    button.Active = true
    button.Draggable = true
    button.BackgroundTransparency = 1
    button.Position = UDim2.new(0.921914339, 0, 0.552375436, 0)
    button.Size = UDim2.new(0.0636147112, 0, 0.0661305636, 0)
    button.SizeConstraint = Enum.SizeConstraint.RelativeXX
    button.Image = "rbxasset://textures/ui/mouseLock_off@2x.png"
    button.Visible = UserInputService.TouchEnabled
    button.Parent = gui

    local state = {Enabled = false, Connection = nil, Destroyed = false}
    local cameraOffset = CFrame.new(1.7, 0, 0)
    local resetOffset = CFrame.new(-1.7, 0, 0)

    local function getCharacter()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        return character, humanoid, root
    end

    local function setImage(enabled)
        button.Image = enabled
            and "rbxasset://textures/ui/mouseLock_on@2x.png"
            or "rbxasset://textures/ui/mouseLock_off@2x.png"
    end

    local function disable()
        state.Enabled = false
        if state.Connection then
            state.Connection:Disconnect()
            state.Connection = nil
        end
        local _, humanoid = getCharacter()
        if humanoid then
            humanoid.AutoRotate = true
            humanoid.CameraOffset = Vector3.zero
        end
        if workspace.CurrentCamera then
            workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * resetOffset
        end
        setImage(false)
    end

    local function enable()
        disable()
        state.Enabled = true
        setImage(true)
        state.Connection = RunService.RenderStepped:Connect(function()
            if not state.Enabled or state.Destroyed then return end
            local _, humanoid, root = getCharacter()
            local camera = workspace.CurrentCamera
            if not humanoid or not root or not camera then return end
            local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            if look.Magnitude > 0 then
                humanoid.AutoRotate = false
                humanoid.CameraOffset = Vector3.new(1.7, 0, 0)
                root.CFrame = CFrame.lookAt(root.Position, root.Position + look.Unit)
            end
        end)
    end

    local function toggle()
        if state.Enabled then disable() else enable() end
    end

    button.Activated:Connect(toggle)
    ContextActionService:BindAction("WindUIStandaloneShiftLock", function(_, inputState)
        if inputState == Enum.UserInputState.Begin then
            toggle()
        end
        return Enum.ContextActionResult.Sink
    end, false, Enum.KeyCode.LeftShift)
    ContextActionService:SetPosition("WindUIStandaloneShiftLock", UDim2.new(0.8, 0, 0.8, 0))

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.4)
        if state.Enabled then enable() end
    end)

    gui.Destroying:Connect(function()
        state.Destroyed = true
        disable()
        pcall(function()
            ContextActionService:UnbindAction("WindUIStandaloneShiftLock")
        end)
    end)

    return gui
end

-- 独立飞行窗口，保留原飞行脚本的按钮布局、隐藏、关闭、速度加减和上下控制。
local function createStandaloneFlight()
    local parent = LocalPlayer:WaitForChild("PlayerGui")
    local old = parent:FindFirstChild("main")
    if old then old:Destroy() end

    local main = Instance.new("ScreenGui")
    main.Name = "main"
    main.ResetOnSpawn = false
    main.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    main.Parent = parent

    local frame = Instance.new("Frame")
    frame.Name = "Frame"
    frame.BackgroundColor3 = Color3.fromRGB(163, 255, 137)
    frame.BorderColor3 = Color3.fromRGB(103, 221, 213)
    frame.Position = UDim2.new(0.100320168, 0, 0.379746825, 0)
    frame.Size = UDim2.new(0, 190, 0, 57)
    frame.Active = true
    frame.Draggable = true
    frame.Parent = main

    local function makeButton(name, text, color, position, size)
        local button = Instance.new("TextButton")
        button.Name = name
        button.Text = text
        button.BackgroundColor3 = color
        button.Position = position
        button.Size = size
        button.Font = Enum.Font.SourceSans
        button.TextColor3 = Color3.fromRGB(0, 0, 0)
        button.TextSize = 14
        button.Parent = frame
        return button
    end

    local up = makeButton("up", "上", Color3.fromRGB(79, 255, 152), UDim2.new(0, 0, 0, 29), UDim2.new(0, 44, 0, 28))
    local down = makeButton("down", "下", Color3.fromRGB(215, 255, 121), UDim2.new(0, 0, 0.491228074, 0), UDim2.new(0, 44, 0, 28))
    local toggle = makeButton("onof", "飞行", Color3.fromRGB(255, 249, 74), UDim2.new(0.702823281, 0, 0.491228074, 0), UDim2.new(0, 56, 0, 28))
    local plus = makeButton("plus", "+", Color3.fromRGB(133, 145, 255), UDim2.new(0.231578946, 0, 0, 0), UDim2.new(0, 45, 0, 28))
    local minus = makeButton("mine", "-", Color3.fromRGB(123, 255, 247), UDim2.new(0.231578946, 0, 0.491228074, 0), UDim2.new(0, 45, 0, 29))
    local speedLabel = makeButton("speed", "1", Color3.fromRGB(255, 85, 0), UDim2.new(0.468421042, 0, 0.491228074, 0), UDim2.new(0, 44, 0, 28))

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.BackgroundColor3 = Color3.fromRGB(242, 60, 255)
    title.Position = UDim2.new(0.469327301, 0, 0, 0)
    title.Size = UDim2.new(0, 100, 0, 28)
    title.Font = Enum.Font.SourceSans
    title.Text = "飞行脚本"
    title.TextColor3 = Color3.fromRGB(0, 0, 0)
    title.TextScaled = true
    title.TextWrapped = true
    title.Parent = frame

    local closeButton = makeButton("Close", "关闭", Color3.fromRGB(225, 25, 0), UDim2.new(0, 0, -1, 27), UDim2.new(0, 45, 0, 28))
    closeButton.TextSize = 30
    local hideButton = makeButton("minimize", "隐藏", Color3.fromRGB(192, 150, 230), UDim2.new(0, 44, -1, 27), UDim2.new(0, 45, 0, 28))
    hideButton.TextSize = 30
    local showButton = makeButton("minimize2", "+", Color3.fromRGB(192, 150, 230), UDim2.new(0, 44, -1, 57), UDim2.new(0, 45, 0, 28))
    showButton.TextSize = 30
    showButton.Visible = false

    local state = {
        Enabled = false,
        SpeedLevel = 1,
        Vertical = 0,
        Connection = nil,
        BodyVelocity = nil,
        BodyGyro = nil,
        InputBegan = nil,
        InputEnded = nil,
        Closed = false,
    }

    local function getCharacter()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        return character, humanoid, root
    end

    local function setHumanoidStates(humanoid, enabled)
        if not humanoid then return end
        humanoid.PlatformStand = enabled
        humanoid.AutoRotate = not enabled
        local animate = humanoid.Parent and humanoid.Parent:FindFirstChild("Animate")
        if animate then animate.Disabled = enabled end
    end

    local function stopFlight()
        state.Enabled = false
        if state.Connection then state.Connection:Disconnect(); state.Connection = nil end
        if state.InputBegan then state.InputBegan:Disconnect(); state.InputBegan = nil end
        if state.InputEnded then state.InputEnded:Disconnect(); state.InputEnded = nil end
        if state.BodyVelocity then state.BodyVelocity:Destroy(); state.BodyVelocity = nil end
        if state.BodyGyro then state.BodyGyro:Destroy(); state.BodyGyro = nil end
        local _, humanoid = getCharacter()
        setHumanoidStates(humanoid, false)
        toggle.Text = "飞行"
    end

    local function startFlight()
        stopFlight()
        local character, humanoid, root = getCharacter()
        if not character or not humanoid or not root then return end
        state.Enabled = true
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.P = 9e4
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = root.CFrame
        bodyGyro.Parent = root
        state.BodyGyro = bodyGyro

        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Parent = root
        state.BodyVelocity = bodyVelocity
        setHumanoidStates(humanoid, true)

        state.InputBegan = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == Enum.KeyCode.Space then state.Vertical = 1 end
            if input.KeyCode == Enum.KeyCode.LeftControl then state.Vertical = -1 end
        end)
        state.InputEnded = UserInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftControl then
                state.Vertical = 0
            end
        end)
        state.Connection = RunService.RenderStepped:Connect(function()
            if not state.Enabled or not state.BodyVelocity or not state.BodyGyro then return end
            local currentCharacter, currentHumanoid, currentRoot = getCharacter()
            local camera = workspace.CurrentCamera
            if not currentCharacter or not currentHumanoid or not currentRoot or not camera then return end
            local move = currentHumanoid.MoveDirection
            local horizontal = Vector3.new(move.X, 0, move.Z)
            if horizontal.Magnitude > 0 then horizontal = horizontal.Unit end
            local velocity = horizontal * (50 * state.SpeedLevel)
            state.BodyVelocity.Velocity = Vector3.new(velocity.X, state.Vertical * (50 * state.SpeedLevel), velocity.Z)
            state.BodyGyro.CFrame = camera.CFrame
        end)
        toggle.Text = "关闭"
    end

    toggle.Activated:Connect(function()
        if state.Enabled then stopFlight() else startFlight() end
    end)
    up.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then state.Vertical = 1 end
    end)
    up.InputEnded:Connect(function() state.Vertical = 0 end)
    down.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then state.Vertical = -1 end
    end)
    down.InputEnded:Connect(function() state.Vertical = 0 end)
    plus.Activated:Connect(function()
        state.SpeedLevel = state.SpeedLevel + 1
        speedLabel.Text = tostring(state.SpeedLevel)
    end)
    minus.Activated:Connect(function()
        state.SpeedLevel = math.max(1, state.SpeedLevel - 1)
        speedLabel.Text = tostring(state.SpeedLevel)
    end)
    hideButton.Activated:Connect(function()
        for _, child in ipairs(frame:GetChildren()) do
            if child ~= hideButton and child ~= showButton then child.Visible = false end
        end
        hideButton.Visible = false
        showButton.Visible = true
        frame.BackgroundTransparency = 1
    end)
    showButton.Activated:Connect(function()
        for _, child in ipairs(frame:GetChildren()) do child.Visible = true end
        showButton.Visible = false
        hideButton.Visible = true
        frame.BackgroundTransparency = 0
    end)
    closeButton.Activated:Connect(function()
        stopFlight()
        state.Closed = true
        main:Destroy()
    end)
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.7)
        if state.Enabled then startFlight() end
    end)
    main.Destroying:Connect(stopFlight)
    return main
end

