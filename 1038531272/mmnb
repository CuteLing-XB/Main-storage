-- 通用网络请求函数
local function SafeHttpRequest(requestData)
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not httpRequest then return false, "当前执行器不支持 HTTP 请求" end

    local success, result = pcall(function() return httpRequest(requestData) end)
    if success and result and result.Body then
        return true, result.Body
    end
    return false, "网络连接超时"
end

-- 验证卡密（登录时仅校验一次）
local function VerifyKeyWithServer(enteredKey)
    if not enteredKey or enteredKey == "" then 
        return false, "请输入有效卡密！" 
    end

    local cleanKey = enteredKey:match("^%s*(.-)%s*$")

    if isLocalAdminKey(cleanKey) then
        return true, "管理员身份验证通过！"
    end

    local payload = {
        key = cleanKey,
        hwid = getHWID(),
        username = LocalPlayer.Name,
        secret = AUTH_SECRET
    }
    
    local requestData = {
        Url = API_URL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    }
    
    local success, responseBody = SafeHttpRequest(requestData)
    if success then
        local jsonSuccess, decoded = pcall(function() return HttpService:JSONDecode(responseBody) end)
        if jsonSuccess and decoded then
            return decoded.success, decoded.message
        end
    end
    return false, "无法连接卡密服务器，请稍后再试"
end

-- 获取在线脚本玩家
local function GetScriptOnlineUsers()
    local requestData = { Url = ONLINE_URL, Method = "GET" }
    local success, responseBody = SafeHttpRequest(requestData)

    if success then
        local jsonOk, decoded = pcall(function() return HttpService:JSONDecode(responseBody) end)
        if jsonOk and decoded and decoded.users and #decoded.users > 0 then
            return decoded.users
        end
    end

    return { "当前无在线脚本玩家" }
end

