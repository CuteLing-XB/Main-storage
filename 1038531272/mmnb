        local function downloadOneUIBackground(index)
            local source = UI_BACKGROUND_SOURCES[index]
            if not source then
                return false, "背景源不存在"
            end
            local assetLoader = getcustomasset or getsynasset
            if type(assetLoader) ~= "function"
                or type(writefile) ~= "function"
                or not ensureImageCacheFolder() then
                return false, "执行器缺少图片缓存能力"
            end
            local fileName = getUIBackgroundFileName(source)
            local function writeAndRead()
                if not isExistingFile(fileName) then
                    local body = requestHttpBody(source.Url, source.ContentType or "image/jpeg")
                    local writeOk, writeError = pcall(function()
                        writefile(fileName, body)
                    end)
                    if not writeOk then
                        error(tostring(writeError))
                    end
                end
                local assetOk, assetId = pcall(assetLoader, fileName)
                if not assetOk or type(assetId) ~= "string" or assetId == "" then
                    error(assetOk and "缓存图片资源为空" or tostring(assetId))
                end
                return assetId
            end
            local ok, assetId = pcall(writeAndRead)
            if not ok then
                if isExistingFile(fileName) and type(writefile) == "function" then
                    local retryOk, retryAsset = pcall(function()
                        local body = requestHttpBody(source.Url, source.ContentType or "image/jpeg")
                        writefile(fileName, body)
                        local loaded, loadedAsset = pcall(assetLoader, fileName)
                        if not loaded or type(loadedAsset) ~= "string" or loadedAsset == "" then
                            error(loaded and "重试后的缓存资源为空" or tostring(loadedAsset))
                        end
                        return loadedAsset
                    end)
                    if retryOk then
                        assetId = retryAsset
                        ok = true
                    else
                        return false, tostring(retryAsset)
                    end
                else
                    return false, tostring(assetId)
                end
            end
            UIBackgroundCache[index] = {
                Asset = assetId,
                File = fileName,
                Name = source.Name,
            }
            return true
        end

        local function applyUIBackground(index)
