local function drawingSupported()
    return type(Drawing) == "table" and type(Drawing.new) == "function"
end

local function drawingNotify(title, content)
    WindUI:Notify({Title = title, Content = content, Duration = 3})
end

local function removeDrawing(object)
    if not object then return end
    pcall(function()
        if type(object.Remove) == "function" then
            object:Remove()
        else
            object:Destroy()
        end
    end)
end

local function newDrawing(className)
    if not drawingSupported() then return nil end
    local ok, object = pcall(function()
        return Drawing.new(className)
    end)
    return ok and object or nil
end

local function getDrawingCamera()
    return workspace.CurrentCamera
end

