        if PhantomESP[player] then HideObjects(PhantomESP[player]) end
        BindCharacter(player, character)
    end)
end

local function RemovePlayer(player)
    if PhantomConnections[player] then
        pcall(function() PhantomConnections[player]:Disconnect() end)
        PhantomConnections[player] = nil
    end
    if PhantomCharacterCache[player] and PhantomCharacterCache[player].HealthConnection then
        pcall(function() PhantomCharacterCache[player].HealthConnection:Disconnect() end)
    end
    if PhantomESP[player] then
        DestroyObjects(PhantomESP[player])
        PhantomESP[player] = nil
    end
    PhantomCharacterCache[player] = nil
    PhantomSmoothHealth[player] = nil
    PhantomDamageCache[player] = nil
end

