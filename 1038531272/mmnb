                -- v5：每帧只计算一次视口中心，供 FOV圈/准心/AimScreenDistance 复用
                AimViewportCenterX = camera.ViewportSize.X * 0.5
                AimViewportCenterY = camera.ViewportSize.Y * 0.5

                -- v5：每帧只获取一次本地玩家部件，供动态准心等复用
                local myParts = AimGetCharParts(AimLocalPlayer)

                -- --- FOV 圆圈（ZIndex=500）---
                if AimFOVDrawing then
                    AimFOVDrawing.Visible = AimConfig.ShowFOVCircle
                    if AimConfig.ShowFOVCircle then
                        AimFOVDrawing.Position = Vector2.new(AimViewportCenterX, AimViewportCenterY)
                        AimFOVDrawing.Radius = AimConfig.FOV
                    end
                end

                -- --- 动态准心（ZIndex=501）---
                if AimCrossLines then
                    local showCross = AimConfig.DynamicCrosshair
                    local center = Vector2.new(AimViewportCenterX, AimViewportCenterY)
                    local moveSpeed = 0
                    if myParts and myParts.Root then
                        moveSpeed = myParts.Root.AssemblyLinearVelocity.Magnitude
                    end
                    local gap = 6 + (moveSpeed * 0.5)
                    local length = 10
                    AimCrossLines.Top.From = center + Vector2.new(0, -gap - length)
                    AimCrossLines.Top.To = center + Vector2.new(0, -gap)
                    AimCrossLines.Bottom.From = center + Vector2.new(0, gap)
                    AimCrossLines.Bottom.To = center + Vector2.new(0, gap + length)
                    AimCrossLines.Left.From = center - Vector2.new(gap + length, 0)
                    AimCrossLines.Left.To = center - Vector2.new(gap, 0)
                    AimCrossLines.Right.From = center + Vector2.new(gap, 0)
                    AimCrossLines.Right.To = center + Vector2.new(gap + length, 0)
                    for _, line in pairs(AimCrossLines) do
                        line.Visible = showCross
                    end
                end

                -- --- ESP 更新（降频）---
                AimUpdateESP()

                -- --- 强锁悬浮窗状态更新（降频到每3帧）---
                AimLockUpdateCounter = AimLockUpdateCounter + 1
                if AimLockUpdateCounter >= 3 and AimLockWindowGui and AimLockWindowGui.Parent then
                    AimLockUpdateCounter = 0
                    if AimStrongLockEnabled and AimStrongLockedTarget then
                        if AimStrongValidTarget(AimStrongLockedTarget) then
                            if AimLockStatusLabel then
                                AimLockStatusLabel.Text = "状态：强锁中"
                                AimLockStatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                            end
                            if AimLockTargetLabel then
                                AimLockTargetLabel.Text = "目标：" .. (AimStrongLockedTarget.DisplayName or AimStrongLockedTarget.Name)
                            end
                        else
                            AimStrongLockedTarget = nil
                            AimStrongLockedPart = nil
                            AimStrongLockEnabled = false
                            if AimLockStatusLabel then
                                AimLockStatusLabel.Text = "状态：目标丢失"
                                AimLockStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                            end
                            if AimLockTargetLabel then AimLockTargetLabel.Text = "目标：无" end
                        end
                    else
                        if AimLockStatusLabel then
                            AimLockStatusLabel.Text = "状态：未锁定"
                            AimLockStatusLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
                        end
                        if AimLockTargetLabel then
                            if AimCurrentTarget then
                                AimLockTargetLabel.Text = "当前：" .. (AimCurrentTarget.DisplayName or AimCurrentTarget.Name)
                            else
                                AimLockTargetLabel.Text = "目标：无"
                            end
                        end
                    end
                end

                -- --- 自瞄逻辑 ---
                if not AimConfig.Enabled then
                    AimCurrentTarget = nil
                    AimCurrentPart = nil
                    return
                end

                -- 强锁分支
                if AimStrongLockEnabled and AimStrongLockedTarget then
                    if not AimStrongValidTarget(AimStrongLockedTarget) then
                        AimStrongLockedTarget = nil
                        AimStrongLockedPart = nil
                        AimStrongLockEnabled = false
                        return
                    end
                    local char = AimStrongLockedTarget.Character
                    if not char then AimStrongLockedTarget = nil return end
                    local part = AimGetAimPart(char) or char:FindFirstChild("HumanoidRootPart")
                    if not part then AimStrongLockedTarget = nil return end
                    AimStrongLockedPart = part
                    AimCurrentTarget = AimStrongLockedTarget
                    AimCurrentPart = AimStrongLockedPart
                else
                    -- 普通瞄准分支（目标搜索降频到30fps）
                    AimScanTimer = AimScanTimer + deltaTime
                    if AimScanTimer >= 0.033 then
                        AimScanTimer = 0
                        if AimConfig.TargetLock then
                            if not AimTargetStillValid() then
                                AimCurrentTarget, AimCurrentPart = AimFindTarget()
                            end
                        else
                            AimCurrentTarget, AimCurrentPart = AimFindTarget()
                        end
                    end
                    if not AimCurrentTarget or not AimCurrentPart then return end
                    if not AimTargetStillValid() then
                        AimCurrentTarget = nil
                        AimCurrentPart = nil
                        return
                    end
                end

                if not AimCurrentTarget then return end

                -- 预判
                local aimPosition = AimCurrentPart.Position
                if AimConfig.Prediction then
                    local velocity = AimCurrentPart.AssemblyLinearVelocity
                    if velocity and velocity.Magnitude > 0.5 then
                        aimPosition = aimPosition + velocity * AimConfig.PredictionTime
                    end
                end

                -- 相机插值瞄准
                local desired = CFrame.lookAt(camera.CFrame.Position, aimPosition)
                local speed = (AimConfig.Mode == "Rage") and AimConfig.RageSpeed or (1 + (AimConfig.Smoothness / 100) * AimConfig.LegitSpeed)
                local alpha = 1 - math.exp(-speed * deltaTime)
                camera.CFrame = camera.CFrame:Lerp(desired, alpha)
            end)
        end)

