    LoliconWindowCleanups[windowId] = cleanup

    local function load()
        if destroyed then
            return
        end
        loadSerial = loadSerial + 1
        local requestSerial = loadSerial
        deleteTemporaryImage(assetFile)
        assetFile = ""
        refresh.Text = "请求中"
        status.Text = "正在请求 Lolicon..."
        task.spawn(function()
            local ok, imageUrl, item = pcall(requestFunction)
            if destroyed or requestSerial ~= loadSerial then
                return
            end
            if not ok or type(imageUrl) ~= "string" or imageUrl == "" then
                refresh.Text = "下一张"
                status.Text = "请求失败：" .. tostring(imageUrl)
                status.TextColor3 = Color3.fromRGB(255, 120, 120)
                return
            end
            local downloadCallOk, displayImage, newAssetFile, downloadOk = pcall(function()
                return assetFunction(imageUrl)
            end)
            if destroyed or requestSerial ~= loadSerial then
                deleteTemporaryImage(newAssetFile)
                return
            end
            if not downloadCallOk then
                refresh.Text = "下一张"
                status.Text = "图片下载失败：" .. tostring(displayImage)
                status.TextColor3 = Color3.fromRGB(255, 120, 120)
                return
            end
            assetFile = newAssetFile or ""
            if downloadOk == false or type(displayImage) ~= "string" or displayImage == "" then
                refresh.Text = "下一张"
                status.Text = "图片下载失败"
                status.TextColor3 = Color3.fromRGB(255, 120, 120)
                return
            end
            image.Image = displayImage
            image.Visible = true
            refresh.Text = "下一张"
            status.Text = "已显示：" .. tostring(item and (item.author or item.title) or windowTitle)
            status.TextColor3 = Color3.fromRGB(180, 255, 180)
        end)
    end

    connect(close.Activated, cleanup)
    connect(refresh.Activated, load)
    load()
end

