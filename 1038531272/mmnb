local function trim(value)
    if type(value) ~= "string" then
        return ""
    end
    return value:match("^%s*(.-)%s*$")
end

local function getHWID()
    local hwid = "UNKNOWN_HWID"
    pcall(function()
        hwid = RbxAnalyticsService:GetClientId()
    end)
    return hwid
end

local function clearSavedKey()
    if not (isfile and delfile) then
        return
    end

    -- 兼容清理 WindUI 默认保存文件及自定义 HWID 文件
    local filesToClear = {
        KEY_FOLDER .. "/" .. getHWID() .. ".key",
        KEY_FOLDER .. "/key.txt",
        KEY_FOLDER .. "/savedkey.txt",
    }

    for _, filePath in ipairs(filesToClear) do
        pcall(function()
            if isfile(filePath) then
                delfile(filePath)
            end
        end)
    end
end

local function safeHttpRequest(requestData, retries)
    retries = retries or 2
    local httpRequest = (syn and syn.request)
        or (http and http.request)
        or http_request
        or (fluxus and fluxus.request)
        or request

    if not httpRequest then
        return false, "当前执行器不支持 HTTP 请求"
    end

    -- 增加重试机制应对 Render 免费服务器冷启动
    for i = 1, retries do
        local success, result = pcall(function()
            return httpRequest(requestData)
        end)

        if success and result and result.Body and result.Body ~= "" then
            return true, result.Body
        end

        if i < retries then
            task.wait(1.5)
        end
    end

    return false, "无法连接卡密服务器，请稍后再试"
end

-- 修复参数解析：兼容 Service:Verify(key) 和 Verify(key) 两种调用方式
local function verifyCloudKey(arg1, arg2)
    local enteredKey = ""
    if type(arg1) == "string" then
        enteredKey = arg1
    elseif type(arg2) == "string" then
        enteredKey = arg2
    end

    local cleanKey = trim(enteredKey)
    if cleanKey == "" then
        return false, "请输入有效卡密"
    end

    local payload = {
        key = cleanKey,
        hwid = getHWID(),
        username = LocalPlayer and LocalPlayer.Name or "Unknown",
        secret = AUTH_SECRET,
    }

    local success, responseBody = safeHttpRequest({
        Url = API_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Accept"] = "application/json",
        },
        Body = HttpService:JSONEncode(payload),
    })

    if not success then
        return false, responseBody
    end

    local jsonSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(responseBody)
    end)

    if not jsonSuccess or type(decoded) ~= "table" then
        return false, "卡密服务器返回了无效数据"
    end

    local valid = decoded.success == true
    local message = tostring(decoded.message or (valid and "云端验证通过" or "卡密无效"))

    if not valid then
        clearSavedKey()
    end

    return valid, message
end

