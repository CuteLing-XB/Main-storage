-- 设置 页面
---------------------------------------------------------
SettingsTab:CreateSection("主题与外观")

SettingsTab:CreateDropdown({
   Name = "选择UI主题配色",
   Options = {
      "Bloom",
      "Default", 
      "AmberGlow", 
      "Amethyst", 
      "DarkBlue", 
      "Green", 
      "Light", 
      "Ocean", 
      "Serenity"
   },
   CurrentOption = {"Bloom"},
   MultipleOptions = false,
   Flag = "ThemeDropdown",
   Callback = function(Option)
      local selectedTheme = type(Option) == "table" and Option[1] or Option
      -- 使用 Rayfield 官方的全局 API 进行无缝无损切主题
      if Rayfield and Rayfield.ChangeTheme then
         Rayfield:ChangeTheme(selectedTheme)
      end
   end,
})

SettingsTab:CreateSection("系统设置")

SettingsTab:CreateKeybind({
   Name = "UI显示快捷键",
   CurrentKeybind = "RightControl",
   HoldToInteract = false,
   Flag = "UIKeybind",
   Callback = function(Keybind)
      local keyEnum = typeof(Keybind) == "EnumItem" and Keybind or Enum.KeyCode[Keybind]
      if keyEnum then
         Rayfield.ToggleKey = keyEnum
      end
   end,
})

SettingsTab:CreateButton({
   Name = "销毁脚本界面",
   Callback = function()
      Rayfield:Destroy()
   end,
})
