local function requestLoliconImage()
    local url = "https://api.lolicon.app/setu/v2"
        .. "?r18=1&num=1&size=small&proxy=i.pixiv.re&excludeAI=true"
    local body = requestHttpBody(url, "application/json")
    local decoded = HttpService:JSONDecode(body)
    if type(decoded) ~= "table" then
        error("Lolicon 返回不是有效 JSON")
    end
    if decoded.error and decoded.error ~= "" then
        error("Lolicon：" .. tostring(decoded.error))
    end
    local item = decoded.data and decoded.data[1]
    local urls = item and item.urls
    local imageUrl = urls and (urls.small or urls.thumb or urls.regular or urls.original or urls.mini)
    if type(imageUrl) ~= "string" or imageUrl == "" then
        error("Lolicon 没有返回可用图片地址")
    end
    return imageUrl, item
end

